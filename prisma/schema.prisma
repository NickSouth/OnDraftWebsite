generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                    @id
  email                   String                    @unique
  emailVerifiedAt         DateTime?                 @map("email_verified_at")
  displayName             String                    @map("display_name")
  password                String
  role                    String
  createdAt               DateTime                  @map("created_at")
  preferences             String
  emailVerificationTokens EmailVerificationToken[]
  mailingListSubscription MailingListSubscription?

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("email_verification_tokens")
}

model MailingListSubscription {
  id                 String                        @id
  email              String                        @unique
  userId             String?                       @unique @map("user_id")
  status             String
  consentSource      String                        @map("consent_source")
  consentTextVersion String                        @map("consent_text_version")
  consentedAt        DateTime?                     @map("consented_at")
  unsubscribedAt     DateTime?                     @map("unsubscribed_at")
  createdAt          DateTime                      @map("created_at")
  updatedAt          DateTime                      @map("updated_at")
  user               User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([updatedAt])
  @@map("mailing_list_subscriptions")
}

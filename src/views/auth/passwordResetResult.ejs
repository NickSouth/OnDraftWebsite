<section class="mx-auto grid w-full max-w-xl gap-6">
  <div class="text-left">
    <%- include("partials/authBrand") %>
    <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">
      <%= status === "success" ? "Password Reset" : "Reset Link Problem" %>
    </h1>
    <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300"><%= message %></p>
  </div>

  <section class="od-card grid gap-4 p-5 sm:p-6">
    <% if (status === "success") { %>
      <a class="od-primary-link w-full sm:w-fit" href="/login">Log in</a>
    <% } else { %>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a class="od-primary-link" href="/forgot-password">Request a new link</a>
        <a class="od-secondary-link" href="/login">Back to login</a>
      </div>
    <% } %>
  </section>
</section>

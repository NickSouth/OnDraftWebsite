<section class="mx-auto grid w-full max-w-md gap-6">
  <div class="text-left">
    <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">OnDraft</p>
    <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">Reset Password</h1>
    <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">Enter your account email and we will send a secure reset link.</p>
  </div>

  <% if (pageError) { %>
    <%- include("partials/error", { message: pageError }) %>
  <% } %>

  <% if (pageMessage) { %>
    <section class="rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-sm font-bold leading-6 text-emerald-700 dark:border-white/10 dark:bg-emerald-500/10 dark:text-emerald-200">
      <%= pageMessage %>
    </section>
  <% } %>

  <section class="od-card grid gap-5 p-5 sm:p-6">
    <div>
      <h2 class="font-display text-2xl font-black text-slate-950 dark:text-white">Request Reset Link</h2>
    </div>

    <form class="grid gap-4" method="post" action="/forgot-password">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100" for="email">
        Email
        <input class="od-form-input" id="email" name="email" type="email" autocomplete="username" required />
      </label>

      <button class="od-primary-link w-full" type="submit">Send reset link</button>
    </form>

    <p class="text-sm font-semibold text-slate-600 dark:text-slate-300">
      Remembered it?
      <a class="od-focus-ring rounded text-draft-amber hover:text-draft-gold dark:text-draft-gold" href="/login">Back to login</a>.
    </p>
  </section>
</section>

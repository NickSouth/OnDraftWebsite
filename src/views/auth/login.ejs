<section class="mx-auto grid w-full max-w-md gap-6">
  <div class="text-left">
    <%- include("partials/authBrand") %>
    <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">Log In</h1>
    <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">Sign in to follow the board, save articles, and join the taproom.</p>
  </div>

  <% if (pageError) { %>
    <%- include("partials/error", { message: pageError }) %>
  <% } %>

  <section class="od-card grid gap-5 p-5 sm:p-6">
    <div>
      <h2 class="font-display text-2xl font-black text-slate-950 dark:text-white">Account Login</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Welcome back to OnDraft.</p>
    </div>

    <form class="grid gap-4" method="post" action="/login">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100" for="email">
        Email
        <input class="od-form-input" id="email" name="email" type="email" autocomplete="username" required />
      </label>

      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100" for="password">
        Password
        <input
          class="od-form-input"
          id="password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </label>

      <label class="flex items-center gap-3 text-sm font-bold text-slate-700 dark:text-slate-200" for="rememberMe">
        <input
          class="h-4 w-4 rounded border-slate-300 text-draft-amber focus:ring-draft-gold"
          id="rememberMe"
          name="rememberMe"
          type="checkbox"
        />
        Remember me
      </label>

      <%- include("partials/turnstileWidget") %>

      <button class="od-primary-link w-full" type="submit">Log in</button>
    </form>

    <div class="grid gap-2 text-sm font-semibold text-slate-600 dark:text-slate-300">
      <p>
        <a class="od-focus-ring rounded text-draft-amber hover:text-draft-gold dark:text-draft-gold" href="/forgot-password">Forgot password?</a>
      </p>
      <p>
        New here?
        <a class="od-focus-ring rounded text-draft-amber hover:text-draft-gold dark:text-draft-gold" href="/register">Create an account</a>.
      </p>
    </div>
  </section>
</section>

<section class="od-admin-page od-admin-users-page max-w-none">
  <div class="od-admin-heading">
    <div>
      <p>Admin</p>
      <h1>Manage Users</h1>
      <p class="mt-3 max-w-2xl normal-case tracking-normal text-slate-600 dark:text-slate-300">Registered accounts and marketing email consent status.</p>
    </div>

    <a class="od-primary-link w-full sm:w-fit" href="/admin/mailing-list/subscribers.csv">Download mailing list CSV</a>
  </div>

  <div class="od-card overflow-visible">
    <table class="min-w-full text-left text-sm">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-100 text-xs font-black uppercase tracking-wide text-slate-600 dark:border-white/10 dark:bg-draft-ink dark:text-slate-300">
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Email</th>
          <th class="px-4 py-3">Verified</th>
          <th class="px-4 py-3">Mailing List</th>
          <th class="px-4 py-3">Moderation</th>
          <th class="px-4 py-3">Registered</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 dark:divide-white/10">
        <% users.forEach((user) => { %>
          <tr class="align-top transition hover:bg-slate-50 dark:hover:bg-white/[0.04]">
            <td class="px-4 py-4 font-black text-slate-950 dark:text-white"><%= user.displayName %></td>
            <td class="px-4 py-4 font-semibold text-slate-700 dark:text-slate-200"><%= user.email %></td>
            <td class="px-4 py-4">
              <span class="inline-flex rounded px-2.5 py-1 text-xs font-black uppercase tracking-wide <%= user.emailVerifiedAt ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-200" : "bg-draft-foam text-draft-amber dark:bg-white/10 dark:text-draft-gold" %>">
                <%= user.emailVerifiedAt ? "Verified" : "Unverified" %>
              </span>
            </td>
            <td class="px-4 py-4 text-slate-700 dark:text-slate-200"><%= user.mailingListStatus %></td>
            <td class="px-4 py-4">
              <% if (user.activeBan) { %>
                <p class="mb-2 text-sm font-bold text-red-700 dark:text-red-200">
                  Banned<% if (user.activeBan.expiresAt) { %> until <%= new Date(user.activeBan.expiresAt).toLocaleString() %><% } else { %> permanently<% } %>
                </p>
              <% } %>
              <%- include("partials/userModerationActions", { user, contextId: `admin-user-${user.id}`, errorMessage: null }) %>
            </td>
            <td class="px-4 py-4 text-slate-600 dark:text-slate-300"><%= new Date(user.registeredAt).toLocaleString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

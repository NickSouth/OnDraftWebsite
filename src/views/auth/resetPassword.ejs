<section class="mx-auto grid w-full max-w-md gap-6">
  <div class="text-left">
    <%- include("partials/authBrand") %>
    <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">Choose New Password</h1>
    <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">Set a fresh password for your account.</p>
  </div>

  <% if (pageError) { %>
    <%- include("partials/error", { message: pageError }) %>
  <% } %>

  <section class="od-card grid gap-5 p-5 sm:p-6">
    <div>
      <h2 class="font-display text-2xl font-black text-slate-950 dark:text-white">New Password</h2>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Use at least 8 characters. The reset link can only be used once.</p>
    </div>

    <form class="grid gap-4" method="post" action="/reset-password">
      <input type="hidden" name="token" value="<%= token %>" />

      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100" for="password">
        New password
        <input
          class="od-form-input"
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </label>

      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100" for="confirmPassword">
        Confirm new password
        <input
          class="od-form-input"
          id="confirmPassword"
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          required
        />
      </label>

      <%- include("partials/turnstileWidget") %>

      <button class="od-primary-link w-full" type="submit">Reset password</button>
    </form>
  </section>
</section>

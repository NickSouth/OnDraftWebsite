<div id="site-loader" class="pointer-events-none fixed inset-0 z-[60] hidden bg-white/80 backdrop-blur-sm dark:bg-draft-ink/80" role="status" aria-live="polite" aria-label="Loading page">
  <div class="grid min-h-full content-center gap-6 px-4 py-10">
    <div class="mx-auto grid w-full max-w-4xl gap-4 rounded-lg border border-slate-200 bg-white/90 p-5 shadow-editorial dark:border-white/10 dark:bg-draft-slate/90">
      <div class="flex items-center justify-between gap-4">
        <div class="grid flex-1 gap-2">
          <div class="od-loading-bar h-4 w-40"></div>
          <div class="od-loading-bar h-8 w-full max-w-lg"></div>
        </div>
        <div class="od-loading-bar size-12 rounded-full"></div>
      </div>
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="od-loading-card"></div>
        <div class="od-loading-card"></div>
        <div class="od-loading-card"></div>
      </div>
    </div>
    <div class="grid justify-items-center gap-4">
    <div class="beer-loader" aria-hidden="true">
      <div class="beer-loader-mug">
        <div class="beer-loader-fill"></div>
        <div class="beer-loader-foam"></div>
      </div>
      <div class="beer-loader-handle"></div>
    </div>
    <p class="m-0 text-sm font-bold uppercase tracking-[0.18em] text-slate-700 dark:text-slate-200">Pouring the page</p>
    </div>
  </div>
</div>

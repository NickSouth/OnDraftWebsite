<header class="fixed inset-x-0 top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur dark:border-white/10 dark:bg-draft-ink/95">
  <div class="flex min-h-14 items-center justify-between gap-2 px-3 sm:px-4 md:px-6 <%= forceOverlaySidebar ? "" : "lg:mr-80" %>">
    <a href="/" class="od-focus-ring inline-flex min-w-0 items-center gap-2 rounded-md text-sm font-black tracking-normal text-slate-950 dark:text-white">
      <img class="h-12 w-16 shrink-0 object-contain drop-shadow-sm" src="/images/brand/OnDraftLogo-cropped.png" alt="" aria-hidden="true" />
      <span class="hidden sm:inline">OnDraft Football</span>
    </a>

    <div class="flex min-w-0 shrink-0 items-center justify-end gap-1.5 sm:gap-2">
      <% if (currentSession?.authenticatedUser) { %>
        <span class="hidden max-w-52 truncate text-sm text-slate-600 dark:text-slate-300 sm:inline">
          Signed in as <strong class="font-bold text-slate-950 dark:text-white"><%= currentSession.authenticatedUser.displayName %></strong>
        </span>
        <form method="post" action="/logout" class="m-0">
          <button type="submit" class="od-icon-button" aria-label="Sign out" title="Sign out">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 17l5-5-5-5" />
              <path d="M15 12H3" />
              <path d="M21 19V5a2 2 0 0 0-2-2h-6" />
              <path d="M13 21h8" />
            </svg>
          </button>
        </form>
      <% } else { %>
        <a href="/login" class="od-shell-link whitespace-nowrap px-2 py-1.5 sm:px-3 sm:py-2">Log in</a>
        <a href="/register" class="od-primary-link min-h-9 whitespace-nowrap px-2.5 py-1.5 sm:px-3">Sign up</a>
      <% } %>

      <button
        type="button"
        class="od-focus-ring inline-flex size-10 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-900 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-draft-gold hover:bg-slate-50 active:scale-95 dark:border-white/10 dark:bg-white/10 dark:text-white dark:hover:bg-white/15 <%= forceOverlaySidebar ? "" : "lg:hidden" %>"
        aria-label="Open navigation"
        aria-controls="site-sidebar"
        :aria-expanded="sidebarOpen.toString()"
        @click="sidebarOpen = true"
      >
        <span class="grid gap-1" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current"></span>
        </span>
      </button>
    </div>
  </div>
</header>

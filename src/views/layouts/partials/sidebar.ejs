<% const navItems = [
  { href: "/", label: "Home Pour", kicker: "Latest front page" },
  { href: "/articles", label: "Articles On Tap", kicker: "Columns and film room" },
  { href: "/videos", label: "Bar TV", kicker: "Video breakdowns" },
  { href: "/bigboard", label: "Draft Board", kicker: "Ranks and scouting" },
  { href: "/hottakes", label: "The Taproom", kicker: "Community takes" },
  { href: "/bookmarks", label: "Saved Pints", kicker: "Your bookmarks" },
]; %>

<div
  x-cloak
  class="fixed inset-0 z-50 bg-slate-950/50 lg:hidden"
  x-show="sidebarOpen"
  x-transition.opacity
  @click="sidebarOpen = false"
></div>

<aside
  id="site-sidebar"
  class="fixed right-0 top-14 z-50 flex h-[calc(100vh-3.5rem)] w-80 max-w-[calc(100vw-1rem)] flex-col border-l border-slate-200 bg-white shadow-editorial transition-transform duration-200 dark:border-white/10 dark:bg-draft-slate lg:translate-x-0"
  :class="sidebarOpen ? 'translate-x-0' : 'translate-x-full lg:translate-x-0'"
  x-trap.noscroll="sidebarOpen && window.innerWidth < 1024"
  @keydown.escape.window="sidebarOpen = false"
>
  <div class="flex items-center justify-between border-b border-slate-200 px-5 py-4 dark:border-white/10">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.18em] text-draft-amber dark:text-draft-gold">Navigate</p>
      <h2 class="font-display text-xl font-bold text-slate-950 dark:text-white">OnDraft Menu</h2>
    </div>
    <button
      type="button"
      class="od-focus-ring inline-flex size-9 items-center justify-center rounded-md text-2xl leading-none text-slate-600 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10 lg:hidden"
      aria-label="Close navigation"
      @click="sidebarOpen = false"
    >
      &times;
    </button>
  </div>

  <nav class="grid gap-2 overflow-y-auto p-4" aria-label="Primary">
    <% navItems.forEach((item) => { %>
      <a href="<%= item.href %>" class="od-bartop-nav group grid grid-cols-[3.25rem_minmax(0,1fr)] gap-3">
        <span class="grid size-12 place-items-center overflow-visible" aria-hidden="true">
          <img src="/images/ui/beer-spout.png" alt="" class="h-11 w-12 object-contain transition group-hover:scale-105" />
        </span>
        <span class="grid min-w-0 gap-0.5">
          <span class="block text-sm font-black text-white drop-shadow-sm"><%= item.label %></span>
          <span class="block text-xs font-semibold text-amber-50/85"><%= item.kicker %></span>
        </span>
      </a>
    <% }) %>

    <% if (currentIsAdmin) { %>
      <div class="mt-4 border-t border-slate-200 pt-4 dark:border-white/10">
        <p class="mb-2 px-3 text-xs font-black uppercase tracking-[0.16em] text-slate-500 dark:text-slate-400">Admin</p>
        <a href="/admin/users" class="od-shell-link flex">Manage users</a>
        <a href="/articles/new" class="od-shell-link flex">Create article</a>
        <a href="/bigboard/edit" class="od-shell-link flex">Edit draft board</a>
      </div>
    <% } %>
  </nav>
</aside>

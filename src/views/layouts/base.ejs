<!doctype html>
<html data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OnDraft</title>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/tailwind.css" />
    <script src="/vendor/htmx/htmx.min.js" defer></script>
    <script src="/vendor/alpinejs-focus/cdn.min.js" defer></script>
    <script src="/vendor/alpinejs-collapse/cdn.min.js" defer></script>
    <script src="/vendor/alpinejs/cdn.min.js" defer></script>
    <script src="/ondraftShell.js" defer></script>
    <script src="/articleShare.js" defer></script>
  </head>
  <body class="min-h-screen bg-slate-50 p-0 text-slate-950 antialiased dark:bg-draft-ink dark:text-slate-100">
    <% const currentSession = typeof session !== "undefined" ? session : null; %>
    <% const currentIsAdmin = typeof isAdmin !== "undefined" ? isAdmin : false; %>
    <div
      class="min-h-screen"
      x-data="{ sidebarOpen: false }"
      x-init="$watch('sidebarOpen', value => { if (!value) $nextTick(() => document.body.focus?.()) })"
    >
      <%- include("partials/topBar", { currentSession, currentIsAdmin }) %>
      <%- include("partials/sidebar", { currentSession, currentIsAdmin }) %>
      <%- include("partials/beerLoader") %>
      <% if (currentSession?.authenticatedUser && !currentSession.authenticatedUser.emailVerifiedAt) { %>
        <section class="verification-banner mx-4 mt-20 lg:mr-[22rem]">
          <p>Verify your email before commenting or bookmarking.</p>
          <form method="post" action="/verify-email/resend">
            <button type="submit" class="secondary-button">Resend verification email</button>
          </form>
        </section>
      <% } %>
      <main id="page-content" class="mx-0 min-h-[calc(100vh-9rem)] max-w-none px-4 pb-10 pt-20 lg:mr-80 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <%- body %>
        </div>
      </main>
      <div class="lg:mr-80">
        <%- include("partials/footer") %>
      </div>
    </div>
  </body>
</html>

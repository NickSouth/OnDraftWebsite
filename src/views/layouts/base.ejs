<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OnDraft</title>
    <link rel="stylesheet" href="/styles.css" />
    <script src="/vendor/htmx/htmx.min.js" defer></script>
    <script src="/articleShare.js" defer></script>
  </head>
  <body>
    <% const currentSession = typeof session !== "undefined" ? session : null; %>
    <div class="page-shell">
      <nav class="main-nav">
        <a href="/" class="nav-brand">
          OnDraft
        </a>
        <div class="nav-actions">
          <% if (currentSession?.authenticatedUser) { %>
            <span class="nav-status">
              Signed in as <strong><%= currentSession.authenticatedUser.displayName %></strong>
            </span>
            <form method="post" action="/logout" class="nav-form">
              <button type="submit" class="secondary-button">Log out</button>
            </form>
          <% } else { %>
            <a href="/login" class="nav-link">Log in</a>
            <a href="/register" class="nav-link">Register</a>
          <% } %>
        </div>
      </nav>
      <% if (currentSession?.authenticatedUser && !currentSession.authenticatedUser.emailVerifiedAt) { %>
        <section class="verification-banner">
          <p>Verify your email before using admin tools.</p>
          <form method="post" action="/verify-email/resend">
            <button type="submit" class="secondary-button">Resend verification email</button>
          </form>
        </section>
      <% } %>
      <main><%- body %></main>
    </div>
  </body>
</html>

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CheeksCast</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <% const currentSession = typeof session !== "undefined" ? session : null; %>
    <div class="page-shell">
      <nav class="main-nav">
        <a href="/" class="nav-brand">
          CheeksCast
        </a>
        <div class="nav-actions">
          <% if (currentSession?.authenticatedUser) { %>
            <span class="nav-status">
              Signed in as <strong><%= currentSession.authenticatedUser.displayName %></strong>
            </span>
            <form method="post" action="/logout" class="nav-form">
              <button type="submit" class="secondary-button">Log out</button>
            </form>
          <% } else { %>
            <a href="/login" class="nav-link">Log in</a>
            <a href="/register" class="nav-link">Register</a>
          <% } %>
        </div>
      </nav>
      <main><%- body %></main>
    </div>
  </body>
</html>

<!doctype html>
<html data-theme="dark" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%
      const resolvedMetaTitle = typeof metaTitle !== "undefined" && metaTitle ? metaTitle : "OnDraft Football";
      const resolvedMetaDescription = typeof metaDescription !== "undefined" && metaDescription
        ? metaDescription
        : "NFL and NFL Draft analysis, opinions, videos, community hot takes, and draft boards from OnDraft Football.";
      const resolvedMetaImage = typeof metaImage !== "undefined" && metaImage ? metaImage : defaultPreviewImageUrl;
      const resolvedMetaUrl = typeof metaUrl !== "undefined" && metaUrl ? metaUrl : currentAbsoluteUrl;
      const resolvedMetaType = typeof metaType !== "undefined" && metaType ? metaType : "website";
    %>
    <title><%= resolvedMetaTitle %></title>
    <meta name="description" content="<%= resolvedMetaDescription %>" />
    <link rel="canonical" href="<%= resolvedMetaUrl %>" />
    <meta property="og:site_name" content="OnDraft Football" />
    <meta property="og:type" content="<%= resolvedMetaType %>" />
    <meta property="og:title" content="<%= resolvedMetaTitle %>" />
    <meta property="og:description" content="<%= resolvedMetaDescription %>" />
    <meta property="og:url" content="<%= resolvedMetaUrl %>" />
    <meta property="og:image" content="<%= resolvedMetaImage %>" />
    <meta property="og:image:alt" content="OnDraft Football logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= resolvedMetaTitle %>" />
    <meta name="twitter:description" content="<%= resolvedMetaDescription %>" />
    <meta name="twitter:image" content="<%= resolvedMetaImage %>" />
    <link rel="icon" type="image/png" href="/images/brand/ondraft-logo.png" />
    <link rel="apple-touch-icon" href="/images/brand/ondraft-logo.png" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/tailwind.css" />
    <script src="/vendor/htmx/htmx.min.js" defer></script>
    <script src="/vendor/alpinejs-focus/cdn.min.js" defer></script>
    <script src="/vendor/alpinejs-collapse/cdn.min.js" defer></script>
    <script src="/vendor/alpinejs/cdn.min.js" defer></script>
    <script src="/ondraftShell.js" defer></script>
    <script src="/articleShare.js" defer></script>
    <script src="/teamHelmetRecolor.js" defer></script>
  </head>
  <body class="min-h-screen bg-slate-50 p-0 text-slate-950 antialiased dark:bg-draft-ink dark:text-slate-100">
    <% const currentSession = typeof session !== "undefined" ? session : null; %>
    <% const currentIsAdmin = typeof isAdmin !== "undefined" ? isAdmin : false; %>
    <% const currentForceOverlaySidebar = typeof forceOverlaySidebar !== "undefined" ? forceOverlaySidebar : false; %>
    <% const shellCurrentPath = typeof currentPath !== "undefined" ? currentPath : ""; %>
    <div
      class="min-h-screen"
      x-data="{ sidebarOpen: false }"
      x-init="$watch('sidebarOpen', value => { if (!value) $nextTick(() => document.body.focus?.()) })"
    >
      <%- include("partials/topBar", { currentSession, currentIsAdmin, forceOverlaySidebar: currentForceOverlaySidebar }) %>
      <%- include("partials/sidebar", { currentSession, currentIsAdmin, forceOverlaySidebar: currentForceOverlaySidebar, currentPath: shellCurrentPath }) %>
      <%- include("partials/beerLoader") %>
      <div id="site-modal-outlet"></div>
      <main id="page-content" class="mx-0 min-h-[calc(100vh-9rem)] max-w-none px-4 pb-10 pt-20 lg:px-8 <%= currentForceOverlaySidebar ? "" : "lg:mr-80" %>">
        <div class="w-full">
          <%- body %>
        </div>
      </main>
      <div class="<%= currentForceOverlaySidebar ? "" : "lg:mr-80" %>">
        <%- include("partials/footer") %>
      </div>
    </div>
  </body>
</html>

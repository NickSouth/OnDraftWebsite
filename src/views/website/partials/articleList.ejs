<% if (articles.length === 0) { %>
  <p>No articles match those filters.</p>
<% } else { %>
  <ul class="simple-list">
    <% articles.forEach((article) => { %>
      <% const articleHref = isAdmin && !article.published ? `/articles/${article.id}/preview` : `/articles/${article.id}`; %>
      <li id="article-list-item-<%= article.id %>" class="article-list-item">
        <a class="article-list-row" href="<%= articleHref %>">
          <% if (article.imageUrl) { %>
            <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" />
          <% } else { %>
            <span class="article-list-thumb article-list-thumb-empty"></span>
          <% } %>
          <span class="article-list-copy">
            <span class="article-list-title"><%= article.title %></span>
            <span class="muted-text">
              <% if (!article.published) { %>
                Draft -
              <% } %>
              by <%= article.author %>
              <% if (article.publicationDate) { %>
                on <%= new Date(article.publicationDate).toLocaleDateString() %>
              <% } %>
            </span>
            <span class="article-list-writeup"><%= article.writeup %></span>
            <span class="article-list-stats muted-text">
              <span><%= article.likes %> likes</span>
              <span><%= article.comments.length %> comments</span>
            </span>
            <% if (article.tags && article.tags.length > 0) { %>
              <span class="article-tags">
                <% article.tags.forEach((tag) => { %>
                  <span class="article-tag"><%= tag %></span>
                <% }) %>
              </span>
            <% } %>
          </span>
        </a>
        <% if (isAdmin) { %>
          <button
            type="button"
            class="danger-button article-delete-button"
            hx-delete="/articles/<%= article.id %>"
            hx-confirm="Are you sure? Deleted articles cannot be recovered."
            hx-target="#article-list-item-<%= article.id %>"
            hx-swap="outerHTML"
          >
            Delete
          </button>
        <% } %>
      </li>
    <% }) %>
  </ul>
<% } %>

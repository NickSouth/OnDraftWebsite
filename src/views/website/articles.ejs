<section class="plain-page">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Articles</p>
      <h1>Articles</h1>
    </div>
    <% if (isAdmin) { %>
      <a class="button-link" href="/articles/new">Create article</a>
    <% } %>
  </div>

  <% if (articles.length === 0) { %>
    <p>No articles have been created yet.</p>
  <% } else { %>
    <ul class="simple-list">
      <% articles.forEach((article) => { %>
        <li>
          <a class="article-list-row" href="/articles/<%= encodeURIComponent(article.title) %>">
            <% if (article.imageUrl) { %>
              <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" />
            <% } else { %>
              <span class="article-list-thumb article-list-thumb-empty"></span>
            <% } %>
            <span class="article-list-copy">
              <span class="article-list-title"><%= article.title %></span>
              <span class="muted-text">by <%= article.author %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

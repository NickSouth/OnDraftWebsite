<article class="plain-page readable-page">
  <p><a href="/articles">Back to articles</a></p>
  <h1><%= article.title %></h1>
  <p class="muted-text">
    By <%= article.author %>
    <% if (article.publicationDate) { %>
      on <%= new Date(article.publicationDate).toLocaleDateString() %>
    <% } %>
  </p>

  <% if (article.imageUrl) { %>
    <img class="article-image" src="<%= article.imageUrl %>" alt="" />
  <% } %>

  <% if (article.content.type === "pdf") { %>
    <div class="article-pdf-viewer">
      <object data="<%= article.content.url %>" type="application/pdf">
        <p>
          <a href="<%= article.content.url %>">Open <%= article.content.originalName %></a>
        </p>
      </object>
    </div>
  <% } else { %>
    <div class="article-body"><%= article.content.text %></div>
  <% } %>
</article>

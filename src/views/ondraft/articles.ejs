<section class="mx-auto grid w-full max-w-6xl gap-8">
  <div class="grid gap-5 border-b border-slate-200 pb-6 dark:border-white/10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">Articles On Tap</p>
      <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">
        Draft coverage with the head still on it.
      </h1>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
        Columns, scouting reads, and draft-room arguments built for fast scanning and deep reading.
      </p>
    </div>

    <% if (isAdmin) { %>
      <a class="od-primary-link" href="/articles/new">Create article</a>
    <% } %>
  </div>

  <% if (isAdmin) { %>
    <div class="inline-flex w-full rounded-lg border border-slate-200 bg-white p-1 shadow-sm dark:border-white/10 dark:bg-white/[0.04] sm:w-fit" aria-label="Article status">
      <button
        type="button"
        class="od-focus-ring flex-1 rounded-md px-4 py-2 text-sm font-black transition sm:flex-none <%= showingPublished ? "bg-draft-gold text-draft-ink" : "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10" %>"
        onclick="document.getElementById('article-status-field').value = 'published'; this.parentElement.querySelectorAll('button').forEach((button) => { button.classList.remove('bg-draft-gold', 'text-draft-ink'); button.classList.add('text-slate-700', 'dark:text-slate-200'); }); this.classList.add('bg-draft-gold', 'text-draft-ink'); this.classList.remove('text-slate-700', 'dark:text-slate-200'); htmx.trigger(document.querySelector('.article-filter-form'), 'submit');"
      >
        Published
      </button>
      <button
        type="button"
        class="od-focus-ring flex-1 rounded-md px-4 py-2 text-sm font-black transition sm:flex-none <%= showingPublished ? "text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10" : "bg-draft-gold text-draft-ink" %>"
        onclick="document.getElementById('article-status-field').value = 'draft'; this.parentElement.querySelectorAll('button').forEach((button) => { button.classList.remove('bg-draft-gold', 'text-draft-ink'); button.classList.add('text-slate-700', 'dark:text-slate-200'); }); this.classList.add('bg-draft-gold', 'text-draft-ink'); this.classList.remove('text-slate-700', 'dark:text-slate-200'); htmx.trigger(document.querySelector('.article-filter-form'), 'submit');"
      >
        Unpublished
      </button>
    </div>
  <% } %>

  <form
    class="article-filter-form od-card grid gap-4 p-4 sm:p-5"
    hx-get="/articles/filter"
    hx-target="#articles-results"
    hx-swap="innerHTML"
    x-data="{ filtersOpen: false }"
  >
    <% if (isAdmin) { %>
      <input id="article-status-field" type="hidden" name="status" value="<%= showingPublished ? "published" : "draft" %>" />
    <% } %>

    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto_auto] lg:items-end">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Search</span>
        <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-base text-slate-950 placeholder:text-slate-400 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="keyword" type="search" placeholder="Search articles" />
      </label>
      <button class="od-primary-link w-full lg:w-auto" type="submit">Search</button>
      <button
        type="button"
        class="od-secondary-link w-full lg:w-auto"
        :aria-expanded="String(filtersOpen)"
        aria-controls="article-filter-panel"
        @click="filtersOpen = !filtersOpen"
      >
        Filters
      </button>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Sort by</span>
        <select class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" id="article-sort-by" name="sortBy" onchange="htmx.trigger(this.form, 'submit');">
          <option value="date" <%= sortBy === "date" ? "selected" : "" %>>Date</option>
          <option value="likes" <%= sortBy === "likes" ? "selected" : "" %>>Likes</option>
          <option value="comments" <%= sortBy === "comments" ? "selected" : "" %>>Comments</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Direction</span>
        <select class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" id="article-sort-direction" name="sortDirection" onchange="htmx.trigger(this.form, 'submit');">
          <option value="desc" <%= sortDirection === "desc" ? "selected" : "" %>>Descending</option>
          <option value="asc" <%= sortDirection === "asc" ? "selected" : "" %>>Ascending</option>
        </select>
      </label>
    </div>

    <div id="article-filter-panel" class="grid gap-4 border-t border-slate-200 pt-4 dark:border-white/10" x-show="filtersOpen" x-collapse x-cloak>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
          <span>Author</span>
          <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="author" />
        </label>
        <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
          <span>From</span>
          <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" type="date" name="dateFrom" />
        </label>
        <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
          <span>To</span>
          <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" type="date" name="dateTo" />
        </label>
        <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
          <span>Tags</span>
          <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="tags" />
        </label>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <button class="od-primary-link" type="submit">Apply filters</button>
        <button
          type="button"
          class="od-secondary-link"
          onclick="const status = document.getElementById('article-status-field')?.value || 'published'; this.form.reset(); const statusField = document.getElementById('article-status-field'); if (statusField) statusField.value = status; htmx.trigger(this.form, 'submit');"
        >
          Clear
        </button>
      </div>
    </div>
  </form>

  <div id="articles-results">
    <%- include("partials/articleList", { articles, isAdmin, showingPublished, session, bookmarkedArticleIds }) %>
  </div>
</section>

<section class="plain-page">
  <p class="eyebrow">OnDraft</p>
  <h1>OnDraft</h1>
  <% if (session.authenticatedUser) { %>
    <p class="welcome-note">
      Signed in as <strong><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.email %>).
    </p>
  <% } %>
  <div class="home-actions">
    <a class="button-link" href="/articles">View articles</a>
    <a class="button-link" href="/videos">Videos</a>
    <a class="button-link" href="/hottakes">OnDraft Hot Takes</a>
    <a class="button-link" href="/bigboard">View draft board</a>
    <a class="button-link" href="/bookmarks">Bookmarks</a>
  </div>
</section>

<% const featured = latestItems[0]; %>
<% const carouselItems = latestItems.length > 0 ? latestItems : []; %>

<section class="grid gap-8">
  <div class="relative overflow-hidden rounded-lg border border-slate-200 bg-white shadow-editorial dark:border-white/10 dark:bg-draft-slate">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,rgba(217,152,34,0.22),transparent_34%),linear-gradient(135deg,rgba(7,17,31,0.02),rgba(7,17,31,0.1))] dark:bg-[radial-gradient(circle_at_20%_0%,rgba(217,152,34,0.2),transparent_32%),linear-gradient(135deg,rgba(255,255,255,0.06),rgba(7,17,31,0.1))]" aria-hidden="true"></div>
    <div class="relative grid items-center gap-8 p-5 md:p-8 xl:grid-cols-[0.9fr_1.1fr]">
      <div class="flex min-h-[360px] flex-col justify-between gap-8">
        <div class="max-w-2xl">
          <img class="mb-4 h-20 w-24 object-contain drop-shadow-sm" src="/images/brand/ondraft-logo.png" alt="" aria-hidden="true" />
          <p class="mb-3 text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Fresh from the tap</p>
          <h1 class="font-display text-4xl font-black leading-tight text-slate-950 dark:text-white md:text-6xl">
            OnDraft Football
          </h1>
          <p class="mt-4 max-w-xl text-base leading-7 text-slate-700 dark:text-slate-200 md:text-lg">
            A collection of NFL and NFL Draft analysis, opinions, and predictions from a small team of college students. Enjoy articles, videos, and our draft board. Feel free to post your own takes in The Taproom, our community forum.
          </p>

          <a class="od-primary-link mt-4" href="/about">Learn More</a>

        </div>

        <div class="grid gap-2 border-l-4 border-draft-gold pl-4 text-sm font-semibold text-slate-600 dark:text-slate-300">
          <p class="m-0">Like our work? Follow our other socials below, or consider supporting us with a donation to our Venmo linked below as well.</p>
          <div class="grid gap-3 pt-2" aria-label="OnDraft social media links">
            <div class="flex min-h-11 items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-md bg-white p-2 shadow-sm ring-1 ring-slate-200 dark:ring-white/10">
                <img class="h-7 w-10 object-contain" src="/images/social/youtube-icon.svg" alt="YouTube" />
              </span>
              <span class="text-sm font-black text-slate-700 dark:text-slate-200">/ @HandleName</span>
            </div>

            <div class="flex min-h-11 items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-md bg-white p-2 shadow-sm ring-1 ring-slate-200 dark:ring-white/10">
                <img class="size-8 object-contain" src="/images/social/x-icon.svg" alt="X" />
              </span>
              <span class="text-sm font-black text-slate-700 dark:text-slate-200">/ @HandleName</span>
            </div>

            <div class="flex min-h-11 items-center gap-3">
              <span class="grid size-11 shrink-0 place-items-center rounded-md bg-white p-2 shadow-sm ring-1 ring-slate-200 dark:ring-white/10">
                <img class="size-8 object-contain" src="/images/social/tiktok-icon.svg" alt="TikTok" />
              </span>
              <span class="text-sm font-black text-slate-700 dark:text-slate-200">/ @HandleName</span>
            </div>

            <a
              class="od-focus-ring group flex min-h-11 w-fit items-center gap-3 rounded-md px-0 py-0 text-sm font-black text-slate-700 transition hover:text-draft-amber dark:text-slate-200 dark:hover:text-draft-gold"
              href="https://www.venmo.com/u/OnDraft-Football"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Support OnDraft Football on Venmo"
            >
              <span class="grid h-11 w-24 shrink-0 place-items-center rounded-md bg-white px-2 py-1.5 shadow-sm ring-1 ring-slate-200 transition group-hover:ring-draft-gold dark:ring-white/10">
                <img class="h-7 w-full object-contain" src="/images/social/venmo-logo-blue.png" alt="Venmo" />
              </span>
              <span>/ @OnDraft-Football</span>
            </a>
          </div>
        </div>
      </div>

      <div
        class="od-card overflow-hidden shadow-editorial"
        x-data="{
          active: 0,
          previous: 0,
          direction: 1,
          count: <%= Math.max(carouselItems.length, 1) %>,
          duration: 7000,
          remaining: 7000,
          startedAt: 0,
          progress: 0,
          timeout: null,
          frame: null,
          paused: false,
          init() {
            this.schedule(this.duration);
          },
          destroy() {
            this.clearTimer();
          },
          clearTimer() {
            if (this.timeout) {
              window.clearTimeout(this.timeout);
              this.timeout = null;
            }
            if (this.frame) {
              window.cancelAnimationFrame(this.frame);
              this.frame = null;
            }
          },
          next(shouldRestart = true) {
            this.previous = this.active;
            this.direction = 1;
            this.active = this.active === this.count - 1 ? 0 : this.active + 1;
            if (shouldRestart) {
              this.schedule(this.duration);
            }
          },
          prev() {
            this.previous = this.active;
            this.direction = -1;
            this.active = this.active === 0 ? this.count - 1 : this.active - 1;
            this.schedule(this.duration);
          },
          go(index) {
            this.previous = this.active;
            this.direction = index >= this.active ? 1 : -1;
            this.active = index;
            this.schedule(this.duration);
          },
          schedule(delay) {
            this.clearTimer();
            this.remaining = delay;
            if (this.count <= 1 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              this.progress = 0;
              return;
            }
            this.paused = false;
            this.startedAt = Date.now();
            this.progress = ((this.duration - this.remaining) / this.duration) * 100;
            this.tick();
            this.timeout = window.setTimeout(() => {
              this.next(false);
              this.schedule(this.duration);
            }, this.remaining);
          },
          tick() {
            if (this.paused) {
              return;
            }
            const elapsed = Date.now() - this.startedAt;
            this.progress = Math.min(100, ((this.duration - this.remaining + elapsed) / this.duration) * 100);
            if (this.progress < 100) {
              this.frame = window.requestAnimationFrame(() => this.tick());
            }
          },
          pause() {
            if (this.count <= 1 || this.paused) {
              return;
            }
            const elapsed = Date.now() - this.startedAt;
            this.remaining = Math.max(0, this.remaining - elapsed);
            this.paused = true;
            this.clearTimer();
          },
          resume() {
            if (!this.paused) {
              return;
            }
            this.schedule(this.remaining || this.duration);
          }
        }"
        @mouseenter="pause()"
        @mouseleave="resume()"
        @focusin="pause()"
        @focusout="if (!$el.contains($event.relatedTarget)) resume()"
      >
        <div class="border-b border-slate-200 px-4 py-3 dark:border-white/10">
          <p class="m-0 text-xs font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-300">Latest pour</p>
        </div>

        <% if (carouselItems.length === 0) { %>
          <div class="grid min-h-[320px] place-items-center p-6 text-center">
            <div class="max-w-sm">
              <div class="mx-auto mb-4 grid size-16 place-items-center rounded-lg bg-white/90 ring-1 ring-slate-200 dark:bg-white/10 dark:ring-white/10" aria-hidden="true">
                <img class="h-14 w-16 object-contain" src="/images/brand/ondraft-logo.png" alt="" />
              </div>
              <h2 class="font-display text-2xl font-bold text-slate-950 dark:text-white">The tap list is warming up.</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">Publish an article or add a video and it will headline the homepage carousel.</p>
            </div>
          </div>
        <% } else { %>
          <div class="relative min-h-[430px] overflow-hidden bg-slate-900 md:min-h-[520px]">
            <% carouselItems.forEach((item, index) => { %>
              <% const slideFallbackImageUrl = item.type === "video" ? item.fallbackImageUrl : undefined; %>
              <article
                class="od-home-carousel-slide absolute inset-0 grid content-end overflow-hidden bg-slate-900"
                :class="active === <%= index %> ? 'is-active pointer-events-auto z-10' : 'pointer-events-none z-0'"
                :style="active === <%= index %> ? `--od-slide-x: ${direction * 2.25}rem;` : previous === <%= index %> ? `--od-slide-x: ${direction * -2.25}rem;` : '--od-slide-x: 0rem;'"
                :aria-hidden="active === <%= index %> ? 'false' : 'true'"
              >
                <% if (item.imageUrl) { %>
                  <img
                    class="absolute inset-0 h-full w-full object-cover opacity-70"
                    src="<%= item.imageUrl %>"
                    alt=""
                    <% if (slideFallbackImageUrl) { %>
                      data-fallback-src="<%= slideFallbackImageUrl %>"
                      onerror="if (this.dataset.fallbackApplied === 'true') return; this.dataset.fallbackApplied = 'true'; this.src = this.dataset.fallbackSrc;"
                    <% } %>
                  />
                <% } else { %>
                  <div class="absolute inset-0 bg-[linear-gradient(135deg,#07111f,#263247_54%,#a75f12)]" aria-hidden="true"></div>
                <% } %>
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent" aria-hidden="true"></div>
                <div class="group relative p-5 md:p-8">
                  <div class="mb-3 flex flex-wrap items-center gap-2">
                    <span class="rounded bg-draft-gold px-2 py-1 text-xs font-black uppercase tracking-wide text-draft-ink"><%= item.type === "article" ? "Article" : "Video" %></span>
                    <% item.tags.slice(0, 3).forEach((tag) => { %>
                      <span class="rounded bg-draft-foam px-2 py-1 text-xs font-black text-draft-gold dark:bg-white/10"><%= tag.toLowerCase() %></span>
                    <% }) %>
                  </div>
                  <h2 class="font-display text-4xl font-black leading-tight text-white md:text-5xl"><%= item.title %></h2>
                  <p class="mt-4 max-h-0 overflow-hidden text-base leading-7 text-slate-200 opacity-0 transition-all duration-200 group-hover:max-h-32 group-hover:opacity-100 group-focus-within:max-h-32 group-focus-within:opacity-100">
                    <%= item.description %>
                  </p>
                  <div class="mt-5 flex items-center justify-between gap-4">
                    <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-300">
                      <%= item.date.toLocaleDateString() %>
                    </span>
                    <a class="od-primary-link" href="<%= item.href %>" <%= item.type === "video" ? 'target="_blank" rel="noopener noreferrer"' : "" %>>Open</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

          <div class="h-1 bg-slate-200 dark:bg-white/10" aria-hidden="true">
            <div
              class="h-full bg-draft-gold"
              :style="`width: ${progress}%; transition: ${paused ? 'none' : 'width 120ms linear'};`"
            ></div>
          </div>

          <div class="flex items-center justify-between gap-3 border-t border-slate-200 p-4 dark:border-white/10">
            <button type="button" class="od-icon-button size-9" @click="prev()" aria-label="Previous slide" title="Previous slide">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m11 18-6-6 6-6" />
              </svg>
            </button>
            <div class="flex gap-2" aria-label="Carousel slides">
              <% carouselItems.forEach((_item, index) => { %>
                <button
                  type="button"
                  class="size-2.5 rounded-full p-0"
                  :class="active === <%= index %> ? 'bg-draft-gold' : 'bg-slate-300 dark:bg-white/30'"
                  aria-label="Show slide <%= index + 1 %>"
                  @click="go(<%= index %>)"
                ></button>
              <% }) %>
            </div>
            <button type="button" class="od-icon-button size-9" @click="next()" aria-label="Next slide" title="Next slide">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <section class="relative isolate overflow-hidden rounded-lg border border-draft-gold/30 bg-draft-ink px-5 py-7 shadow-editorial dark:border-draft-gold/40 sm:px-7 md:px-8">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_10%_0%,rgba(217,152,34,0.32),transparent_30%),linear-gradient(135deg,rgba(11,18,32,0.98),rgba(18,28,43,0.94)_58%,rgba(167,95,18,0.26))]" aria-hidden="true"></div>
    <div class="absolute inset-y-0 right-0 -z-10 hidden w-1/2 bg-draft-gold/10 [clip-path:polygon(9rem_0,100%_0,100%_100%,0_100%)] lg:block" aria-hidden="true"></div>
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
      <div class="max-w-3xl">
        <p class="mb-3 text-xs font-black uppercase tracking-[0.18em] text-draft-gold">Big board pulse</p>
        <h2 class="font-display text-3xl font-black leading-tight text-white sm:text-4xl">The NFL draft changes lives.</h2>
        <p class="mt-3 text-lg font-semibold leading-8 text-slate-200">
          See our rankings of upcoming prospects.
        </p>
      </div>
      <a class="od-primary-link min-h-12 px-5 text-base shadow-sm" href="/bigboard">View draft board</a>
    </div>
  </section>

  <section class="grid gap-4">
    <%- include("partials/popularArticles", { popularArticles, popularRange }) %>
  </section>
</section>

<% const featured = latestItems[0]; %>
<% const carouselItems = latestItems.length > 0 ? latestItems : []; %>

<section class="grid gap-5 sm:gap-8">
  <div class="relative overflow-hidden rounded-lg border border-slate-200 bg-white shadow-editorial dark:border-white/10 dark:bg-draft-slate">
    <div class="od-hero-flow" aria-hidden="true"></div>
    <div class="od-hero-facets" aria-hidden="true">
      <svg viewBox="0 0 100 60" preserveAspectRatio="none" focusable="false">
        <polygon class="od-facet-tint" points="0,0 20,0 0,17" />
        <polygon class="od-facet-shade" points="100,60 78,60 100,42" />
        <polygon class="od-facet-tint" points="100,0 86,0 100,13" />
        <polygon class="od-facet-shade" points="0,60 16,60 0,49" />
        <polygon class="od-facet-tint" points="55,0 66,0 59,10" />
        <polygon class="od-facet-shade" points="100,22 92,31 100,37" />
        <polygon class="od-facet-tint" points="34,60 46,60 39,51" />
      </svg>
    </div>
    <div class="relative grid items-center gap-5 p-4 sm:p-5 md:gap-8 md:p-8 xl:grid-cols-[0.9fr_1.1fr]">
      <div class="relative flex min-h-0 flex-col justify-between gap-5 md:min-h-[360px] md:gap-8">
        <div class="max-w-none" data-od-reveal>
          <p class="mb-2 text-[0.68rem] font-black uppercase tracking-[0.12em] text-draft-amber dark:text-draft-gold sm:text-xs sm:tracking-[0.16em] md:mb-3">Fresh from the tap</p>
          <div class="relative md:pr-44 xl:pr-52">
            <img class="pointer-events-none absolute right-0 -top-7 hidden h-32 w-44 object-contain drop-shadow-sm md:block xl:h-36 xl:w-52" src="/images/brand/OnDraftLogo-cropped.png" alt="" aria-hidden="true" />
            <h1 class="font-display text-3xl font-black leading-tight text-slate-950 dark:text-white sm:text-4xl md:text-6xl">
              OnDraft Football
            </h1>
          </div>
          <img class="mt-2 h-24 w-32 object-contain drop-shadow-sm sm:h-32 sm:w-40 md:hidden" src="/images/brand/OnDraftLogo-cropped.png" alt="" aria-hidden="true" />
          <p class="mt-4 max-w-3xl text-sm leading-6 text-slate-700 dark:text-slate-200 sm:text-base sm:leading-7 md:mt-6 md:text-lg">
            A collection of NFL and NFL Draft analysis, opinions, and predictions from a small team of college students. Enjoy articles, videos, and our draft board. Feel free to post your own takes in The Taproom, our community forum.
          </p>

          <div class="mt-4 flex flex-wrap items-center gap-2.5 md:mt-5" data-od-reveal style="--od-reveal-delay: 90ms">
            <a class="od-primary-link" href="/articles">Read the latest articles</a>
            <a class="od-secondary-link" href="/about">About OnDraft</a>
          </div>

          <div
            class="mt-3 flex flex-wrap gap-2"
            data-od-reveal
            style="--od-reveal-delay: 120ms"
            aria-label="OnDraft by the numbers"
            x-data="{
              started: false,
              start() {
                if (this.started) return;
                this.started = true;
                const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                this.$root.querySelectorAll('[data-count-to]').forEach((el) => {
                  const target = Number(el.dataset.countTo) || 0;
                  if (reduce || target === 0) { el.textContent = target.toLocaleString(); return; }
                  const duration = 1400;
                  const startedAt = performance.now();
                  const tick = (now) => {
                    const t = Math.min(1, (now - startedAt) / duration);
                    const eased = 1 - Math.pow(1 - t, 3);
                    el.textContent = Math.round(target * eased).toLocaleString();
                    if (t < 1) window.requestAnimationFrame(tick);
                  };
                  window.requestAnimationFrame(tick);
                });
              },
              init() {
                if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) { this.start(); return; }
                this.$root.querySelectorAll('[data-count-to]').forEach((el) => { el.textContent = '0'; });
                const observer = new IntersectionObserver((entries) => {
                  entries.forEach((entry) => { if (entry.isIntersecting) { observer.disconnect(); this.start(); } });
                }, { threshold: 0.35 });
                observer.observe(this.$root);
              }
            }"
          >
            <a class="od-hero-stat" href="/bigboard" aria-label="View the draft board">
              <span class="od-hero-stat-number" data-count-to="<%= heroStats.playersScouted %>"><%= heroStats.playersScouted.toLocaleString() %></span>
              <span class="od-hero-stat-label">Players Scouted</span>
            </a>
            <a class="od-hero-stat" href="/articles" aria-label="Read our articles">
              <span class="od-hero-stat-number" data-count-to="<%= heroStats.articlesWritten %>"><%= heroStats.articlesWritten.toLocaleString() %></span>
              <span class="od-hero-stat-label">Articles Written</span>
            </a>
            <a class="od-hero-stat" href="/hottakes" aria-label="Visit the Taproom forum">
              <span class="od-hero-stat-number" data-count-to="<%= heroStats.hotTakesPosted %>"><%= heroStats.hotTakesPosted.toLocaleString() %></span>
              <span class="od-hero-stat-label">Hot Takes Posted</span>
            </a>
          </div>

        </div>

        <div class="grid gap-2" data-od-reveal style="--od-reveal-delay: 150ms">
          <p class="m-0 text-[0.65rem] font-bold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Follow the pour &middot; support us on Venmo</p>
          <div class="od-hero-social-row" aria-label="OnDraft social media links">
            <a class="od-hero-social-link group" href="https://www.youtube.com/channel/UCX7Py3t2L1pUYF6JxzzP4fA" target="_blank" rel="noopener noreferrer" aria-label="OnDraft Football on YouTube" title="YouTube">
              <img class="h-4 w-6 object-contain opacity-70 grayscale transition duration-200 group-hover:opacity-100 group-hover:grayscale-0 sm:h-5 sm:w-7" src="/images/social/youtube-icon.svg" alt="" />
            </a>
            <a class="od-hero-social-link group" href="https://x.com/OnDraftFootball" target="_blank" rel="noopener noreferrer" aria-label="OnDraft Football on X" title="X">
              <img class="size-4 object-contain opacity-70 grayscale transition duration-200 group-hover:opacity-100 group-hover:grayscale-0 sm:size-5" src="/images/social/x-icon.svg" alt="" />
            </a>
            <a class="od-hero-social-link group" href="https://www.tiktok.com/@ondraftfootball" target="_blank" rel="noopener noreferrer" aria-label="OnDraft Football on TikTok" title="TikTok">
              <img class="size-4 object-contain opacity-70 grayscale transition duration-200 group-hover:opacity-100 group-hover:grayscale-0 sm:size-5" src="/images/social/tiktok-icon.svg" alt="" />
            </a>
            <a class="od-hero-social-link group w-16 px-2 sm:w-20" href="https://www.venmo.com/u/OnDraft-Football" target="_blank" rel="noopener noreferrer" aria-label="Support OnDraft Football on Venmo" title="Support us on Venmo">
              <img class="h-3.5 w-full object-contain opacity-70 grayscale transition duration-200 group-hover:opacity-100 group-hover:grayscale-0 sm:h-4" src="/images/social/venmo-logo-blue.png" alt="" />
            </a>
          </div>
        </div>
      </div>

      <div class="grid content-start gap-3 sm:gap-4">
      <div
        class="od-card overflow-hidden shadow-editorial"
        data-od-reveal
        style="--od-reveal-delay: 120ms"
        x-data="{
          active: 0,
          previous: 0,
          direction: 1,
          count: <%= Math.max(carouselItems.length, 1) %>,
          duration: 7000,
          remaining: 7000,
          startedAt: 0,
          progress: 0,
          timeout: null,
          frame: null,
          paused: false,
          init() {
            this.schedule(this.duration);
          },
          destroy() {
            this.clearTimer();
          },
          clearTimer() {
            if (this.timeout) {
              window.clearTimeout(this.timeout);
              this.timeout = null;
            }
            if (this.frame) {
              window.cancelAnimationFrame(this.frame);
              this.frame = null;
            }
          },
          next(shouldRestart = true) {
            this.previous = this.active;
            this.direction = 1;
            this.active = this.active === this.count - 1 ? 0 : this.active + 1;
            if (shouldRestart) {
              this.schedule(this.duration);
            }
          },
          prev() {
            this.previous = this.active;
            this.direction = -1;
            this.active = this.active === 0 ? this.count - 1 : this.active - 1;
            this.schedule(this.duration);
          },
          go(index) {
            this.previous = this.active;
            this.direction = index >= this.active ? 1 : -1;
            this.active = index;
            this.schedule(this.duration);
          },
          schedule(delay) {
            this.clearTimer();
            this.remaining = delay;
            if (this.count <= 1 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              this.progress = 0;
              return;
            }
            this.paused = false;
            this.startedAt = Date.now();
            this.progress = ((this.duration - this.remaining) / this.duration) * 100;
            this.tick();
            this.timeout = window.setTimeout(() => {
              this.next(false);
              this.schedule(this.duration);
            }, this.remaining);
          },
          tick() {
            if (this.paused) {
              return;
            }
            const elapsed = Date.now() - this.startedAt;
            this.progress = Math.min(100, ((this.duration - this.remaining + elapsed) / this.duration) * 100);
            if (this.progress < 100) {
              this.frame = window.requestAnimationFrame(() => this.tick());
            }
          },
          pause() {
            if (this.count <= 1 || this.paused) {
              return;
            }
            const elapsed = Date.now() - this.startedAt;
            this.remaining = Math.max(0, this.remaining - elapsed);
            this.paused = true;
            this.clearTimer();
          },
          resume() {
            if (!this.paused) {
              return;
            }
            this.schedule(this.remaining || this.duration);
          }
        }"
        @mouseenter="pause()"
        @mouseleave="resume()"
        @focusin="pause()"
        @focusout="if (!$el.contains($event.relatedTarget)) resume()"
      >
        <div class="border-b border-slate-200 px-3 py-2.5 dark:border-white/10 sm:px-4 sm:py-3">
          <p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.1em] text-slate-500 dark:text-slate-300 sm:text-xs sm:tracking-[0.14em]">Latest pour</p>
        </div>

        <% if (carouselItems.length === 0) { %>
          <div class="grid min-h-[320px] place-items-center p-6 text-center">
            <div class="max-w-sm">
              <img class="mx-auto mb-4 h-20 w-24 object-contain drop-shadow-sm" src="/images/brand/OnDraftLogo-cropped.png" alt="" aria-hidden="true" />
              <h2 class="font-display text-2xl font-bold text-slate-950 dark:text-white">The tap list is warming up.</h2>
              <p class="mt-2 text-slate-600 dark:text-slate-300">Publish an article or add a video and it will headline the homepage carousel.</p>
            </div>
          </div>
        <% } else { %>
          <div class="relative min-h-[270px] overflow-hidden bg-slate-900 sm:min-h-[430px] md:min-h-[520px]">
            <% carouselItems.forEach((item, index) => { %>
              <% const slideFallbackImageUrl = item.type === "video" ? item.fallbackImageUrl : undefined; %>
              <article
                class="od-home-carousel-slide absolute inset-0 grid content-end overflow-hidden bg-slate-900"
                :class="active === <%= index %> ? 'is-active pointer-events-auto z-10' : 'pointer-events-none z-0'"
                :style="active === <%= index %> ? `--od-slide-x: ${direction * 2.25}rem;` : previous === <%= index %> ? `--od-slide-x: ${direction * -2.25}rem;` : '--od-slide-x: 0rem;'"
                :aria-hidden="active === <%= index %> ? 'false' : 'true'"
              >
                <% if (item.imageUrl) { %>
                  <img
                    class="od-home-carousel-media"
                    src="<%= item.imageUrl %>"
                    alt=""
                    <% if (slideFallbackImageUrl) { %>
                      data-fallback-src="<%= slideFallbackImageUrl %>"
                      onerror="if (this.dataset.fallbackApplied === 'true') return; this.dataset.fallbackApplied = 'true'; this.src = this.dataset.fallbackSrc;"
                    <% } %>
                  />
                <% } else { %>
                  <div class="od-slide-flow" aria-hidden="true"></div>
                <% } %>
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/60 to-transparent" aria-hidden="true"></div>
                <% if (item.type === "video") { %>
                  <%- include("partials/videoPlayOverlay") %>
                <% } %>
                <div class="group relative p-4 sm:p-5 md:p-8">
                  <div class="mb-2 flex flex-wrap items-center gap-1.5 sm:mb-3 sm:gap-2">
                    <span class="rounded bg-draft-gold px-2 py-0.5 text-[0.68rem] font-black uppercase tracking-wide text-draft-ink sm:py-1 sm:text-xs"><%= item.type === "article" ? "Article" : "Video" %></span>
                    <% item.tags.slice(0, 3).forEach((tag, tagIndex) => { %>
                      <span class="<%= tagIndex > 0 ? "hidden sm:inline-flex" : "inline-flex" %> rounded bg-draft-foam px-2 py-0.5 text-[0.68rem] font-black text-draft-gold dark:bg-white/10 sm:py-1 sm:text-xs"><%= tag.toLowerCase() %></span>
                    <% }) %>
                  </div>
                  <h2 class="line-clamp-3 font-display text-[1.45rem] font-black leading-tight text-white sm:line-clamp-none sm:text-4xl md:text-5xl"><%= item.title %></h2>
                  <p class="mt-3 line-clamp-3 max-h-0 overflow-hidden text-sm leading-6 text-slate-200 opacity-0 transition-all duration-200 group-hover:max-h-32 group-hover:opacity-100 group-focus-within:max-h-32 group-focus-within:opacity-100 sm:mt-4 sm:line-clamp-none sm:text-base sm:leading-7">
                    <%= item.description %>
                  </p>
                  <div class="mt-3 flex items-center justify-between gap-2 sm:mt-5 sm:gap-4">
                    <span class="text-[0.68rem] font-bold uppercase tracking-[0.12em] text-slate-300 sm:text-xs sm:tracking-[0.16em]">
                      <%= item.date.toLocaleDateString() %><% if (item.type === "article" && item.readMinutes) { %> &middot; <%= item.readMinutes %> min read<% } %>
                    </span>
                    <a class="od-primary-link" href="<%= item.href %>" <%= item.type === "video" ? 'target="_blank" rel="noopener noreferrer"' : "" %>>Open</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

          <div class="h-1 bg-slate-200 dark:bg-white/10" aria-hidden="true">
            <div
              class="h-full bg-draft-gold"
              :style="`width: ${progress}%; transition: ${paused ? 'none' : 'width 120ms linear'};`"
            ></div>
          </div>

          <div class="flex items-center justify-between gap-2 border-t border-slate-200 p-3 dark:border-white/10 sm:gap-3 sm:p-4">
            <button type="button" class="od-icon-button size-8 sm:size-9" @click="prev()" aria-label="Previous slide" title="Previous slide">
              <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5" />
                <path d="m11 18-6-6 6-6" />
              </svg>
            </button>
            <div class="flex gap-2" aria-label="Carousel slides">
              <% carouselItems.forEach((_item, index) => { %>
                <button
                  type="button"
                  class="size-2 rounded-full p-0 sm:size-2.5"
                  :class="active === <%= index %> ? 'bg-draft-gold' : 'bg-slate-300 dark:bg-white/30'"
                  aria-label="Show slide <%= index + 1 %>"
                  @click="go(<%= index %>)"
                ></button>
              <% }) %>
            </div>
            <button type="button" class="od-icon-button size-8 sm:size-9" @click="next()" aria-label="Next slide" title="Next slide">
              <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </button>
          </div>
        <% } %>
      </div>
      </div>
    </div>
  </div>

  <section class="relative isolate overflow-hidden rounded-lg border border-draft-gold/30 bg-draft-ink px-4 py-5 shadow-editorial dark:border-draft-gold/40 sm:px-7 sm:py-7 md:px-8" data-od-reveal>
    <div class="od-pulse-flow" aria-hidden="true"></div>
    <div class="od-pulse-facets hidden lg:block" aria-hidden="true"></div>
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
      <div class="max-w-3xl">
        <p class="mb-2 text-[0.68rem] font-black uppercase tracking-[0.14em] text-draft-gold sm:mb-3 sm:text-xs sm:tracking-[0.18em]">Big board pulse</p>
        <h2 class="font-display text-2xl font-black leading-tight text-white sm:text-4xl">The NFL draft changes lives.</h2>
        <p class="mt-2 text-sm font-semibold leading-6 text-slate-200 sm:mt-3 sm:text-lg sm:leading-8">
          See our rankings of upcoming prospects.
        </p>
      </div>
      <a class="od-primary-link w-full shadow-sm sm:min-h-12 sm:w-auto sm:px-5 sm:text-base" href="/bigboard">View draft board</a>
    </div>
  </section>

  <section class="grid gap-4" data-od-reveal>
    <%- include("partials/popularArticles", { popularArticles, popularRange }) %>
  </section>
</section>

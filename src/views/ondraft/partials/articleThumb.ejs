<%# Shows the whole thumbnail whatever its shape: the image is fitted inside its slot and a
    blurred copy fills the space left over. The slot must be relative with overflow hidden. %>
<img class="article-thumb-backdrop" src="<%= src %>" alt="" aria-hidden="true" loading="lazy" decoding="async" />
<img class="article-list-thumb" src="<%= src %>" alt="" loading="lazy" decoding="async" />

<div id="hot-take-composer" class="hot-take-composer" <% if (typeof outOfBand !== "undefined" && outOfBand) { %>hx-swap-oob="true"<% } %>>
  <% const currentActiveBan = typeof activeUserBan !== "undefined" ? activeUserBan : null; %>
  <% if (session.authenticatedUser && currentActiveBan) { %>
    <%- include("bannedUserNotice", { ban: currentActiveBan }) %>
  <% } else if (session.authenticatedUser && !session.authenticatedUser.emailVerifiedAt) { %>
    <% if (errorMessage) { %>
      <p class="error-message"><%= errorMessage %></p>
    <% } %>
    <p class="muted-text">Verify your email before posting a hot take.</p>
  <% } else if (session.authenticatedUser) { %>
    <% if (errorMessage) { %>
      <p class="error-message"><%= errorMessage %></p>
    <% } %>
    <form
      class="comment-form"
      hx-post="/hottakes"
      hx-include="#hot-take-filter-form"
      hx-target="#hot-take-list"
      hx-swap="outerHTML"
      x-data="{ content: '' }"
      x-init="content = $refs.hotTakeContent.value"
    >
      <label>
        Your hot take
        <textarea x-ref="hotTakeContent" x-model="content" name="content" maxlength="300" required><%= values.content || "" %></textarea>
      </label>
      <div class="form-actions">
        <button type="submit">Post Hot Take</button>
        <span class="muted-text"><span x-text="content.length">0</span>/300 characters</span>
      </div>
    </form>
  <% } else { %>
    <p class="muted-text"><a href="/login">Log in</a> to post a hot take.</p>
  <% } %>
</div>

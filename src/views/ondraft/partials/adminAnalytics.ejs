<section class="grid gap-5 lg:grid-cols-[0.95fr_1.05fr]">
  <%
    const currentCategory = typeof category !== "undefined" ? category : "all";
    const analyticsSummary = typeof summary !== "undefined" ? summary : null;
    const metricValue = (value) => value === null || value === undefined ? "Pending" : value.toLocaleString();
  %>
  <div class="od-card p-5">
    <p class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Analytics</p>
    <h2 class="mt-1 text-2xl font-black tracking-normal text-slate-950 dark:text-white">Umami</h2>
    <p class="mt-3 text-sm font-semibold text-slate-600 dark:text-slate-300">Open-source, privacy-friendly analytics are tracked through the Umami Cloud script. Dashboard stats use the Umami API when an API key is configured.</p>
    <% if (analyticsSummary?.message) { %>
      <p class="mt-4 rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold text-slate-700 dark:border-white/10 dark:bg-white/5 dark:text-slate-200"><%= analyticsSummary.message %></p>
    <% } %>
    <% if (errorMessage) { %>
      <p class="od-admin-error mt-4" role="alert"><%= errorMessage %></p>
    <% } %>
  </div>

  <div class="od-card p-5">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">View</p>
        <h2 class="mt-1 text-2xl font-black tracking-normal text-slate-950 dark:text-white">Traffic Overview</h2>
      </div>
      <form
        class="m-0"
        hx-get="/admin/tabs/analytics"
        hx-target="#admin-dashboard-panel"
        hx-swap="innerHTML"
      >
        <label class="text-sm font-black text-slate-700 dark:text-slate-200">
          Category
          <select class="mt-1 rounded-md border border-slate-200 bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-draft-ink" name="category" onchange="htmx.trigger(this.form, 'submit');">
            <option value="all" <%= currentCategory === "all" ? "selected" : "" %>>All pages</option>
            <option value="articles" <%= currentCategory === "articles" ? "selected" : "" %>>Articles</option>
            <option value="videos" <%= currentCategory === "videos" ? "selected" : "" %>>Videos</option>
            <option value="home" <%= currentCategory === "home" ? "selected" : "" %>>Home</option>
            <option value="draft-board" <%= currentCategory === "draft-board" ? "selected" : "" %>>Draft board</option>
            <option value="taproom" <%= currentCategory === "taproom" ? "selected" : "" %>>Taproom</option>
          </select>
        </label>
      </form>
    </div>

    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <% [
        ["Visits", metricValue(analyticsSummary?.visits)],
        ["Pageviews", metricValue(analyticsSummary?.pageviews)],
        ["Visitors", metricValue(analyticsSummary?.visitors)],
        ["Avg Visit Length", analyticsSummary?.averageVisitLengthSeconds === null || analyticsSummary?.averageVisitLengthSeconds === undefined ? "Pending" : `${analyticsSummary.averageVisitLengthSeconds}s`],
        ["Bounce Rate", analyticsSummary?.bounceRate === null || analyticsSummary?.bounceRate === undefined ? "Pending" : `${analyticsSummary.bounceRate}%`],
        ["Retention", analyticsSummary?.bounceRate === null || analyticsSummary?.bounceRate === undefined ? "Pending" : `${Math.max(0, 100 - analyticsSummary.bounceRate)}%`],
      ].forEach((metric) => { %>
        <div class="rounded-md border border-slate-200 p-4 dark:border-white/10">
          <p class="text-xs font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400"><%= metric[0] %></p>
          <p class="mt-2 text-lg font-black tracking-normal text-slate-950 dark:text-white"><%= metric[1] %></p>
        </div>
      <% }) %>
    </div>

    <% if (analyticsSummary?.topContent?.length) { %>
      <div class="mt-5 rounded-md border border-slate-200 p-4 dark:border-white/10">
        <h3 class="text-sm font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Top content</h3>
        <div class="mt-3 grid gap-2">
          <% analyticsSummary.topContent.forEach((item) => { %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="truncate font-bold text-slate-800 dark:text-slate-100"><%= item.path %></span>
              <span class="shrink-0 font-black text-draft-amber dark:text-draft-gold"><%= item.visitors.toLocaleString() %></span>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

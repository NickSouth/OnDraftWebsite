<div class="article-actions" id="article-actions">
  <% const articleLiked = article.likedByUserIds.includes(likeActorId); %>
  <button
    type="button"
    class="icon-button <%= articleLiked ? "is-liked" : "" %>"
    aria-label="<%= articleLiked ? "Unlike article" : "Like article" %>"
    aria-pressed="<%= articleLiked ? "true" : "false" %>"
    hx-post="/articles/<%= article.id %>/like"
    hx-target="#article-actions"
    hx-swap="outerHTML"
  >
    <span aria-hidden="true"><%- articleLiked ? "&hearts;" : "&#9825;" %></span>
    <span><%= article.likes %></span>
  </button>
  <a class="icon-link" href="#article-comments-section" aria-label="Jump to comments">
    <svg class="article-action-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6.5 17.5h-.8A3.2 3.2 0 0 1 2.5 14.3V7.7a3.2 3.2 0 0 1 3.2-3.2h12.6a3.2 3.2 0 0 1 3.2 3.2v6.6a3.2 3.2 0 0 1-3.2 3.2h-5.7L7.2 21v-3.5h-.7z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    </svg>
    <span><%= article.comments.length %></span>
  </a>
  <button
    type="button"
    class="icon-button article-share-button"
    aria-label="Share article"
    data-share-title="<%= article.title %>"
    data-share-url="/articles/<%= article.id %>"
  >
    <svg class="article-action-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M14 5l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M20 11H9.5A5.5 5.5 0 0 0 4 16.5V19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <% if (session.authenticatedUser) { %>
    <%- include("bookmarkButton", { bookmark: { type: "article", articleId: article.id }, bookmarked: articleBookmarked }) %>
  <% } %>
</div>

<section
  class="od-card p-5"
  x-data="{ formOpen: <%= Boolean(errorMessage || (typeof values !== "undefined" && values && values.id)) ? "true" : "false" %> }"
>
  <%
    const formValues = typeof values !== "undefined" ? values : {};
    const selectedArticleIds = new Set(Array.isArray(formValues.articleIds) ? formValues.articleIds : []);
    const selectedVideoIds = new Set(Array.isArray(formValues.videoIds) ? formValues.videoIds : []);
    const newsletterDate = formValues.date instanceof Date && !isNaN(formValues.date.getTime())
      ? formValues.date.toISOString().slice(0, 10)
      : "";
  %>
  <div class="mb-5 flex flex-col gap-3 border-b border-slate-200 pb-5 dark:border-white/10 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Newsletter</p>
      <h2 class="mt-1 text-2xl font-black tracking-normal text-slate-950 dark:text-white">Newsletter Desk</h2>
      <p class="mt-2 max-w-2xl text-sm font-semibold text-slate-600 dark:text-slate-300">Draft, save, and send OnDraft updates through Resend.</p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row">
      <button type="button" class="od-primary-link w-full sm:w-fit" @click="formOpen = !formOpen">Build newsletter</button>
      <a class="od-secondary-link w-full sm:w-fit" href="/admin/mailing-list/subscribers.csv">Subscriber CSV</a>
    </div>
  </div>

  <% if (flashMessage) { %>
    <p class="mb-4 rounded-md border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800 dark:border-emerald-400/40 dark:bg-emerald-950/30 dark:text-emerald-100"><%= flashMessage %></p>
  <% } %>
  <% if (errorMessage) { %>
    <p class="od-admin-error mb-4" role="alert"><%= errorMessage %></p>
  <% } %>

  <form
    x-show="formOpen"
    x-collapse
    class="ondraft-form od-admin-form mb-6 grid gap-5 border-b border-slate-200 pb-6 dark:border-white/10"
    method="post"
    action="/admin/newsletters/drafts"
    hx-post="/admin/newsletters/drafts"
    hx-target="#admin-dashboard-panel"
    hx-swap="innerHTML"
  >
    <% if (formValues.id) { %>
      <input type="hidden" name="id" value="<%= formValues.id %>" />
    <% } %>
    <div class="grid gap-4 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <label>
        Date
        <input type="date" name="date" value="<%= newsletterDate %>" />
      </label>

      <label>
        Writeup
        <textarea name="writeup" rows="5" placeholder="Main newsletter writeup"><%= formValues.writeup || "" %></textarea>
      </label>
    </div>

    <div class="grid gap-4 lg:grid-cols-2">
      <details class="rounded-md border border-slate-300 bg-white dark:border-white/15 dark:bg-draft-ink">
        <summary class="cursor-pointer rounded-md px-4 py-3 text-sm font-black text-slate-800 marker:text-draft-amber dark:text-slate-100">
          Link Articles <span class="ml-2 text-xs font-bold text-slate-500 dark:text-slate-400"><%= selectedArticleIds.size %> selected</span>
        </summary>
        <div class="max-h-72 overflow-y-auto border-t border-slate-200 p-2 dark:border-white/10">
          <% articles.forEach((article) => { %>
            <label class="grid cursor-pointer grid-cols-[1rem_minmax(0,1fr)] gap-3 rounded px-2 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10">
              <input class="mt-1 size-4" type="checkbox" name="articleIds" value="<%= article.id %>" <%= selectedArticleIds.has(article.id) ? "checked" : "" %> />
              <span>
                <span class="block truncate font-bold"><%= article.title %></span>
                <span class="block text-xs text-slate-500 dark:text-slate-400"><%= new Date(article.publicationDate).toLocaleDateString() %></span>
              </span>
            </label>
          <% }) %>
        </div>
      </details>

      <details class="rounded-md border border-slate-300 bg-white dark:border-white/15 dark:bg-draft-ink">
        <summary class="cursor-pointer rounded-md px-4 py-3 text-sm font-black text-slate-800 marker:text-draft-amber dark:text-slate-100">
          Link Videos <span class="ml-2 text-xs font-bold text-slate-500 dark:text-slate-400"><%= selectedVideoIds.size %> selected</span>
        </summary>
        <div class="max-h-72 overflow-y-auto border-t border-slate-200 p-2 dark:border-white/10">
          <% videos.forEach((video) => { %>
            <label class="grid cursor-pointer grid-cols-[1rem_minmax(0,1fr)] gap-3 rounded px-2 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10">
              <input class="mt-1 size-4" type="checkbox" name="videoIds" value="<%= video.videoId %>" <%= selectedVideoIds.has(video.videoId) ? "checked" : "" %> />
              <span>
                <span class="block truncate font-bold"><%= video.title %></span>
                <span class="block text-xs text-slate-500 dark:text-slate-400"><%= new Date(video.createdAt).toLocaleDateString() %></span>
              </span>
            </label>
          <% }) %>
        </div>
      </details>
    </div>

    <label>
      Changelog
      <textarea name="changelog" rows="4" placeholder="Site updates, fixes, and new features"><%= formValues.changelog || "" %></textarea>
    </label>

    <div class="od-admin-actions">
      <button type="submit" onclick="this.form.action='/admin/newsletters/drafts'; this.form.setAttribute('hx-post', '/admin/newsletters/drafts');">Save draft</button>
      <button
        type="submit"
        class="secondary-button"
        formaction="/admin/newsletters/send"
        onclick="this.form.action='/admin/newsletters/send'; this.form.setAttribute('hx-post', '/admin/newsletters/send');"
      >Send newsletter</button>
    </div>
  </form>

  <div>
    <h3 class="text-sm font-black uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">Past newsletters</h3>
    <% if (newsletters.length > 0) { %>
      <div class="mt-3 grid gap-2">
        <% newsletters.forEach((newsletter) => { %>
          <div class="grid gap-3 rounded-md border border-slate-200 px-4 py-3 text-sm dark:border-white/10 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
            <div>
              <p class="font-black text-slate-900 dark:text-white"><%= new Date(newsletter.date).toLocaleDateString() %></p>
              <p class="mt-1 font-semibold text-slate-600 dark:text-slate-300">
                <%= newsletter.status === "sent" ? `Sent to ${newsletter.recipientCount}` : "Draft" %>
              </p>
            </div>
            <% if (newsletter.status === "sent") { %>
              <span class="inline-flex min-h-10 items-center justify-center gap-2 rounded-md border border-emerald-300 bg-emerald-50 px-3 text-sm font-black text-emerald-800 dark:border-emerald-400/40 dark:bg-emerald-950/30 dark:text-emerald-100" title="Sent">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                Sent
              </span>
            <% } else { %>
              <button
                type="button"
                class="secondary-button"
                hx-get="/admin/newsletters/<%= newsletter.id %>/edit"
                hx-target="#admin-dashboard-panel"
                hx-swap="innerHTML"
              >Edit</button>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="mt-3 rounded-md border border-slate-200 px-4 py-3 text-sm font-semibold text-slate-600 dark:border-white/10 dark:text-slate-300">No newsletters yet.</p>
    <% } %>
  </div>
</section>

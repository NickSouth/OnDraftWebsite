<div id="popular-articles-panel" class="grid gap-4" x-data="{ popularRange: '<%= popularRange %>' }">
  <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="mb-2 text-xs font-black uppercase tracking-[0.14em] text-draft-amber dark:text-draft-gold">Most Popular</p>
      <h2 class="text-3xl font-black tracking-normal text-slate-950 dark:text-white">Crowd favorites</h2>
    </div>
    <div class="od-range-toggle-group grid w-full grid-cols-3 rounded-md border border-slate-200 bg-white p-1 shadow-sm dark:border-white/10 dark:bg-draft-slate sm:w-auto" style="--od-toggle-count: 3;" aria-label="Crowd favorites range">
      <button
        type="button"
        class="od-range-toggle <%= popularRange === "month" ? "is-active" : "" %>"
        :class="{ 'is-active': popularRange === 'month' }"
        :aria-pressed="String(popularRange === 'month')"
        hx-get="/articles/popular?range=month"
        hx-target="#popular-articles-results"
        hx-swap="innerHTML"
        data-skip-global-loader
        data-loading-skeleton="popular-articles"
        data-loading-skeleton-target="#popular-articles-results"
        @click="popularRange = 'month'"
      >
        Last month
      </button>
      <button
        type="button"
        class="od-range-toggle <%= popularRange === "year" ? "is-active" : "" %>"
        :class="{ 'is-active': popularRange === 'year' }"
        :aria-pressed="String(popularRange === 'year')"
        hx-get="/articles/popular?range=year"
        hx-target="#popular-articles-results"
        hx-swap="innerHTML"
        data-skip-global-loader
        data-loading-skeleton="popular-articles"
        data-loading-skeleton-target="#popular-articles-results"
        @click="popularRange = 'year'"
      >
        Last year
      </button>
      <button
        type="button"
        class="od-range-toggle <%= popularRange === "all" ? "is-active" : "" %>"
        :class="{ 'is-active': popularRange === 'all' }"
        :aria-pressed="String(popularRange === 'all')"
        hx-get="/articles/popular?range=all"
        hx-target="#popular-articles-results"
        hx-swap="innerHTML"
        data-skip-global-loader
        data-loading-skeleton="popular-articles"
        data-loading-skeleton-target="#popular-articles-results"
        @click="popularRange = 'all'"
      >
        All time
      </button>
    </div>
  </div>
  <%- include("popularArticlesResults", { popularArticles }) %>
</div>

<div id="hot-take-list" class="hot-take-list">
  <% const usersById = typeof userDirectoryById !== "undefined" ? userDirectoryById : new Map(); %>
  <% const moderationById = typeof userModerationById !== "undefined" ? userModerationById : new Map(); %>
  <% const currentActiveBan = typeof activeUserBan !== "undefined" ? activeUserBan : null; %>
  <% const anyHotTakesExist = typeof hasAnyHotTakes !== "undefined" ? hasAnyHotTakes : posts.length > 0; %>
  <% const currentHasFilters = typeof hasFilters !== "undefined" ? hasFilters : false; %>
  <% const currentCanCreateHotTake = typeof canCreateHotTake !== "undefined" ? canCreateHotTake : Boolean(session.authenticatedUser?.emailVerifiedAt && !currentActiveBan); %>
  <% const formatRelative = typeof relativeTime === "function" ? relativeTime : (value) => new Date(value).toLocaleString(); %>
  <% if (errorMessage) { %>
    <p class="error-message"><%= errorMessage %></p>
  <% } %>

  <% if (posts.length === 0) { %>
    <div class="od-empty-state">
      <div>
        <% if (!anyHotTakesExist) { %>
          <p class="od-empty-state-kicker">The Taproom is quiet</p>
          <p class="od-empty-state-title">Be the first to share a hot take.</p>
          <p class="od-empty-state-copy">Start the conversation with a thought on the latest NFL or NFL Draft news.</p>
          <% if (currentCanCreateHotTake) { %>
            <div class="od-empty-state-actions">
              <button
                type="button"
                class="od-primary-link"
                @click="composerOpen = true; $nextTick(() => $refs.hotTakeContent?.focus())"
              >
                Create hot take
              </button>
            </div>
          <% } %>
        <% } else { %>
          <p class="od-empty-state-kicker">No hot takes found</p>
          <p class="od-empty-state-title">No hot takes match that search.</p>
          <p class="od-empty-state-copy">Try a wider search or clear the search field.</p>
          <% if (currentHasFilters) { %>
            <div class="od-empty-state-actions">
              <button
                type="button"
                class="od-secondary-link"
                onclick="const form = document.getElementById('hot-take-filter-form'); if (!form) return; const input = form.querySelector('[name=keyword]'); if (input) { input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true })); } htmx.trigger(form, 'submit');"
              >
                Clear search
              </button>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <ol class="comment-list">
      <% posts.forEach((post) => { %>
        <% const postUser = usersById.get(post.userId); %>
        <li id="hot-take-<%= post.id %>" class="comment-item hot-take-item" x-data="{ commentsOpen: false }">
          <div class="comment-header">
            <div>
              <%- include("profileAuthorLink", { name: post.userName, showBadge: postUser?.role === "admin", className: `verified-name font-bold no-underline ${post.userId === session.authenticatedUser?.userId ? "owner-name" : ""}` }) %>
              <span class="muted-text posted-time"><%= formatRelative(post.createdAt) %></span>
            </div>
            <div class="comment-admin-actions">
              <% const postModeratedUser = moderationById.get(post.userId); %>
              <% if (isAdmin && postModeratedUser) { %>
                <%- include("../../auth/partials/userModerationActions", { user: postModeratedUser, contextId: `hot-take-${post.id}`, errorMessage: null }) %>
              <% } %>
              <% if (isAdmin || post.userId === session.authenticatedUser?.userId) { %>
                <button
                  type="button"
                  class="secondary-button"
                  hx-delete="/hottakes/<%= post.id %>"
                  hx-confirm="Delete this hot take?"
                  hx-target="#hot-take-<%= post.id %>"
                  hx-swap="outerHTML"
                >
                  Delete
                </button>
              <% } %>
            </div>
          </div>
          <p class="hot-take-content"><%= post.content %></p>
          <div class="comment-actions">
            <%- include("hotTakeActions", { post, session, likeActorId, postBookmarked: bookmarkedForumPostIds.includes(post.id) }) %>
            <%- include("reportLink", { type: "hot take", id: `hot-take-${post.id}`, path: "/hottakes" }) %>
          </div>
          <div id="hot-take-comment-panel-<%= post.id %>" x-show="commentsOpen" x-collapse x-cloak>
            <%- include("hotTakeComments", { post, session, isAdmin, userDirectoryById: usersById, userModerationById: moderationById, activeUserBan: currentActiveBan, errorMessage: null }) %>
          </div>
        </li>
      <% }) %>
    </ol>
  <% } %>
</div>

<div id="hot-take-list" class="hot-take-list">
  <% const usersById = typeof userDirectoryById !== "undefined" ? userDirectoryById : new Map(); %>
  <% const moderationById = typeof userModerationById !== "undefined" ? userModerationById : new Map(); %>
  <% const currentActiveBan = typeof activeUserBan !== "undefined" ? activeUserBan : null; %>
  <% const formatRelative = typeof relativeTime === "function" ? relativeTime : (value) => new Date(value).toLocaleString(); %>
  <% if (errorMessage) { %>
    <p class="error-message"><%= errorMessage %></p>
  <% } %>

  <% if (posts.length === 0) { %>
    <p class="muted-text">No hot takes yet.</p>
  <% } else { %>
    <ol class="comment-list">
      <% posts.forEach((post) => { %>
        <% const postUser = usersById.get(post.userId); %>
        <li id="hot-take-<%= post.id %>" class="comment-item hot-take-item" x-data="{ commentsOpen: false }">
          <div class="comment-header">
            <div>
              <%- include("profileAuthorLink", { name: post.userName, showBadge: postUser?.role === "admin", className: `verified-name font-bold no-underline ${post.userId === session.authenticatedUser?.userId ? "owner-name" : ""}` }) %>
              <span class="muted-text posted-time"><%= formatRelative(post.createdAt) %></span>
            </div>
            <div class="comment-admin-actions">
              <% const postModeratedUser = moderationById.get(post.userId); %>
              <% if (isAdmin && postModeratedUser) { %>
                <%- include("../../auth/partials/userModerationActions", { user: postModeratedUser, contextId: `hot-take-${post.id}`, errorMessage: null }) %>
              <% } %>
              <% if (isAdmin || post.userId === session.authenticatedUser?.userId) { %>
                <button
                  type="button"
                  class="secondary-button"
                  hx-delete="/hottakes/<%= post.id %>"
                  hx-confirm="Delete this hot take?"
                  hx-target="#hot-take-<%= post.id %>"
                  hx-swap="outerHTML"
                >
                  Delete
                </button>
              <% } %>
            </div>
          </div>
          <p class="hot-take-content"><%= post.content %></p>
          <%- include("hotTakeActions", { post, session, likeActorId, postBookmarked: bookmarkedForumPostIds.includes(post.id) }) %>
          <div id="hot-take-comment-panel-<%= post.id %>" x-show="commentsOpen" x-collapse x-cloak>
            <%- include("hotTakeComments", { post, session, isAdmin, userDirectoryById: usersById, userModerationById: moderationById, activeUserBan: currentActiveBan, errorMessage: null }) %>
          </div>
        </li>
      <% }) %>
    </ol>
  <% } %>
</div>

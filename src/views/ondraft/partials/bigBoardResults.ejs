<div
  id="big-board-results"
  class="big-board-results od-swap-surface od-swap-active"
  x-data="{
    boardView: window.matchMedia('(max-width: 639px)').matches ? 'list' : 'card',
    gradeGuideOpen: false,
    gradeGuidePosition: '<%= typeof positions !== "undefined" && positions.length > 0 ? positions[0] : "QB" %>',
    get storageKey() {
      return window.matchMedia('(max-width: 639px)').matches ? 'bigBoardMobileView' : 'bigBoardView';
    },
    init() {
      const savedView = window.localStorage.getItem(this.storageKey);
      if (savedView === 'card' || savedView === 'list') {
        this.boardView = savedView;
      }
    },
    setBoardView(view) {
      this.boardView = view;
      window.localStorage.setItem(this.storageKey, view);
    }
  }"
>
  <%
    const formatBoardNumber = (value) => {
      if (typeof value !== "number") {
        return "";
      }
      return Number.isInteger(value) ? value.toString() : value.toFixed(1);
    };
    const formatHeightInches = (value) => {
      if (typeof value !== "number") {
        return "";
      }
      const whole = Math.floor(value);
      const fractional = value - whole;
      const eighths = Math.round(fractional * 8);
      const fractions = {
        1: " 1/8",
        2: " 1/4",
        3: " 3/8",
        4: " 1/2",
        5: " 5/8",
        6: " 3/4",
        7: " 7/8",
      };
      if (eighths === 0) {
        return whole.toString();
      }
      if (eighths === 8) {
        return (whole + 1).toString();
      }
      return `${whole}${fractions[eighths] ?? ""}`;
    };
    const formatHeightLabel = (height) => height ? `${height.feet}'${formatHeightInches(height.inches)}"` : "Height TBD";
    const hasText = (value) => typeof value === "string" && value.trim().length > 0;
    const selectedBoard = typeof board !== "undefined" ? board : null;
    const creatorAuthors = {
      Ryan: ["Ryan McWalter"],
      Aleks: ["Aleks Ryabinkin"],
      Consensus: ["Ryan McWalter", "Aleks Ryabinkin"],
    };
    const bylineAuthors = selectedBoard ? creatorAuthors[selectedBoard.creator] ?? [] : [];
    const isConsensusBoard = selectedBoard?.creator === "Consensus";
    const gradeGuidePositions = (typeof positions !== "undefined" ? positions : [])
      .map((position) => typeof draftGradePositionConfig === "function" ? draftGradePositionConfig(position) : null)
      .filter(Boolean);
    const consensusSourceRanks = (entry) => [
      ["Ryan", entry.consensusRankingContext?.Ryan?.rank],
      ["Aleks", entry.consensusRankingContext?.Aleks?.rank],
    ].filter((sourceRank) => typeof sourceRank[1] === "number");
  %>
  <% if (bigBoard.length === 0) { %>
    <div class="od-card grid min-h-48 place-items-center p-8 text-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.18em] text-draft-amber dark:text-draft-gold">Empty board</p>
        <p class="mt-2 font-display text-2xl font-bold text-slate-950 dark:text-white">No draft board entries have been created yet.</p>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Try a different year, creator, position, or school.</p>
      </div>
    </div>
  <% } else { %>
    <div class="mb-2 flex flex-row items-center justify-between gap-2 sm:mb-3 sm:gap-3">
      <% if (bylineAuthors.length > 0) { %>
        <div class="grid min-w-0 gap-0.5 sm:gap-1">
          <p class="m-0 text-xs font-bold leading-tight text-slate-700 dark:text-slate-200 sm:line-clamp-1 sm:text-sm">
            Player analysis and opinions by
            <% bylineAuthors.forEach((author, index) => { %>
              <%- include("profileAuthorLink", { name: author, showBadge: false, className: "text-draft-amber no-underline transition hover:text-draft-gold dark:text-draft-gold" }) %><%= index < bylineAuthors.length - 1 ? "/" : "" %>
            <% }) %>
          </p>
          <button
            type="button"
            class="w-fit text-left text-[0.68rem] font-black uppercase tracking-[0.1em] text-draft-amber underline decoration-draft-gold/40 underline-offset-4 transition hover:text-draft-gold hover:decoration-draft-gold dark:text-draft-gold sm:text-xs sm:tracking-[0.14em]"
            @click="gradeGuideOpen = true"
          >
            How we grade players
          </button>
        </div>
      <% } else { %>
        <span aria-hidden="true"></span>
      <% } %>
      <div class="od-view-toggle-group shrink-0 shadow-sm" aria-label="Draft board view">
        <button
          type="button"
          class="od-view-toggle size-8 sm:size-10"
          :class="boardView === 'card' ? 'is-active' : 'text-slate-500 dark:text-slate-300'"
          :aria-pressed="boardView === 'card'"
          aria-label="Card view"
          title="Card view"
          @click="setBoardView('card')"
        >
          <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="4" y="5" width="16" height="4" rx="1" />
            <rect x="4" y="10" width="16" height="4" rx="1" />
            <rect x="4" y="15" width="16" height="4" rx="1" />
          </svg>
        </button>
        <button
          type="button"
          class="od-view-toggle size-8 sm:size-10"
          :class="boardView === 'list' ? 'is-active' : 'text-slate-500 dark:text-slate-300'"
          :aria-pressed="boardView === 'list'"
          aria-label="List view"
          title="List view"
          @click="setBoardView('list')"
        >
          <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M7 6h14" />
            <path d="M7 12h14" />
            <path d="M7 18h14" />
            <path d="M4 6h.01" />
            <path d="M4 12h.01" />
            <path d="M4 18h.01" />
          </svg>
        </button>
      </div>
    </div>

    <ol class="ranking-list grid list-none p-0" x-show="boardView === 'card'" x-transition.opacity.duration.180ms>
      <% bigBoard.forEach((entry) => { %>
        <%
          const rankLabel = formatBoardNumber(entry.rank) || "NR";
          const positionLabel = entry.position || "POS";
          const posRankLabel = entry.posRank ? `${positionLabel}${formatBoardNumber(entry.posRank)}` : positionLabel;
          const heightLabel = formatHeightLabel(entry.height);
          const weightLabel = entry.weight ? `${entry.weight} lbs` : "Weight TBD";
          const accessibleSummary = `${rankLabel}. ${entry.playerName} ${posRankLabel}`;
          const teamColors = typeof collegeTeamColors !== "undefined" ? collegeTeamColors[entry.school] : undefined;
          const helmetPrimaryColor = teamColors?.primaryColor || "#111111";
          const helmetSecondaryColor = teamColors?.secondaryColor || "#F8FAFC";
          const helmetKey = typeof helmetColorKey !== "undefined" ? helmetColorKey(helmetPrimaryColor, helmetSecondaryColor) : null;
          const generatedHelmetSrc = helmetKey ? `/generated/helmets/v1/${helmetKey}.png` : "/teamHelmetTemplate.png";
          const boardGradeValue = typeof publishedBoardGrade === "function" ? publishedBoardGrade(entry) : null;
          const boardGradeLabel = typeof formatDraftBoardGrade === "function" ? formatDraftBoardGrade(boardGradeValue) : "-/8";
          const hasPublishedGrade = boardGradeValue !== null;
          const gradeValueLabel = entry.gradePublished && hasText(entry.grade?.value) ? entry.grade.value.trim() : "";
          const hasPublishedGradeValue = gradeValueLabel.length > 0;
          const hasPublishedDetails = !isConsensusBoard && (entry.writeupPublished || hasPublishedGrade);
          const publishedDiscrepancy = entry.discWriteup?.published && hasText(entry.discWriteup.ryanWriteup) && hasText(entry.discWriteup.aleksWriteup);
          const hasConsensusDisclosure = isConsensusBoard && entry.bigDiscrepency && (isAdmin || publishedDiscrepancy);
          const sourceRanks = isConsensusBoard ? consensusSourceRanks(entry) : [];
        %>
        <li class="border-b border-slate-200 py-3 last:border-b-0 dark:border-white/10">
          <% if (hasPublishedDetails || hasConsensusDisclosure) { %>
            <details class="group">
              <summary class="od-focus-ring relative grid cursor-pointer list-none grid-cols-[3.25rem_minmax(0,1fr)] items-start gap-x-2 gap-y-2 overflow-hidden rounded-md p-2 transition hover:bg-white/70 dark:hover:bg-white/[0.04] sm:min-h-32 sm:grid-cols-[4.5rem_7.5rem_minmax(0,1fr)] sm:items-center sm:gap-3 sm:pb-11 [&::-webkit-details-marker]:hidden">
                <span class="pointer-events-none absolute inset-y-0 right-0 left-[31rem] hidden bg-slate-200/55 [clip-path:polygon(3rem_0,100%_0,100%_100%,0_100%)] dark:bg-white/[0.06] lg:block" aria-hidden="true"></span>
                <span class="sr-only"><%= accessibleSummary %></span>
                <span class="relative z-10 flex items-center justify-center gap-2 sm:justify-start">
                  <span class="w-auto font-display text-2xl font-black leading-none text-draft-amber dark:text-draft-gold sm:w-auto sm:text-5xl"><%= rankLabel %></span>
                  <span class="hidden h-9 w-px bg-slate-300 dark:bg-white/20 sm:block sm:h-14" aria-hidden="true"></span>
                </span>
                <span class="relative z-10 col-start-1 row-start-2 grid justify-items-center text-center sm:col-start-auto sm:row-start-auto">
                  <img
                    class="h-10 w-12 shrink-0 object-contain opacity-0 transition-opacity duration-150 sm:h-28 sm:w-32"
                    src="/teamHelmetTemplate.png"
                    alt="<%= entry.school %> football helmet"
                    loading="lazy"
                    decoding="async"
                    data-team-helmet
                    data-generated-helmet-src="<%= generatedHelmetSrc %>"
                  />
                </span>
                <span class="relative z-10 col-start-2 row-span-2 row-start-1 grid gap-1.5 sm:col-start-auto sm:row-span-1 sm:row-start-auto sm:gap-3">
                  <span class="grid gap-1.5 sm:gap-3 lg:grid-cols-[minmax(0,18rem)_minmax(12rem,1fr)] lg:items-start">
                    <span>
                      <span class="block font-display text-[1.12rem] font-black leading-tight text-slate-950 dark:text-white sm:text-3xl"><%= entry.playerName %></span>
                      <span class="mt-1 flex flex-wrap items-center gap-1.5 sm:mt-2 sm:gap-2">
                        <span class="inline-flex rounded bg-draft-gold px-1.5 py-0.5 text-[0.68rem] font-black uppercase tracking-wide text-draft-ink sm:px-3 sm:py-1 sm:text-sm"><%= posRankLabel %></span>
                        <span class="text-xs font-black leading-tight text-slate-500 dark:text-slate-300 sm:text-sm"><%= entry.school %></span>
                      </span>
                    </span>
                    <span class="flex flex-wrap items-start gap-1 pt-0.5 text-slate-500 dark:text-slate-300 sm:gap-2 sm:pt-1 lg:justify-end">
                      <% if (sourceRanks.length > 0) { %>
                        <span class="consensus-source-ranks">
                          <% if (entry.bigDiscrepency && isConsensusBoard) { %>
                            <span class="consensus-discrepancy-flag">Big discrepancy</span>
                          <% } %>
                          <span class="consensus-source-ranks-line">
                            <% sourceRanks.forEach(([creator, sourceRank]) => { %>
                              <span><%= creator %>'s Rank: <strong><%= formatBoardNumber(sourceRank) %></strong></span>
                            <% }) %>
                          </span>
                        </span>
                      <% } %>
                      <% if (hasPublishedGrade) { %>
                        <span class="grid min-h-11 min-w-20 place-content-center gap-0.5 rounded-md border border-draft-gold/50 bg-white px-2.5 py-2 text-center shadow-sm ring-1 ring-draft-gold/35 dark:bg-draft-ink sm:min-h-16 sm:min-w-32 sm:gap-1 sm:px-4 sm:py-3">
                          <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Grade</span>
                          <span class="font-display text-base font-black leading-none text-draft-amber dark:text-draft-gold sm:text-xl"><%= boardGradeLabel %></span>
                          <% if (hasPublishedGradeValue) { %>
                            <span class="max-w-28 truncate text-[0.62rem] font-bold normal-case leading-tight text-slate-500 dark:text-slate-300 sm:max-w-32 sm:text-[0.68rem]"><%= gradeValueLabel %></span>
                          <% } %>
                        </span>
                      <% } %>
                      <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                        <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Height</span>
                        <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= heightLabel %></span>
                      </span>
                      <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                        <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Weight</span>
                        <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= weightLabel %></span>
                      </span>
                    </span>
                  </span>
                </span>
                <span class="relative z-10 col-span-2 flex justify-center sm:absolute sm:bottom-3 sm:left-1/2 sm:col-span-1 sm:-translate-x-1/2">
                  <% if (isConsensusBoard) { %>
                    <% if (entry.bigDiscrepency) { %>
                      <%- include("consensusDiscrepancyControls", { board, entry, isAdmin, variant: "card" }) %>
                    <% } %>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-draft-gold/50 bg-white/90 px-2.5 py-1 text-[0.68rem] font-black uppercase tracking-[0.08em] text-draft-amber shadow-sm transition group-open:bg-draft-gold group-open:text-draft-ink dark:bg-draft-ink/95 dark:text-draft-gold dark:group-open:bg-draft-gold dark:group-open:text-draft-ink sm:gap-2 sm:px-3 sm:py-1.5 sm:text-xs sm:tracking-[0.12em]">
                      <svg class="size-3.5 transition group-open:rotate-180 sm:size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                      </svg>
                      <span class="sm:hidden">Profile</span>
                      <span class="hidden sm:inline">read player profile</span>
                    </span>
                  <% } %>
                </span>
              </summary>
              <div class="big-board-profile-panel">
                <% if (isConsensusBoard) { %>
                  <%- include("consensusDiscrepancyWriteup", { board, entry, isAdmin, statusMessage: null, errorMessage: null, validationFields: [], forceOpen: false }) %>
                <% } else { %>
                  <%- include("bigBoardWriteupPanel", { entry, hasText, publishedBoardGrade, formatDraftBoardGrade, gradeTraitCategoriesForGrade, abbreviateDraftGradeTrait }) %>
                <% } %>
              </div>
            </details>
          <% } else { %>
            <div class="relative grid grid-cols-[3.25rem_minmax(0,1fr)] items-start gap-x-2 gap-y-2 overflow-hidden rounded-md p-2 sm:min-h-32 sm:grid-cols-[4.5rem_7.5rem_minmax(0,1fr)] sm:items-center sm:gap-3">
              <span class="pointer-events-none absolute inset-y-0 right-0 left-[31rem] hidden bg-slate-200/55 [clip-path:polygon(3rem_0,100%_0,100%_100%,0_100%)] dark:bg-white/[0.06] lg:block" aria-hidden="true"></span>
              <span class="sr-only"><%= accessibleSummary %></span>
              <span class="relative z-10 flex items-center justify-center gap-2 sm:justify-start">
                <span class="w-auto font-display text-2xl font-black leading-none text-draft-amber dark:text-draft-gold sm:w-auto sm:text-5xl"><%= rankLabel %></span>
                <span class="hidden h-9 w-px bg-slate-300 dark:bg-white/20 sm:block sm:h-14" aria-hidden="true"></span>
              </span>
              <span class="relative z-10 col-start-1 row-start-2 grid justify-items-center text-center sm:col-start-auto sm:row-start-auto">
                <img
                  class="h-10 w-12 shrink-0 object-contain opacity-0 transition-opacity duration-150 sm:h-28 sm:w-32"
                  src="/teamHelmetTemplate.png"
                  alt="<%= entry.school %> football helmet"
                  loading="lazy"
                  decoding="async"
                  data-team-helmet
                  data-generated-helmet-src="<%= generatedHelmetSrc %>"
                />
              </span>
              <div class="relative z-10 col-start-2 row-span-2 row-start-1 grid gap-1.5 sm:col-start-auto sm:row-span-1 sm:row-start-auto sm:gap-3">
                <div class="grid gap-1.5 sm:gap-3 lg:grid-cols-[minmax(0,18rem)_minmax(12rem,1fr)] lg:items-start">
                  <div>
                    <span class="block font-display text-[1.12rem] font-black leading-tight text-slate-950 dark:text-white sm:text-3xl"><%= entry.playerName %></span>
                    <span class="mt-1 flex flex-wrap items-center gap-1.5 sm:mt-2 sm:gap-2">
                      <span class="inline-flex rounded bg-draft-gold px-1.5 py-0.5 text-[0.68rem] font-black uppercase tracking-wide text-draft-ink sm:px-3 sm:py-1 sm:text-sm"><%= posRankLabel %></span>
                      <span class="text-xs font-black leading-tight text-slate-500 dark:text-slate-300 sm:text-sm"><%= entry.school %></span>
                    </span>
                  </div>
                  <div class="flex flex-wrap items-start gap-1 pt-0.5 text-slate-500 dark:text-slate-300 sm:gap-2 sm:pt-1 lg:justify-end">
                    <% if (sourceRanks.length > 0) { %>
                      <span class="consensus-source-ranks">
                        <% if (entry.bigDiscrepency && isConsensusBoard) { %>
                          <span class="consensus-discrepancy-flag">Big discrepancy</span>
                        <% } %>
                        <span class="consensus-source-ranks-line">
                          <% sourceRanks.forEach(([creator, sourceRank]) => { %>
                            <span><%= creator %>'s Rank: <strong><%= formatBoardNumber(sourceRank) %></strong></span>
                          <% }) %>
                        </span>
                      </span>
                    <% } %>
                    <% if (hasPublishedGrade) { %>
                      <span class="grid min-h-11 min-w-20 place-content-center gap-0.5 rounded-md border border-draft-gold/50 bg-white px-2.5 py-2 text-center shadow-sm ring-1 ring-draft-gold/35 dark:bg-draft-ink sm:min-h-16 sm:min-w-32 sm:gap-1 sm:px-4 sm:py-3">
                        <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Grade</span>
                        <span class="font-display text-base font-black leading-none text-draft-amber dark:text-draft-gold sm:text-xl"><%= boardGradeLabel %></span>
                        <% if (hasPublishedGradeValue) { %>
                          <span class="max-w-28 truncate text-[0.62rem] font-bold normal-case leading-tight text-slate-500 dark:text-slate-300 sm:max-w-32 sm:text-[0.68rem]"><%= gradeValueLabel %></span>
                        <% } %>
                      </span>
                    <% } %>
                    <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                      <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Height</span>
                      <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= heightLabel %></span>
                    </span>
                    <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                      <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Weight</span>
                      <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= weightLabel %></span>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ol>

    <ol class="grid list-none divide-y divide-slate-200 rounded-md border border-slate-200 bg-white p-0 dark:divide-white/10 dark:border-white/10 dark:bg-draft-slate" x-show="boardView === 'list'" x-transition.opacity.duration.180ms x-cloak>
      <% bigBoard.forEach((entry) => { %>
        <%
          const rankLabel = formatBoardNumber(entry.rank) || "NR";
          const positionLabel = entry.position || "POS";
          const posRankLabel = entry.posRank ? `${positionLabel}${formatBoardNumber(entry.posRank)}` : positionLabel;
          const heightLabel = formatHeightLabel(entry.height);
          const weightLabel = entry.weight ? `${entry.weight} lbs` : "Weight TBD";
          const accessibleSummary = `${rankLabel}. ${entry.playerName} ${posRankLabel}`;
          const teamColors = typeof collegeTeamColors !== "undefined" ? collegeTeamColors[entry.school] : undefined;
          const helmetPrimaryColor = teamColors?.primaryColor || "#111111";
          const helmetSecondaryColor = teamColors?.secondaryColor || "#F8FAFC";
          const helmetKey = typeof helmetColorKey !== "undefined" ? helmetColorKey(helmetPrimaryColor, helmetSecondaryColor) : null;
          const generatedHelmetSrc = helmetKey ? `/generated/helmets/v1/${helmetKey}.png` : "/teamHelmetTemplate.png";
          const boardGradeValue = typeof publishedBoardGrade === "function" ? publishedBoardGrade(entry) : null;
          const boardGradeLabel = typeof formatDraftBoardGrade === "function" ? formatDraftBoardGrade(boardGradeValue) : "-/8";
          const hasPublishedGrade = boardGradeValue !== null;
          const gradeValueLabel = entry.gradePublished && hasText(entry.grade?.value) ? entry.grade.value.trim() : "";
          const hasPublishedGradeValue = gradeValueLabel.length > 0;
          const hasPublishedDetails = !isConsensusBoard && (entry.writeupPublished || hasPublishedGrade);
          const publishedDiscrepancy = entry.discWriteup?.published && hasText(entry.discWriteup.ryanWriteup) && hasText(entry.discWriteup.aleksWriteup);
          const hasConsensusDisclosure = isConsensusBoard && entry.bigDiscrepency && (isAdmin || publishedDiscrepancy);
          const sourceRanks = isConsensusBoard ? consensusSourceRanks(entry) : [];
        %>
        <li>
          <% if (hasPublishedDetails || hasConsensusDisclosure) { %>
            <details class="group">
              <summary class="od-focus-ring grid cursor-pointer list-none grid-cols-[2.15rem_minmax(0,1fr)] gap-x-1.5 gap-y-1.5 px-2 py-2 transition hover:bg-slate-50 dark:hover:bg-white/[0.04] sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-center sm:gap-3 sm:px-3 sm:py-3 [&::-webkit-details-marker]:hidden">
                <span class="sr-only"><%= accessibleSummary %></span>
                <span class="flex items-center gap-2">
                  <span class="w-5 font-display text-lg font-black leading-none text-draft-amber dark:text-draft-gold sm:w-8 sm:text-2xl"><%= rankLabel %></span>
                  <span class="inline-grid size-4 place-items-center rounded border border-slate-300/70 text-slate-500 transition group-open:bg-draft-gold group-open:text-draft-ink dark:border-white/15 dark:text-slate-300 sm:size-6" aria-hidden="true">
                    <svg class="size-2.5 transition group-open:rotate-180 sm:size-3.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                    </svg>
                  </span>
                </span>
                <span class="grid min-w-0 gap-2 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:items-center">
                  <img
                    class="hidden h-14 w-16 shrink-0 object-contain opacity-0 transition-opacity duration-150 sm:block"
                    src="/teamHelmetTemplate.png"
                    alt="<%= entry.school %> football helmet"
                    loading="lazy"
                    decoding="async"
                    data-team-helmet
                    data-generated-helmet-src="<%= generatedHelmetSrc %>"
                  />
                  <span class="min-w-0">
                    <span class="block truncate font-display text-base font-black leading-tight text-slate-950 dark:text-white sm:text-xl"><%= entry.playerName %></span>
                    <span class="mt-0.5 flex min-w-0 flex-nowrap items-center gap-1 text-[0.7rem] font-bold leading-none text-slate-600 dark:text-slate-300 sm:mt-1 sm:flex-wrap sm:gap-x-2 sm:gap-y-1 sm:text-sm">
                      <span class="shrink-0 text-draft-amber dark:text-draft-gold"><%= posRankLabel %></span>
                      <span class="min-w-0 flex-1 truncate"><%= entry.school %></span>
                      <% if (sourceRanks.length > 0) { %>
                        <span class="inline-flex h-5 shrink-0 items-center rounded border border-slate-300/50 bg-draft-slate px-1 text-[0.55rem] font-black leading-none text-slate-300 dark:border-white/10 dark:bg-draft-ink sm:hidden">
                          <% sourceRanks.forEach(([creator, sourceRank], sourceIndex) => { %>
                            <span><%= creator.slice(0, 1) %> <%= formatBoardNumber(sourceRank) %></span><%- sourceIndex < sourceRanks.length - 1 ? "&nbsp;/&nbsp;" : "" %>
                          <% }) %>
                        </span>
                      <% } %>
                      <% if (hasPublishedGrade) { %>
                        <span class="inline-flex h-5 shrink-0 items-center rounded border border-draft-gold/50 px-1.5 font-display text-[0.72rem] font-black leading-none text-draft-amber dark:text-draft-gold sm:hidden"><%= boardGradeLabel %></span>
                      <% } %>
                      <span class="inline-flex h-5 shrink-0 items-center rounded border border-white/10 bg-draft-slate px-1 text-[0.62rem] font-black leading-none text-slate-300 dark:bg-draft-ink sm:hidden"><%= heightLabel %></span>
                      <span class="inline-flex h-5 shrink-0 items-center rounded border border-white/10 bg-draft-slate px-1 text-[0.62rem] font-black leading-none text-slate-300 dark:bg-draft-ink sm:hidden"><%= weightLabel %></span>
                    </span>
                  </span>
                </span>
                <span class="col-span-2 hidden flex-nowrap items-start gap-1.5 overflow-x-auto pb-0.5 sm:col-span-1 sm:flex sm:flex-wrap sm:gap-2 sm:overflow-visible sm:pb-0 sm:justify-end">
                  <% if (sourceRanks.length > 0) { %>
                    <span class="consensus-source-ranks">
                      <% if (entry.bigDiscrepency && isConsensusBoard) { %>
                        <span class="consensus-discrepancy-flag">Big discrepancy</span>
                      <% } %>
                      <span class="consensus-source-ranks-line">
                        <% sourceRanks.forEach(([creator, sourceRank]) => { %>
                          <span><%= creator %>'s Rank: <strong><%= formatBoardNumber(sourceRank) %></strong></span>
                        <% }) %>
                      </span>
                    </span>
                  <% } %>
                  <% if (hasPublishedGrade) { %>
                    <span class="grid min-h-10 min-w-20 place-content-center gap-0.5 rounded-md border border-draft-gold/50 bg-white px-2 py-1.5 text-center shadow-sm ring-1 ring-draft-gold/35 dark:bg-draft-ink sm:min-h-16 sm:min-w-32 sm:gap-1 sm:px-4 sm:py-3">
                      <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Grade</span>
                      <span class="font-display text-base font-black leading-none text-draft-amber dark:text-draft-gold sm:text-xl"><%= boardGradeLabel %></span>
                      <% if (hasPublishedGradeValue) { %>
                        <span class="hidden max-w-28 truncate text-[0.62rem] font-bold normal-case leading-tight text-slate-500 dark:text-slate-300 sm:block sm:max-w-32 sm:text-[0.68rem]"><%= gradeValueLabel %></span>
                      <% } %>
                    </span>
                  <% } %>
                  <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                    <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Height</span>
                    <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= heightLabel %></span>
                  </span>
                  <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                    <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Weight</span>
                    <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= weightLabel %></span>
                  </span>
                </span>
              </summary>
              <div class="big-board-profile-panel">
                <% if (isConsensusBoard) { %>
                  <%- include("consensusDiscrepancyWriteup", { board, entry, isAdmin, statusMessage: null, errorMessage: null, validationFields: [], forceOpen: false }) %>
                <% } else { %>
                  <%- include("bigBoardWriteupPanel", { entry, hasText, publishedBoardGrade, formatDraftBoardGrade, gradeTraitCategoriesForGrade, abbreviateDraftGradeTrait }) %>
                <% } %>
              </div>
            </details>
          <% } else { %>
            <div class="grid grid-cols-[2.15rem_minmax(0,1fr)] gap-x-1.5 gap-y-1.5 px-2 py-2 sm:grid-cols-[3rem_minmax(0,1fr)_auto] sm:items-center sm:gap-3 sm:px-3 sm:py-3">
              <span class="font-display text-lg font-black leading-none text-draft-amber dark:text-draft-gold sm:text-2xl"><%= rankLabel %></span>
              <span class="grid min-w-0 gap-2 sm:grid-cols-[4.5rem_minmax(0,1fr)] sm:items-center">
                <img
                  class="hidden h-14 w-16 shrink-0 object-contain opacity-0 transition-opacity duration-150 sm:block"
                  src="/teamHelmetTemplate.png"
                  alt="<%= entry.school %> football helmet"
                  loading="lazy"
                  decoding="async"
                  data-team-helmet
                  data-generated-helmet-src="<%= generatedHelmetSrc %>"
                />
                <span class="min-w-0">
                  <span class="block truncate font-display text-base font-black leading-tight text-slate-950 dark:text-white sm:text-xl"><%= entry.playerName %></span>
                  <span class="mt-0.5 flex min-w-0 flex-nowrap items-center gap-1 text-[0.7rem] font-bold leading-none text-slate-600 dark:text-slate-300 sm:mt-1 sm:flex-wrap sm:gap-x-2 sm:gap-y-1 sm:text-sm">
                    <span class="shrink-0 text-draft-amber dark:text-draft-gold"><%= posRankLabel %></span>
                    <span class="min-w-0 flex-1 truncate"><%= entry.school %></span>
                    <% if (sourceRanks.length > 0) { %>
                      <span class="inline-flex h-5 shrink-0 items-center rounded border border-slate-300/50 bg-draft-slate px-1 text-[0.55rem] font-black leading-none text-slate-300 dark:border-white/10 dark:bg-draft-ink sm:hidden">
                        <% sourceRanks.forEach(([creator, sourceRank], sourceIndex) => { %>
                          <span><%= creator.slice(0, 1) %> <%= formatBoardNumber(sourceRank) %></span><%- sourceIndex < sourceRanks.length - 1 ? "&nbsp;/&nbsp;" : "" %>
                        <% }) %>
                      </span>
                    <% } %>
                    <% if (hasPublishedGrade) { %>
                      <span class="inline-flex h-5 shrink-0 items-center rounded border border-draft-gold/50 px-1.5 font-display text-[0.72rem] font-black leading-none text-draft-amber dark:text-draft-gold sm:hidden"><%= boardGradeLabel %></span>
                    <% } %>
                    <span class="inline-flex h-5 shrink-0 items-center rounded border border-white/10 bg-draft-slate px-1 text-[0.62rem] font-black leading-none text-slate-300 dark:bg-draft-ink sm:hidden"><%= heightLabel %></span>
                    <span class="inline-flex h-5 shrink-0 items-center rounded border border-white/10 bg-draft-slate px-1 text-[0.62rem] font-black leading-none text-slate-300 dark:bg-draft-ink sm:hidden"><%= weightLabel %></span>
                  </span>
                </span>
              </span>
              <span class="col-span-2 hidden flex-nowrap items-start gap-1.5 overflow-x-auto pb-0.5 sm:col-span-1 sm:flex sm:flex-wrap sm:gap-2 sm:overflow-visible sm:pb-0 sm:justify-end">
                <% if (sourceRanks.length > 0) { %>
                  <span class="consensus-source-ranks">
                    <% if (entry.bigDiscrepency && isConsensusBoard) { %>
                      <span class="consensus-discrepancy-flag">Big discrepancy</span>
                    <% } %>
                    <span class="consensus-source-ranks-line">
                      <% sourceRanks.forEach(([creator, sourceRank]) => { %>
                        <span><%= creator %>'s Rank: <strong><%= formatBoardNumber(sourceRank) %></strong></span>
                      <% }) %>
                    </span>
                  </span>
                <% } %>
                <% if (hasPublishedGrade) { %>
                  <span class="grid min-h-10 min-w-20 place-content-center gap-0.5 rounded-md border border-draft-gold/50 bg-white px-2 py-1.5 text-center shadow-sm ring-1 ring-draft-gold/35 dark:bg-draft-ink sm:min-h-16 sm:min-w-32 sm:gap-1 sm:px-4 sm:py-3">
                    <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Grade</span>
                    <span class="font-display text-base font-black leading-none text-draft-amber dark:text-draft-gold sm:text-xl"><%= boardGradeLabel %></span>
                    <% if (hasPublishedGradeValue) { %>
                      <span class="hidden max-w-28 truncate text-[0.62rem] font-bold normal-case leading-tight text-slate-500 dark:text-slate-300 sm:block sm:max-w-32 sm:text-[0.68rem]"><%= gradeValueLabel %></span>
                    <% } %>
                  </span>
                <% } %>
                <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                  <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Height</span>
                  <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= heightLabel %></span>
                </span>
                <span class="grid min-w-16 gap-0.5 rounded bg-draft-slate px-2 py-1.5 text-center shadow-sm ring-1 ring-white/10 dark:bg-draft-ink sm:min-w-20 sm:px-3 sm:py-2">
                  <span class="text-[0.62rem] font-black uppercase tracking-wide text-slate-400 dark:text-slate-400">Weight</span>
                  <span class="text-xs font-black leading-none text-slate-500 dark:text-slate-300 sm:text-sm"><%= weightLabel %></span>
                </span>
              </span>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ol>
    <template x-teleport="body">
      <div
        class="fixed inset-0 z-[70] grid place-items-center bg-slate-950/70 p-2.5 backdrop-blur-sm sm:p-4"
        x-cloak
        x-show="gradeGuideOpen"
        x-transition.opacity.duration.150ms
        @keydown.escape.window="gradeGuideOpen = false"
        @click.self="gradeGuideOpen = false"
        role="presentation"
      >
      <section
        class="max-h-[90vh] w-full max-w-5xl overflow-y-auto rounded-lg border border-slate-200 bg-white text-slate-950 shadow-editorial dark:border-white/10 dark:bg-draft-slate dark:text-white sm:max-h-[88vh]"
        role="dialog"
        aria-modal="true"
        aria-labelledby="grade-guide-title"
        tabindex="-1"
        x-trap.noscroll="gradeGuideOpen"
      >
        <div class="sticky top-0 z-10 flex items-start justify-between gap-3 border-b border-slate-200 bg-white/95 p-3 backdrop-blur dark:border-white/10 dark:bg-draft-slate/95 sm:gap-4 sm:p-4">
          <div>
            <p class="text-[0.68rem] font-black uppercase tracking-[0.14em] text-draft-amber dark:text-draft-gold sm:text-xs sm:tracking-[0.18em]">Draft grades</p>
            <div class="mt-1 flex flex-col gap-1.5 sm:flex-row sm:items-center sm:gap-3">
              <h2 id="grade-guide-title" class="font-display text-xl font-black leading-tight sm:text-2xl">How we grade players</h2>
              <a class="od-focus-ring w-fit rounded text-xs font-black text-slate-600 underline decoration-draft-gold/60 underline-offset-4 transition hover:text-draft-amber dark:text-slate-300 dark:hover:text-draft-gold" href="/about#our-grading-system">
                How we made this system
              </a>
            </div>
          </div>
          <button
            type="button"
            class="od-focus-ring inline-grid size-8 shrink-0 place-items-center rounded-md border border-slate-300 text-slate-500 transition hover:bg-draft-foam hover:text-draft-amber dark:border-white/15 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-draft-gold sm:size-9"
            @click="gradeGuideOpen = false"
            aria-label="Close grading guide"
          >
            <svg class="size-4 sm:size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>

        <div class="grid gap-4 p-3 sm:gap-5 sm:p-4">
          <section class="grid gap-2 rounded-md border border-draft-gold/35 bg-draft-gold/10 p-3 text-sm font-bold leading-6 text-slate-700 dark:bg-draft-gold/10 dark:text-slate-200">
            <h3 class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">About Grading</h3>
            <p>Every position is graded on six physical traits, in addition to 9-14 film traits specific to that position. Using each of these traits graded 1-8, a raw grade is calculated, with additional modifiers added, adjusting for potential and positional value, providing the final grades seen on the Big Board.</p>
            <p>Each player is also assigned an &lsquo;Archetype&rsquo;. Each position has anywhere from 2-4 archetypes. These archetypes are not necessarily role projections into the league; they are a reflection of current playstyle. Archetypes are only used for the internal grading structure. True role projection and scheme fit are presented separately.</p>
            <p>Each archetype is crafted to adjust for different styles of players within each position (ex. A &lsquo;Physical&rsquo; styled WR vs. a &lsquo;Slot&rsquo; styled WR, where traits such as Size / Frame, Contested Catching, and Body Control will be weighed higher for a &lsquo;Physical&rsquo; WR than a &lsquo;Slot&rsquo; WR). The purpose of these archetypes is to account for these differences in strengths / weaknesses without unfairly punishing players for lacking in certain skills when it may simply not be as important to their style of play.</p>
          </section>

          <section class="grid gap-2">
            <h3 class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Final Grades</h3>
            <div class="overflow-hidden rounded-md border border-slate-200 dark:border-white/10">
              <div class="grid grid-cols-[minmax(4rem,0.7fr)_minmax(0,1.45fr)_minmax(4.5rem,0.75fr)] bg-slate-100 px-2 py-1.5 text-[0.6rem] font-black uppercase tracking-wide text-slate-500 dark:bg-white/10 dark:text-slate-300 sm:grid-cols-[minmax(6rem,0.75fr)_minmax(0,1.5fr)_minmax(6rem,0.75fr)] sm:px-3 sm:py-2 sm:text-[0.68rem]">
                <span>Grade</span>
                <span>Meaning</span>
                <span>Projection</span>
              </div>
              <% [
                ["7.70 - 8.00", "Generational Prospect", "#1 Overall Pick"],
                ["7.10 - 7.70", "Blue Chip Talent", "Top 5"],
                ["6.80 - 7.10", "Immediate Impact Starter / Elite Upside Project", "Top 10"],
                ["6.50 - 6.80", "Year 1 Starter / High Upside Project", "Round 1"],
                ["6.10 - 6.50", "Potential Year 1 Impact / Good Upside Project (Medium Floor)", "Rounds 1-2 / Top 50"],
                ["5.70 - 6.10", "Potential Impact Starter within Rookie Contract", "Round 2 / Rounds 2-3"],
                ["5.10 - 5.70", "High Level Backup / Role Player / Good Upside Project (Lower Floor)", "Round 3 / Rounds 3-4"],
                ["4.40 - 5.10", "Good Role Player / Total Project", "Early Day 3"],
                ["3.80 - 4.40", "Developmental: Backup / Role Player with Roster Potential", "Late Day 3"],
                ["3.00 - 3.80", "Roster Longshot / Practice Squad Contributor", "PFA"],
                ["< 3.0", "Training Camp Body", "UDFA"],
              ].forEach((row) => { %>
                <div class="grid grid-cols-[minmax(4rem,0.7fr)_minmax(0,1.45fr)_minmax(4.5rem,0.75fr)] gap-1.5 border-t border-slate-200 px-2 py-1.5 text-[0.68rem] font-bold leading-4 text-slate-700 dark:border-white/10 dark:text-slate-200 sm:grid-cols-[minmax(6rem,0.75fr)_minmax(0,1.5fr)_minmax(6rem,0.75fr)] sm:gap-2 sm:px-3 sm:py-2 sm:text-xs sm:leading-normal">
                  <strong class="text-draft-amber dark:text-draft-gold"><%= row[0] %></strong>
                  <span><%= row[1] %></span>
                  <span><%= row[2] %></span>
                </div>
              <% }) %>
            </div>
          </section>

          <div class="grid gap-4 lg:grid-cols-[minmax(13rem,0.62fr)_minmax(0,1.38fr)] lg:items-start">
            <section class="grid content-start gap-2">
              <h3 class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Our Scale</h3>
              <div class="grid grid-cols-2 gap-1.5">
                <% [
                  ["1", "Liability"],
                  ["2", "Poor"],
                  ["3", "Below Average"],
                  ["4", "Average"],
                  ["5", "Above Average"],
                  ["6", "Good"],
                  ["7", "Outstanding"],
                  ["8", "Rare"],
                ].forEach((row) => { %>
                  <span class="grid grid-cols-[1.35rem_minmax(0,1fr)] items-center gap-2 rounded bg-slate-100 px-2 py-1 text-[0.72rem] font-bold leading-tight dark:bg-white/10">
                    <strong class="font-display text-base leading-none text-draft-amber dark:text-draft-gold"><%= row[0] %></strong>
                    <span><%= row[1] %></span>
                  </span>
                <% }) %>
              </div>
            </section>

            <section class="grid content-start gap-2">
              <h3 class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Universal Physical Traits</h3>
              <div class="grid gap-1.5 text-[0.72rem] font-bold leading-5 text-slate-700 dark:text-slate-200 sm:grid-cols-2">
                <% [
                  ["SPD", "Speed", "Raw top-end speed"],
                  ["ACC", "Acceleration", "Ability to get from 0-60; essentially burst from standstill"],
                  ["AGI", "Agility", "General foot quickness, lateral movement, and ability to stay feather footed"],
                  ["COD", "Change of Direction", "Ability to turn and change directions without sacrificing momentum and speed; generally looks at hip fluidity"],
                  ["STR", "Strength", "Raw play strength"],
                  ["FRA", "Size / Frame", "Relative assessment of their size / frame for their position"],
                ].forEach((row) => { %>
                  <span class="rounded bg-slate-100 px-2 py-1.5 dark:bg-white/10">
                    <strong class="text-draft-amber dark:text-draft-gold"><%= row[0] %></strong>
                    <span><%= row[1] %>: <%= row[2] %></span>
                  </span>
                <% }) %>
              </div>
            </section>
          </div>

          <% if (gradeGuidePositions.length > 0) { %>
            <section class="grid gap-3">
              <div>
                <h3 class="text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Position Trait Glossary</h3>
                <div class="mt-2 flex flex-wrap gap-1.5">
                  <% gradeGuidePositions.forEach((config) => { %>
                    <button
                      type="button"
                      class="od-focus-ring rounded border border-slate-300 px-2.5 py-1 text-xs font-black uppercase tracking-wide text-slate-600 transition hover:border-draft-gold hover:text-draft-amber dark:border-white/15 dark:text-slate-300 dark:hover:text-draft-gold"
                      :class="gradeGuidePosition === '<%= config.position %>' ? 'border-draft-gold bg-draft-gold text-draft-ink dark:text-draft-ink' : ''"
                      @click="gradeGuidePosition = '<%= config.position %>'"
                    >
                      <%= config.position %>
                    </button>
                  <% }) %>
                </div>
              </div>

              <% gradeGuidePositions.forEach((config) => { %>
                <div class="grid gap-2" x-show="gradeGuidePosition === '<%= config.position %>'" x-cloak>
                  <% config.archetypes.forEach((archetype, index) => { %>
                    <% const filmTraitCategory = archetype.categories.find((category) => category.key === "filmTraits"); %>
                    <details class="rounded-md border border-slate-200 bg-white dark:border-white/10 dark:bg-draft-ink" <%= index === 0 ? "open" : "" %>>
                      <summary class="od-focus-ring cursor-pointer list-none px-3 py-2 text-sm font-black text-slate-800 transition hover:bg-slate-50 dark:text-slate-100 dark:hover:bg-white/[0.04] [&::-webkit-details-marker]:hidden">
                        <%= config.position %> - <%= archetype.name %>
                      </summary>
                      <div class="border-t border-slate-200 p-3 dark:border-white/10">
                        <% if (filmTraitCategory) { %>
                          <div class="flex flex-wrap gap-1.5">
                            <% filmTraitCategory.traits.forEach((trait) => { %>
                              <span class="rounded bg-slate-100 px-2 py-1 text-[0.72rem] font-semibold leading-tight text-slate-700 dark:bg-white/10 dark:text-slate-200">
                                <%= trait %>
                              </span>
                            <% }) %>
                          </div>
                        <% } %>
                      </div>
                    </details>
                  <% }) %>
                </div>
              <% }) %>
            </section>
          <% } %>
        </div>
      </section>
      </div>
    </template>
  <% } %>
</div>

<% if (values.contentType === "pdf") { %>
  <label>
    PDF
    <input type="file" name="pdf" accept="application/pdf,.pdf" />
  </label>
  <div class="pdf-style-guide" aria-label="PDF article style guide">
    <div>
      <p class="pdf-style-guide-kicker">PDF style guide</p>
      <p class="pdf-style-guide-note">Use these values when designing PDFs so the document feels at home inside OnDraft.</p>
    </div>
    <div class="pdf-style-guide-grid">
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#f1f5f9]" aria-hidden="true"></span>
        <span>
          <strong>Body text</strong>
          <small>#F1F5F9</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#ffffff] ring-1 ring-slate-300" aria-hidden="true"></span>
        <span>
          <strong>Title text</strong>
          <small>#FFFFFF</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#111825]" aria-hidden="true"></span>
        <span>
          <strong>Background</strong>
          <small>#111825</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#d99822]" aria-hidden="true"></span>
        <span>
          <strong>Accent</strong>
          <small>#D99822</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-type font-sans" aria-hidden="true">Aa</span>
        <span>
          <strong>Body font</strong>
          <small>Source Sans 3 / Segoe UI</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-type font-display" aria-hidden="true">Aa</span>
        <span>
          <strong>Title font</strong>
          <small>Newsreader / Georgia</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-size" aria-hidden="true">18</span>
        <span>
          <strong>Body size</strong>
          <small>18 px / 32 px line height</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-size" aria-hidden="true">48</span>
        <span>
          <strong>Title size</strong>
          <small>36 px mobile / 48 px desktop, black</small>
        </span>
      </div>
    </div>
  </div>
<% } else if (values.contentType === "html") { %>
  <label>
    HTML content
    <textarea name="content" data-html-content><%= values.content || "" %></textarea>
  </label>
  <details class="rounded-md border border-slate-300 bg-white/60 p-3 text-sm leading-6 text-slate-700 dark:border-white/15 dark:bg-white/[0.04] dark:text-slate-200">
    <summary class="cursor-pointer font-black text-draft-amber dark:text-draft-gold">HTML formatting guide</summary>
    <p class="mt-2">Plain tags are styled for you: <code>h2</code> for sections, <code>h3</code> for sub-headings, <code>p</code>, lists, <code>blockquote</code>, <code>img</code>, <code>video</code>, and <code>hr</code> for a gold rule. Inline styles and other classes are removed. Four optional classes add the feature-article look:</p>
    <pre class="mt-2 overflow-x-auto rounded bg-slate-100 p-3 text-xs leading-5 dark:bg-black/30"><code>&lt;p class="kicker"&gt;OnDraft Football / Weekly Series&lt;/p&gt;
&lt;p class="title"&gt;Week 11 NFL Power Rankings&lt;/p&gt;
&lt;p class="lede"&gt;A larger, quieter intro paragraph.&lt;/p&gt;
&lt;hr&gt;
&lt;h2&gt;Tier 1: Pick Your Poison&lt;/h2&gt;
&lt;h3&gt;&lt;span class="rank"&gt;01&lt;/span&gt; Cincinnati Bengals&lt;/h3&gt;
&lt;p&gt;Body copy.&lt;/p&gt;</code></pre>
  </details>
  <div class="html-image-uploader" data-html-image-uploader>
    <label>
      HTML article image
      <%# No name attribute: this input uploads through its own button, and a named file input
          would be submitted with the article form and count against the upload file limit. %>
      <input type="file" accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp" data-html-image-input />
    </label>
    <button type="button" class="secondary-button" data-html-image-upload>Upload image</button>
    <p class="html-image-uploader-status" data-html-image-status aria-live="polite">Uploaded image URLs will appear here for embedding.</p>
  </div>
  <div class="html-video-uploader" data-html-video-uploader>
    <label>
      HTML article video
      <input type="file" accept="video/mp4,video/webm,.mp4,.webm" data-html-video-input />
    </label>
    <button type="button" class="secondary-button" data-html-video-upload>Upload video</button>
    <p class="html-video-uploader-status" data-html-video-status aria-live="polite">Uploaded video URLs will appear here for embedding.</p>
  </div>
<% } else { %>
  <label>
    Content
    <textarea name="content"><%= values.content || "" %></textarea>
  </label>
<% } %>

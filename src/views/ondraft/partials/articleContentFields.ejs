<% if (values.contentType === "pdf") { %>
  <label>
    PDF
    <input type="file" name="pdf" accept="application/pdf,.pdf" />
  </label>
  <div class="pdf-style-guide" aria-label="PDF article style guide">
    <div>
      <p class="pdf-style-guide-kicker">PDF style guide</p>
      <p class="pdf-style-guide-note">Use these values when designing PDFs so the document feels at home inside OnDraft.</p>
    </div>
    <div class="pdf-style-guide-grid">
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#f1f5f9]" aria-hidden="true"></span>
        <span>
          <strong>Body text</strong>
          <small>#F1F5F9</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#ffffff] ring-1 ring-slate-300" aria-hidden="true"></span>
        <span>
          <strong>Title text</strong>
          <small>#FFFFFF</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#111825]" aria-hidden="true"></span>
        <span>
          <strong>Background</strong>
          <small>#111825</small>
        </span>
      </div>
      <div class="pdf-style-guide-item">
        <span class="pdf-style-swatch bg-[#d99822]" aria-hidden="true"></span>
        <span>
          <strong>Accent</strong>
          <small>#D99822</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-type font-sans" aria-hidden="true">Aa</span>
        <span>
          <strong>Body font</strong>
          <small>Segoe UI / Inter / Arial</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-type font-display" aria-hidden="true">Aa</span>
        <span>
          <strong>Title font</strong>
          <small>Georgia / Cambria</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-size" aria-hidden="true">18</span>
        <span>
          <strong>Body size</strong>
          <small>18 px / 32 px line height</small>
        </span>
      </div>
      <div class="pdf-style-guide-item pdf-style-guide-text-item">
        <span class="pdf-style-sample-size" aria-hidden="true">48</span>
        <span>
          <strong>Title size</strong>
          <small>36 px mobile / 48 px desktop, black</small>
        </span>
      </div>
    </div>
  </div>
<% } else if (values.contentType === "html") { %>
  <label>
    HTML content
    <textarea name="content" data-html-content><%= values.content || "" %></textarea>
  </label>
  <div class="html-image-uploader" data-html-image-uploader>
    <label>
      HTML article image
      <input type="file" name="htmlImage" accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp" data-html-image-input />
    </label>
    <button type="button" class="secondary-button" data-html-image-upload>Upload image</button>
    <p class="html-image-uploader-status" data-html-image-status aria-live="polite">Uploaded image URLs will appear here for embedding.</p>
  </div>
<% } else { %>
  <label>
    Content
    <textarea name="content"><%= values.content || "" %></textarea>
  </label>
<% } %>

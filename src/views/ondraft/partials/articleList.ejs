<% const currentViewMode = typeof viewMode !== "undefined" && viewMode === "list" ? "list" : "card"; %>
<% if (articles.length === 0) { %>
  <div class="od-card grid min-h-48 place-items-center p-8 text-center">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.18em] text-draft-amber dark:text-draft-gold">Dry tap</p>
      <p class="mt-2 font-display text-2xl font-bold text-slate-950 dark:text-white">No articles match those filters.</p>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Try a wider search or clear the filters.</p>
      <% if (isAdmin) { %>
        <div class="mt-5 flex flex-col justify-center gap-3 sm:flex-row">
          <a class="od-primary-link" href="/articles/new">Create article</a>
          <button
            type="button"
            class="od-secondary-link"
            onclick="const form = document.getElementById('article-filter-form'); if (!form) return; const status = document.getElementById('article-status-field')?.value || 'published'; form.reset(); const statusField = document.getElementById('article-status-field'); if (statusField) statusField.value = status; htmx.trigger(form, 'submit');"
          >
            Clear filters
          </button>
        </div>
      <% } %>
    </div>
  </div>
<% } else if (currentViewMode === "list") { %>
  <ul class="grid list-none gap-3 p-0">
    <% articles.forEach((article) => { %>
      <% const articleHref = isAdmin && !article.published ? `/articles/${article.id}/preview` : `/articles/${article.id}`; %>
      <li id="article-list-item-<%= article.id %>" class="article-list-row od-card">
        <a class="group grid min-w-0 grid-cols-[4rem_minmax(0,1fr)] gap-3 text-slate-950 no-underline dark:text-white md:grid-cols-[4.5rem_minmax(0,1fr)_auto]" href="<%= articleHref %>">
          <span class="relative block aspect-square overflow-hidden rounded-md bg-draft-ink">
            <% if (article.imageUrl) { %>
              <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" />
            <% } else { %>
              <span class="article-list-thumb article-list-thumb-empty">
                <span class="rounded bg-draft-gold px-2 py-1 text-[0.62rem] font-black uppercase tracking-wide text-draft-ink">OD</span>
              </span>
            <% } %>
          </span>
          <span class="grid min-w-0 gap-2">
            <span class="flex flex-wrap items-center gap-2 text-xs font-black uppercase tracking-[0.14em] text-draft-amber dark:text-draft-gold">
              <span>Article</span>
              <% if (article.publicationDate) { %>
                <span class="text-slate-400 dark:text-slate-500">/</span>
                <span><%= new Date(article.publicationDate).toLocaleDateString() %></span>
              <% } %>
              <% if (!article.published) { %>
                <span class="rounded bg-draft-gold px-2 py-0.5 text-[0.62rem] text-draft-ink">Draft</span>
              <% } %>
            </span>
            <span class="line-clamp-2 font-display text-lg font-black leading-tight tracking-normal text-slate-950 transition group-hover:text-draft-amber dark:text-white dark:group-hover:text-draft-gold sm:line-clamp-1 sm:text-xl"><%= article.title %></span>
            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 sm:text-sm">By <%= article.author %></span>
          </span>
          <span class="col-span-2 flex flex-wrap items-center gap-3 text-xs font-semibold text-slate-500 dark:text-slate-400 md:col-span-1 md:justify-end md:text-sm">
            <span class="inline-flex items-center gap-1.5" aria-label="<%= article.likes %> likes">
              <span aria-hidden="true">&#9825;</span>
              <span><%= article.likes %></span>
            </span>
            <span class="inline-flex items-center gap-1.5" aria-label="<%= article.comments.length %> comments">
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4.4-1.1L3 20l1.2-4a8 8 0 0 1-1.1-4.5 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8.9 8.4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
              <span><%= article.comments.length %></span>
            </span>
          </span>
        </a>
        <div class="flex shrink-0 items-start gap-2 sm:justify-end">
          <% if (session.authenticatedUser) { %>
            <%- include("bookmarkButton", { bookmark: { type: "article", articleId: article.id }, bookmarked: bookmarkedArticleIds.includes(article.id) }) %>
          <% } %>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="od-focus-ring rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm font-black text-red-700 transition hover:bg-red-100 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-200 dark:hover:bg-red-500/20"
              hx-delete="/articles/<%= article.id %>"
              hx-confirm="Are you sure? Deleted articles cannot be recovered."
              hx-target="#article-list-item-<%= article.id %>"
              hx-swap="outerHTML"
            >
              Delete
            </button>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <ul class="grid list-none gap-5 p-0">
    <% articles.forEach((article) => { %>
      <% const articleHref = isAdmin && !article.published ? `/articles/${article.id}/preview` : `/articles/${article.id}`; %>
      <li id="article-list-item-<%= article.id %>" class="od-card grid overflow-hidden transition hover:-translate-y-0.5 hover:border-draft-gold hover:shadow-editorial lg:grid-cols-[18rem_minmax(0,1fr)_auto]">
        <a class="group grid min-w-0 text-slate-950 no-underline dark:text-white lg:contents" href="<%= articleHref %>">
          <span class="relative block aspect-[16/10] overflow-hidden bg-draft-ink lg:aspect-auto lg:min-h-56">
            <% if (article.imageUrl) { %>
              <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" />
            <% } else { %>
              <span class="article-list-thumb article-list-thumb-empty">
                <span class="rounded bg-draft-gold px-3 py-2 text-xs font-black uppercase tracking-[0.18em] text-draft-ink">OnDraft</span>
              </span>
            <% } %>
            <% if (!article.published) { %>
              <span class="absolute left-3 top-3 rounded bg-draft-gold px-2.5 py-1 text-xs font-black uppercase tracking-wide text-draft-ink">Draft</span>
            <% } %>
          </span>

          <span class="grid min-w-0 content-start gap-3 p-4 sm:p-6">
            <span class="flex flex-wrap items-center gap-2 text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">
              <span>Article</span>
              <% if (article.publicationDate) { %>
                <span class="text-slate-400 dark:text-slate-500">/</span>
                <span><%= new Date(article.publicationDate).toLocaleDateString() %></span>
              <% } %>
            </span>
            <span class="font-display text-2xl font-black leading-tight tracking-normal text-slate-950 transition group-hover:text-draft-amber dark:text-white dark:group-hover:text-draft-gold sm:text-3xl">
              <%= article.title %>
            </span>
            <span class="text-sm font-bold text-slate-600 dark:text-slate-300">By <%= article.author %></span>
            <% if (!article.published) { %>
              <span class="text-sm font-black uppercase tracking-[0.14em] text-draft-amber dark:text-draft-gold">Draft - unpublished</span>
            <% } %>
            <span class="line-clamp-2 text-sm leading-6 text-slate-700 dark:text-slate-200 sm:line-clamp-3 sm:text-base sm:leading-7"><%= article.writeup %></span>
            <span class="flex flex-wrap gap-3 text-sm font-semibold text-slate-500 dark:text-slate-400">
              <span class="inline-flex items-center gap-1.5" aria-label="<%= article.likes %> likes">
                <span aria-hidden="true">&#9825;</span>
                <span><%= article.likes %></span>
              </span>
              <span class="inline-flex items-center gap-1.5" aria-label="<%= article.comments.length %> comments">
                <svg class="size-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4.4-1.1L3 20l1.2-4a8 8 0 0 1-1.1-4.5 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8.9 8.4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
                <span><%= article.comments.length %></span>
              </span>
            </span>
            <% if (article.tags && article.tags.length > 0) { %>
              <span class="flex flex-wrap gap-2">
                <% article.tags.forEach((tag) => { %>
                  <span class="rounded bg-draft-foam px-2.5 py-1 text-xs font-black text-draft-amber dark:bg-white/10 dark:text-draft-gold"><%= tag.toLowerCase() %></span>
                <% }) %>
              </span>
            <% } %>
          </span>
        </a>

        <div class="flex items-start gap-2 border-t border-slate-200 p-4 dark:border-white/10 lg:border-l lg:border-t-0">
          <% if (session.authenticatedUser) { %>
            <%- include("bookmarkButton", { bookmark: { type: "article", articleId: article.id }, bookmarked: bookmarkedArticleIds.includes(article.id) }) %>
          <% } %>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="od-focus-ring rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm font-black text-red-700 transition hover:bg-red-100 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-200 dark:hover:bg-red-500/20"
              hx-delete="/articles/<%= article.id %>"
              hx-confirm="Are you sure? Deleted articles cannot be recovered."
              hx-target="#article-list-item-<%= article.id %>"
              hx-swap="outerHTML"
            >
              Delete
            </button>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

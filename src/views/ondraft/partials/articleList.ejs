<% const currentViewMode = typeof viewMode !== "undefined" && viewMode === "list" ? "list" : "card"; %>
<% if (articles.length === 0) { %>
  <% const anyArticlesExist = typeof hasAnyArticles !== "undefined" ? hasAnyArticles : articles.length > 0; %>
  <% const currentHasFilters = typeof hasFilters !== "undefined" ? hasFilters : false; %>
  <div class="od-empty-state">
    <div>
      <% if (!anyArticlesExist) { %>
        <p class="od-empty-state-kicker">No articles yet</p>
        <p class="od-empty-state-title">No articles have been created yet.</p>
        <p class="od-empty-state-copy">Create the first article when a story is ready for the board.</p>
        <% if (isAdmin) { %>
          <div class="od-empty-state-actions">
            <a class="od-primary-link" href="/articles/new">Create article</a>
          </div>
        <% } %>
      <% } else { %>
        <p class="od-empty-state-kicker">Dry tap</p>
        <p class="od-empty-state-title">No articles match those filters.</p>
        <p class="od-empty-state-copy">Try a wider search or clear the filters.</p>
        <% if (currentHasFilters) { %>
          <div class="od-empty-state-actions">
            <% if (isAdmin) { %>
              <a class="od-primary-link" href="/articles/new">Create article</a>
            <% } %>
            <button
              type="button"
              class="od-secondary-link"
              onclick="window.dispatchEvent(new CustomEvent('ondraft:clear-filters', { detail: { formId: 'article-filter-form' } }));"
            >
              Clear filters
            </button>
          </div>
        <% } else if (isAdmin) { %>
          <div class="od-empty-state-actions">
          <a class="od-primary-link" href="/articles/new">Create article</a>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
<% } else if (currentViewMode === "list") { %>
  <ul class="od-stagger-list grid list-none gap-2.5 p-0 sm:gap-3">
    <% articles.forEach((article) => { %>
      <% const articleHref = isAdmin && !article.published ? `/articles/${article.id}/preview` : `/articles/${article.id}`; %>
      <li id="article-list-item-<%= article.id %>" class="article-list-row od-card">
        <a class="group grid min-w-0 grid-cols-[3.25rem_minmax(0,1fr)] gap-2.5 text-slate-950 no-underline dark:text-white sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-3 md:grid-cols-[4.5rem_minmax(0,1fr)_auto]" href="<%= articleHref %>">
          <span class="relative block aspect-square overflow-hidden rounded-md bg-draft-ink">
            <% if (article.imageUrl) { %>
              <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" loading="lazy" decoding="async" />
            <% } else { %>
              <span class="article-list-thumb article-list-thumb-empty">
                <img class="h-9 w-11 object-contain drop-shadow-sm" src="/images/brand/OnDraftLogo-cropped.png" alt="" loading="lazy" decoding="async" />
              </span>
            <% } %>
          </span>
          <span class="grid min-w-0 gap-2">
            <span class="flex flex-wrap items-center gap-1.5 text-[0.65rem] font-black uppercase tracking-[0.1em] text-draft-amber dark:text-draft-gold sm:gap-2 sm:text-xs sm:tracking-[0.14em]">
              <span>Article</span>
              <% if (article.publicationDate) { %>
                <span class="text-slate-400 dark:text-slate-500">/</span>
                <span><%= new Date(article.publicationDate).toLocaleDateString() %></span>
              <% } %>
              <% if (!article.published) { %>
                <span class="rounded bg-draft-gold px-2 py-0.5 text-[0.62rem] text-draft-ink">Draft</span>
              <% } %>
            </span>
            <span class="line-clamp-2 font-display text-base font-black leading-tight tracking-normal text-slate-950 transition group-hover:text-draft-amber dark:text-white dark:group-hover:text-draft-gold sm:line-clamp-1 sm:text-xl"><%= article.title %></span>
            <span class="text-xs font-bold text-slate-600 dark:text-slate-300 sm:text-sm">By <%= article.author %></span>
          </span>
          <span class="col-span-2 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 sm:gap-3 md:col-span-1 md:justify-end md:text-sm">
            <span class="inline-flex items-center gap-1.5" aria-label="<%= article.likes %> likes">
              <span aria-hidden="true">&#9825;</span>
              <span><%= article.likes %></span>
            </span>
            <span class="inline-flex items-center gap-1.5" aria-label="<%= article.comments.length %> comments">
              <svg class="size-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4.4-1.1L3 20l1.2-4a8 8 0 0 1-1.1-4.5 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8.9 8.4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              </svg>
              <span><%= article.comments.length %></span>
            </span>
          </span>
        </a>
        <div class="flex shrink-0 items-start gap-1.5 sm:gap-2 sm:justify-end">
          <% if (session.authenticatedUser) { %>
            <%- include("bookmarkButton", { bookmark: { type: "article", articleId: article.id }, bookmarked: bookmarkedArticleIds.includes(article.id) }) %>
          <% } %>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="od-focus-ring rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-black text-red-700 transition hover:bg-red-100 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-200 dark:hover:bg-red-500/20 sm:px-3 sm:py-2 sm:text-sm"
              hx-delete="/articles/<%= article.id %>"
              hx-confirm="Are you sure? Deleted articles cannot be recovered."
              hx-target="#article-list-item-<%= article.id %>"
              hx-swap="outerHTML"
            >
              Delete
            </button>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } else { %>
  <ul class="od-stagger-list grid list-none gap-3 p-0 sm:gap-5">
    <% articles.forEach((article) => { %>
      <% const articleHref = isAdmin && !article.published ? `/articles/${article.id}/preview` : `/articles/${article.id}`; %>
      <li id="article-list-item-<%= article.id %>" class="od-card grid overflow-hidden transition hover:-translate-y-0.5 hover:border-draft-gold hover:shadow-editorial lg:grid-cols-[18rem_minmax(0,1fr)_auto]">
        <a class="group grid min-w-0 text-slate-950 no-underline dark:text-white lg:contents" href="<%= articleHref %>">
          <span class="relative block aspect-[16/9] overflow-hidden bg-draft-ink sm:aspect-[16/10] lg:aspect-auto lg:min-h-56">
            <% if (article.imageUrl) { %>
              <img class="article-list-thumb" src="<%= article.imageUrl %>" alt="" loading="lazy" decoding="async" />
            <% } else { %>
              <span class="article-list-thumb article-list-thumb-empty">
                <img class="h-16 w-20 object-contain drop-shadow-sm" src="/images/brand/OnDraftLogo-cropped.png" alt="" loading="lazy" decoding="async" />
              </span>
            <% } %>
            <% if (!article.published) { %>
              <span class="absolute left-2 top-2 rounded bg-draft-gold px-2 py-0.5 text-[0.68rem] font-black uppercase tracking-wide text-draft-ink sm:left-3 sm:top-3 sm:px-2.5 sm:py-1 sm:text-xs">Draft</span>
            <% } %>
          </span>

          <span class="grid min-w-0 content-start gap-2.5 p-3.5 sm:gap-3 sm:p-6">
            <span class="flex flex-wrap items-center gap-1.5 text-[0.68rem] font-black uppercase tracking-[0.1em] text-draft-amber dark:text-draft-gold sm:gap-2 sm:text-xs sm:tracking-[0.16em]">
              <span>Article</span>
              <% if (article.publicationDate) { %>
                <span class="text-slate-400 dark:text-slate-500">/</span>
                <span><%= new Date(article.publicationDate).toLocaleDateString() %></span>
              <% } %>
            </span>
            <span class="font-display text-xl font-black leading-tight tracking-normal text-slate-950 transition group-hover:text-draft-amber dark:text-white dark:group-hover:text-draft-gold sm:text-3xl">
              <%= article.title %>
            </span>
            <span class="text-sm font-bold text-slate-600 dark:text-slate-300">By <%= article.author %></span>
            <% if (!article.published) { %>
              <span class="text-sm font-black uppercase tracking-[0.14em] text-draft-amber dark:text-draft-gold">Draft - unpublished</span>
            <% } %>
            <span class="line-clamp-2 text-xs leading-5 text-slate-700 dark:text-slate-200 sm:line-clamp-3 sm:text-base sm:leading-7"><%= article.writeup %></span>
            <span class="flex flex-wrap gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400 sm:gap-3 sm:text-sm">
              <span class="inline-flex items-center gap-1.5" aria-label="<%= article.likes %> likes">
                <span aria-hidden="true">&#9825;</span>
                <span><%= article.likes %></span>
              </span>
              <span class="inline-flex items-center gap-1.5" aria-label="<%= article.comments.length %> comments">
                <svg class="size-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4.4-1.1L3 20l1.2-4a8 8 0 0 1-1.1-4.5 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8.9 8.4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                </svg>
                <span><%= article.comments.length %></span>
              </span>
            </span>
            <% if (article.tags && article.tags.length > 0) { %>
              <span class="flex flex-wrap gap-2">
                <% article.tags.forEach((tag) => { %>
                  <span class="rounded bg-draft-foam px-2 py-0.5 text-[0.68rem] font-black text-draft-amber dark:bg-white/10 dark:text-draft-gold sm:px-2.5 sm:py-1 sm:text-xs"><%= tag.toLowerCase() %></span>
                <% }) %>
              </span>
            <% } %>
          </span>
        </a>

        <div class="flex items-start gap-1.5 border-t border-slate-200 p-3 dark:border-white/10 sm:gap-2 sm:p-4 lg:border-l lg:border-t-0">
          <% if (session.authenticatedUser) { %>
            <%- include("bookmarkButton", { bookmark: { type: "article", articleId: article.id }, bookmarked: bookmarkedArticleIds.includes(article.id) }) %>
          <% } %>
          <% if (isAdmin) { %>
            <button
              type="button"
              class="od-focus-ring rounded-md border border-red-200 bg-red-50 px-2.5 py-1.5 text-xs font-black text-red-700 transition hover:bg-red-100 dark:border-red-400/30 dark:bg-red-500/10 dark:text-red-200 dark:hover:bg-red-500/20 sm:px-3 sm:py-2 sm:text-sm"
              hx-delete="/articles/<%= article.id %>"
              hx-confirm="Are you sure? Deleted articles cannot be recovered."
              hx-target="#article-list-item-<%= article.id %>"
              hx-swap="outerHTML"
            >
              Delete
            </button>
          <% } %>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>

<form
  id="big-board-controls"
  class="big-board-controls od-card grid gap-5 p-4 sm:p-5"
  method="get"
  action="/bigboard"
  hx-get="/bigboard"
  hx-target="#big-board-results"
  hx-swap="outerHTML"
>
  <div class="grid gap-4 lg:grid-cols-[12rem_minmax(0,1fr)] lg:items-end">
    <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
      <span>Year</span>
      <select class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="year" onchange="htmx.trigger(this.form, 'submit');">
        <% years.forEach((year) => { %>
          <option value="<%= year %>" <%= board.year === year ? "selected" : "" %>><%= year %></option>
        <% }) %>
      </select>
    </label>

    <div>
      <p class="mb-2 text-sm font-bold text-slate-800 dark:text-slate-100">Board</p>
      <input type="hidden" name="creator" value="<%= board.creator %>" />
      <div class="creator-toggle grid gap-2 sm:grid-cols-3" aria-label="Board creator">
        <% creators.forEach((creator) => { %>
          <button
            type="button"
            class="od-focus-ring rounded-md border px-4 py-2 text-sm font-black transition <%= board.creator === creator ? "border-draft-gold bg-draft-gold text-draft-ink" : "border-slate-300 bg-white text-slate-700 hover:border-draft-gold hover:bg-draft-foam dark:border-white/15 dark:bg-white/10 dark:text-slate-200 dark:hover:bg-white/15" %>"
            aria-pressed="<%= board.creator === creator ? "true" : "false" %>"
            onclick="this.form.creator.value = '<%= creator %>'; htmx.trigger(this.form, 'submit');"
          >
            <%= creator %>
          </button>
        <% }) %>
      </div>
    </div>
  </div>

  <div class="grid gap-3 border-t border-slate-200 pt-4 dark:border-white/10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] lg:items-end">
    <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
      <span>Position</span>
      <select name="position">
        <option value="" <%= !filters.position ? "selected" : "" %>>All</option>
        <% positions.forEach((position) => { %>
          <option value="<%= position %>" <%= filters.position === position ? "selected" : "" %>><%= position %></option>
        <% }) %>
      </select>
    </label>
    <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
      <span>School</span>
      <select name="school">
        <option value="" <%= !filters.school ? "selected" : "" %>>All</option>
        <% schools.forEach((school) => { %>
          <option value="<%= school %>" <%= filters.school === school ? "selected" : "" %>><%= school %></option>
        <% }) %>
      </select>
    </label>
    <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
      <button class="od-primary-link" type="submit">Apply filters</button>
      <% if (filters.position || filters.school) { %>
        <a
          class="od-secondary-link"
          href="/bigboard?year=<%= board.year %>&creator=<%= encodeURIComponent(board.creator) %>"
          hx-get="/bigboard?year=<%= board.year %>&creator=<%= encodeURIComponent(board.creator) %>"
          hx-target="#big-board-results"
          hx-swap="outerHTML"
        >
          Reset
        </a>
      <% } %>
    </div>
  </div>
</form>

<form
  id="big-board-controls"
  class="big-board-controls grid gap-4 border-b border-slate-200 pb-4 dark:border-white/10 sm:gap-5 sm:pb-6"
  method="get"
  action="/bigboard"
  hx-get="/bigboard"
  hx-target="#big-board-results"
  hx-swap="outerHTML"
  hx-push-url="true"
  data-skip-global-loader
  data-loading-skeleton="big-board-results"
  data-loading-skeleton-target="#big-board-results"
  x-data="{
    selectedCreator: '<%= board.creator %>',
    selectCreator(creator) {
      if (this.selectedCreator === creator) return;
      this.selectedCreator = creator;
      window.localStorage.setItem('bigBoardCreator', creator);
      this.$refs.creatorInput.value = creator;
      htmx.trigger(this.$refs.bigBoardControls, 'submit');
    }
  }"
  x-ref="bigBoardControls"
>
  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_27rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_30rem]">
    <div class="grid justify-items-start gap-3 text-left sm:gap-4">
      <div class="w-full">
        <div
          class="relative inline-flex items-center gap-2"
          x-data="{ infoOpen: false }"
          x-init="$nextTick(() => { infoOpen = false })"
          @keydown.escape.window="infoOpen = false"
          @htmx:before-request.window="infoOpen = false"
          @htmx:beforeRequest.window="infoOpen = false"
          @htmx:after-swap.window="infoOpen = false"
          @htmx:afterSwap.window="infoOpen = false"
        >
          <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">Draft Board</p>
          <button
            type="button"
            class="draft-board-info-button"
            aria-label="About the draft board"
            aria-controls="draft-board-info-popover"
            :aria-expanded="String(infoOpen)"
            @click="infoOpen = !infoOpen"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9.75 9.2a2.5 2.5 0 0 1 4.55 1.4c0 1.75-2.3 2.1-2.3 3.65" />
              <path d="M12 17.4h.01" />
            </svg>
          </button>
          <div
            id="draft-board-info-popover"
            class="draft-board-info-popover"
            hidden
            x-cloak
            x-show="infoOpen"
            x-bind:hidden="!infoOpen"
            x-transition.opacity.duration.150ms
            @click.outside="infoOpen = false"
          >
            <button type="button" class="draft-board-info-close" aria-label="Close draft board note" @click.stop="infoOpen = false">&times;</button>
            <p>
              These are scouting reports and rankings of upcoming NFL draft prospects by
              <%- include("profileAuthorLink", { name: "Ryan McWalter", showBadge: false, className: "font-black text-draft-amber no-underline hover:text-draft-gold dark:text-draft-gold" }) %>
              and
              <%- include("profileAuthorLink", { name: "Aleks Ryabinkin", showBadge: false, className: "font-black text-draft-amber no-underline hover:text-draft-gold dark:text-draft-gold" }) %>
              respectively. The consensus board is the average of our rankings.
            </p>
          </div>
        </div>
        <label class="mt-2 flex flex-wrap items-center justify-start gap-x-3 gap-y-1.5 lg:flex-nowrap">
          <span class="shrink-0 font-display text-3xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">Big Board</span>
          <span class="sr-only">Year</span>
          <select class="big-board-year-select" name="year" onchange="htmx.trigger(this.form, 'submit');">
            <% years.forEach((year) => { %>
              <option value="<%= year %>" <%= board.year === year ? "selected" : "" %>><%= year %></option>
            <% }) %>
          </select>
        </label>
      </div>

      <div class="w-full">
        <p class="mb-1.5 text-xs font-black uppercase tracking-[0.12em] text-slate-600 dark:text-slate-300 sm:mb-2 sm:text-sm sm:normal-case sm:tracking-normal sm:text-slate-800 sm:dark:text-slate-100">Board</p>
        <input type="hidden" name="creator" value="<%= board.creator %>" x-ref="creatorInput" />
        <div
          class="od-range-toggle-group grid w-full max-w-xl grid-cols-3 rounded-md border border-slate-200 bg-white p-1 shadow-sm dark:border-white/10 dark:bg-draft-slate"
          style="--od-toggle-count: <%= creators.length %>;"
          aria-label="Board creator"
        >
          <% creators.forEach((creator) => { %>
            <button
              type="button"
              class="od-range-toggle <%= board.creator === creator ? "is-active" : "" %>"
              aria-pressed="<%= board.creator === creator ? "true" : "false" %>"
              :class="{ 'is-active': selectedCreator === '<%= creator %>' }"
              :aria-pressed="String(selectedCreator === '<%= creator %>')"
              @click="selectCreator('<%= creator %>')"
            >
              <%= creator %>
            </button>
          <% }) %>
        </div>
      </div>

    </div>

    <div class="od-card grid gap-2.5 p-3 sm:gap-3 sm:p-4">
      <% if (isAdmin && board.creator !== "Consensus") { %>
        <div class="flex justify-end">
          <a class="od-primary-link w-full sm:w-fit" href="/bigboard/edit?year=<%= board.year %>&creator=<%= board.creator %>">Edit board</a>
        </div>
      <% } %>
      <div class="grid grid-cols-2 gap-2 sm:gap-3">
        <label class="grid gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-100 sm:gap-2 sm:text-sm">
          <span>Position</span>
          <select name="position" onchange="htmx.trigger(this.form, 'submit');">
            <option value="" <%= !filters.position ? "selected" : "" %>>All</option>
            <% positions.forEach((position) => { %>
              <option value="<%= position %>" <%= filters.position === position ? "selected" : "" %>><%= position %></option>
            <% }) %>
          </select>
        </label>
        <label class="grid gap-1.5 text-xs font-bold text-slate-800 dark:text-slate-100 sm:gap-2 sm:text-sm">
          <span>School</span>
          <select name="school" onchange="htmx.trigger(this.form, 'submit');">
            <option value="" <%= !filters.school ? "selected" : "" %>>All</option>
            <% schools.forEach((school) => { %>
              <option value="<%= school %>" <%= filters.school === school ? "selected" : "" %>><%= school %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
        <% if (filters.position || filters.school) { %>
          <a
            class="od-secondary-link"
            href="/bigboard?year=<%= board.year %>&creator=<%= encodeURIComponent(board.creator) %>"
            hx-get="/bigboard?year=<%= board.year %>&creator=<%= encodeURIComponent(board.creator) %>"
            hx-target="#big-board-results"
            hx-swap="outerHTML"
          >
            Reset
          </a>
        <% } %>
      </div>
    </div>
  </div>
</form>

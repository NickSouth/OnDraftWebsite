<%
  const heightFractionOptions = [
    { value: 0, label: "0" },
    { value: 0.125, label: " 1/8" },
    { value: 0.25, label: " 1/4" },
    { value: 0.375, label: " 3/8" },
    { value: 0.5, label: " 1/2" },
    { value: 0.625, label: " 5/8" },
    { value: 0.75, label: " 3/4" },
    { value: 0.875, label: " 7/8" },
  ];
  const heightFeetOptions = [5, 6, 7];
  const heightInchOptions = Array.from({ length: 12 }, (_, index) => index);
  const heightValue = (feet, inches) => `${feet}-${Number(inches.toFixed(3))}`;
  const selectedHeightValue = (height) => height ? heightValue(height.feet, height.inches) : "";
  const selectedHeightFeet = (height) => height ? height.feet : "";
  const selectedHeightInches = (height) => height ? Math.floor(height.inches) : "";
  const selectedHeightFraction = (height) => height ? Number((height.inches - Math.floor(height.inches)).toFixed(3)) : 0;
%>

<section class="plain-page board-editor-page od-admin-board-page">
  <div class="page-heading big-board-heading board-editor-heading od-admin-heading">
    <div>
      <a class="od-admin-back-link" href="/bigboard">Back to big board</a>
      <p>Draft Board Admin</p>
      <h1>Edit Big Board</h1>
    </div>
    <div class="big-board-heading-actions">
      <div class="board-class-tools">
        <div class="board-class-selector-row">
          <form class="big-board-controls" method="get" action="/bigboard/edit">
            <label class="big-board-year-control">
              <span>Draft Class</span>
              <select name="year" onchange="this.form.submit();">
                <% years.forEach((year) => { %>
                  <option value="<%= year %>" <%= board.year === year ? "selected" : "" %>><%= year %></option>
                <% }) %>
              </select>
            </label>
            <input type="hidden" name="creator" value="<%= board.creator %>" />
            <div class="creator-toggle" aria-label="Board creator">
              <% creators.forEach((creator) => { %>
                <button
                  type="button"
                  class="<%= board.creator === creator ? "is-active" : "" %>"
                  aria-pressed="<%= board.creator === creator ? "true" : "false" %>"
                  onclick="this.form.creator.value = '<%= creator %>'; this.form.submit();"
                >
                  <%= creator %>
                </button>
              <% }) %>
            </div>
          </form>
        </div>
        <form class="create-board-year-form" method="post" action="/bigboard/years">
          <span>Create draft class</span>
          <input type="hidden" name="creator" value="<%= board.creator %>" />
          <input type="number" name="year" min="1900" max="2100" placeholder="Year" required />
          <button type="submit" class="secondary-button">Create</button>
        </form>
      </div>
    </div>
  </div>

  <form
    id="delete-board-year-form"
    class="delete-board-year-form"
    method="post"
    action="/bigboard/years/delete"
    onsubmit="return confirm('Are you sure? This will delete all boards from that year');"
  >
    <input type="hidden" name="year" value="<%= board.year %>" />
    <input type="hidden" name="creator" value="<%= board.creator %>" />
  </form>

  <% if (errorMessage) { %>
    <p class="od-admin-error" role="alert"><%= errorMessage %></p>
  <% } %>

  <form
    id="big-board-editor-form"
    class="board-editor-form"
    method="post"
    action="/bigboard/edit"
    hx-post="/bigboard/edit/autosave"
    hx-trigger="change delay:2m, every 2m"
    hx-target="#big-board-save-status"
    hx-swap="innerHTML"
    hx-indicator="#big-board-autosave-indicator"
  >
    <input type="hidden" name="year" value="<%= board.year %>" />
    <input type="hidden" name="creator" value="<%= board.creator %>" />
    <input id="big-board-entry-id" type="hidden" name="entryId" value="" />

    <div class="board-editor-toolbar">
      <div>
        <strong><%= board.year %> <%= board.creator %></strong>
        <span class="autosave-status-group">
          <span id="big-board-save-status" class="save-status"><%= statusMessage || "" %></span>
          <span id="big-board-autosave-indicator" class="autosave-mini-loader htmx-indicator" aria-hidden="true"></span>
        </span>
      </div>
    </div>

    <div class="board-editor-table-wrap">
      <table class="board-editor-table">
        <thead>
          <tr>
            <th><span class="sr-only">Delete</span></th>
            <th>Rank</th>
            <th>Player</th>
            <th>School</th>
            <th>Position</th>
            <th>Height</th>
            <th>Weight</th>
            <th>Pos Rank</th>
            <th>Publish</th>
            <th>Strengths</th>
            <th>Weaknesses</th>
            <th>Rundown</th>
            <th>Publish</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody id="board-editor-rows">
          <% board.entries.forEach((entry, index) => { %>
            <tr class="board-editor-row">
              <td class="board-editor-delete-cell">
                <button
                  type="button"
                  class="board-editor-delete-row-button"
                  data-delete-board-entry
                  aria-label="Delete <%= entry.playerName || "draft board entry" %>"
                  title="Delete row"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 6h18" />
                    <path d="M8 6V4h8v2" />
                    <path d="M19 6l-1 14H6L5 6" />
                    <path d="M10 11v5" />
                    <path d="M14 11v5" />
                  </svg>
                </button>
              </td>
              <td>
                <input type="number" name="entries[<%= index %>][rank]" min="1" step="1" value="<%= entry.rank ?? "" %>" placeholder="Rank" data-publish-section="player" />
              </td>
              <td>
                <input type="hidden" name="entries[<%= index %>][id]" value="<%= entry.id %>" data-entry-id />
                <input name="entries[<%= index %>][playerName]" value="<%= entry.playerName %>" placeholder="Player name" data-publish-section="player" />
              </td>
              <td><input name="entries[<%= index %>][school]" list="college-team-options" value="<%= entry.school %>" placeholder="School" autocomplete="off" data-publish-section="player" /></td>
              <td>
                <select name="entries[<%= index %>][position]" data-publish-section="player">
                  <option value="">Pos</option>
                  <% positions.forEach((position) => { %>
                    <option value="<%= position %>" <%= entry.position === position ? "selected" : "" %>><%= position %></option>
                  <% }) %>
                </select>
              </td>
              <td>
                <div class="height-picker" data-height-picker>
                  <input type="hidden" name="entries[<%= index %>][heightLabel]" value="<%= selectedHeightValue(entry.height) %>" data-height-label />
                  <button type="button" class="height-picker-trigger" data-height-toggle aria-expanded="false">
                    <span data-height-display>Height</span>
                    <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
                    </svg>
                  </button>
                  <div class="height-picker-panel" data-height-panel aria-hidden="true">
                    <label>
                      <span>Feet</span>
                      <select data-height-feet data-publish-section="player" aria-label="Height feet">
                        <option value="">--</option>
                        <% heightFeetOptions.forEach((feet) => { %>
                          <option value="<%= feet %>" <%= selectedHeightFeet(entry.height) === feet ? "selected" : "" %>><%= feet %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label>
                      <span>Inches</span>
                      <select data-height-inches data-publish-section="player" aria-label="Height inches">
                        <option value="">--</option>
                        <% heightInchOptions.forEach((inches) => { %>
                          <option value="<%= inches %>" <%= selectedHeightInches(entry.height) === inches ? "selected" : "" %>><%= inches %></option>
                        <% }) %>
                      </select>
                    </label>
                    <label>
                      <span>Fraction</span>
                      <select data-height-fraction data-publish-section="player" aria-label="Height fraction">
                        <% heightFractionOptions.forEach((fraction) => { %>
                          <option value="<%= fraction.value %>" <%= selectedHeightFraction(entry.height) === fraction.value ? "selected" : "" %>><%= fraction.label %></option>
                        <% }) %>
                      </select>
                    </label>
                  </div>
                </div>
              </td>
              <td><input type="number" name="entries[<%= index %>][weight]" min="1" step="1" value="<%= entry.weight ?? "" %>" placeholder="lbs" data-publish-section="player" /></td>
              <td>
                <input type="number" name="entries[<%= index %>][posRank]" min="1" step="1" value="<%= entry.posRank ?? "" %>" placeholder="Pos rank" data-publish-section="player" />
              </td>
              <td class="board-editor-publish-cell">
                <label class="publish-state" title="Player info published">
                  <input
                    type="checkbox"
                    name="entries[<%= index %>][playerInfoPublished]"
                    value="true"
                    data-player-publish
                    <%= entry.playerInfoPublished ? "checked" : "" %>
                  />
                </label>
              </td>
              <td><textarea name="entries[<%= index %>][strengths]" placeholder="Strengths" data-publish-section="writeup"><%= entry.writeup.strengths %></textarea></td>
              <td><textarea name="entries[<%= index %>][weaknesses]" placeholder="Weaknesses" data-publish-section="writeup"><%= entry.writeup.weaknesses %></textarea></td>
              <td><textarea name="entries[<%= index %>][rundown]" placeholder="Rundown" data-publish-section="writeup"><%= entry.writeup.rundown %></textarea></td>
              <td class="board-editor-publish-cell">
                <label class="publish-state" title="Writeup published">
                  <input
                    type="checkbox"
                    name="entries[<%= index %>][writeupPublished]"
                    value="true"
                    data-writeup-publish
                    <%= entry.writeupPublished ? "checked" : "" %>
                  />
                </label>
              </td>
              <td><textarea name="entries[<%= index %>][notes]" placeholder="Notes"><%= entry.notes %></textarea></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div class="board-editor-sticky-scroll" data-board-editor-sticky-scroll aria-hidden="true">
      <div data-board-editor-sticky-scroll-spacer></div>
    </div>
    <div class="board-editor-bottom-actions">
      <button type="button" class="secondary-button" data-add-player>Add player</button>
      <div class="board-editor-bottom-save-actions">
        <button type="submit" class="secondary-button">Save</button>
        <button type="submit" name="action" value="exit" class="save-exit-button">Save and exit</button>
        <button
          type="submit"
          form="delete-board-year-form"
          class="danger-button delete-board-year-button"
          aria-label="Delete <%= board.year %> draft class"
        >
          Delete <%= board.year %>
        </button>
      </div>
    </div>
  </form>

  <template id="board-editor-row-template">
    <tr class="board-editor-row">
      <td class="board-editor-delete-cell">
        <button
          type="button"
          class="board-editor-delete-row-button"
          data-delete-board-entry
          aria-label="Delete draft board entry"
          title="Delete row"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 6h18" />
            <path d="M8 6V4h8v2" />
            <path d="M19 6l-1 14H6L5 6" />
            <path d="M10 11v5" />
            <path d="M14 11v5" />
          </svg>
        </button>
      </td>
      <td><input type="number" data-field="rank" min="1" step="1" placeholder="Rank" data-publish-section="player" /></td>
      <td>
        <input type="hidden" data-field="id" data-entry-id />
        <input data-field="playerName" placeholder="Player name" data-publish-section="player" />
      </td>
      <td><input data-field="school" list="college-team-options" placeholder="School" autocomplete="off" data-publish-section="player" /></td>
      <td>
        <select data-field="position" data-publish-section="player">
          <option value="">Pos</option>
          <% positions.forEach((position) => { %>
            <option value="<%= position %>"><%= position %></option>
          <% }) %>
        </select>
      </td>
      <td>
        <div class="height-picker" data-height-picker>
          <input type="hidden" data-field="heightLabel" data-height-label />
          <button type="button" class="height-picker-trigger" data-height-toggle aria-expanded="false">
            <span data-height-display>Height</span>
            <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 0 1 1.06.02L10 11.17l3.71-3.94a.75.75 0 1 1 1.08 1.04l-4.25 4.5a.75.75 0 0 1-1.08 0l-4.25-4.5a.75.75 0 0 1 .02-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>
          <div class="height-picker-panel" data-height-panel aria-hidden="true">
            <label>
              <span>Feet</span>
              <select data-height-feet data-publish-section="player" aria-label="Height feet">
                <option value="">--</option>
                <% heightFeetOptions.forEach((feet) => { %>
                  <option value="<%= feet %>"><%= feet %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span>Inches</span>
              <select data-height-inches data-publish-section="player" aria-label="Height inches">
                <option value="">--</option>
                <% heightInchOptions.forEach((inches) => { %>
                  <option value="<%= inches %>"><%= inches %></option>
                <% }) %>
              </select>
            </label>
            <label>
              <span>Fraction</span>
              <select data-height-fraction data-publish-section="player" aria-label="Height fraction">
                <% heightFractionOptions.forEach((fraction) => { %>
                  <option value="<%= fraction.value %>"><%= fraction.label %></option>
                <% }) %>
              </select>
            </label>
          </div>
        </div>
      </td>
      <td><input type="number" data-field="weight" min="1" step="1" placeholder="lbs" data-publish-section="player" /></td>
      <td><input type="number" data-field="posRank" min="1" step="1" placeholder="Pos rank" data-publish-section="player" /></td>
      <td class="board-editor-publish-cell">
        <label class="publish-state" title="Player info published"><input type="checkbox" data-field="playerInfoPublished" value="true" data-player-publish /></label>
      </td>
      <td><textarea data-field="strengths" placeholder="Strengths" data-publish-section="writeup"></textarea></td>
      <td><textarea data-field="weaknesses" placeholder="Weaknesses" data-publish-section="writeup"></textarea></td>
      <td><textarea data-field="rundown" placeholder="Rundown" data-publish-section="writeup"></textarea></td>
      <td class="board-editor-publish-cell">
        <label class="publish-state" title="Writeup published"><input type="checkbox" data-field="writeupPublished" value="true" data-writeup-publish /></label>
      </td>
      <td><textarea data-field="notes" placeholder="Notes"></textarea></td>
    </tr>
  </template>

  <datalist id="college-team-options">
    <% (typeof collegeTeamNames !== "undefined" ? collegeTeamNames : []).forEach((team) => { %>
      <option value="<%= team %>"></option>
    <% }) %>
  </datalist>

  <div id="board-editor-delete-entry-modal" class="board-entry-delete-modal" role="dialog" aria-modal="true" aria-labelledby="board-entry-delete-title" aria-hidden="true">
    <div class="board-entry-delete-panel">
      <p class="board-entry-delete-kicker">Delete entry</p>
      <h2 id="board-entry-delete-title">Are you sure?</h2>
      <p>This cannot be undone.</p>
      <p class="board-entry-delete-target">Selected row: <strong data-delete-entry-name>this draft board entry</strong></p>
      <div class="board-entry-delete-actions">
        <button type="button" class="secondary-button" data-cancel-entry-delete>Cancel</button>
        <button type="button" class="danger-button" data-confirm-entry-delete>Delete entry</button>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const rows = document.querySelector("#board-editor-rows");
    const template = document.querySelector("#board-editor-row-template");
    const entryIdInput = document.querySelector("#big-board-entry-id");
    const form = document.querySelector("#big-board-editor-form");
    const tableWrap = document.querySelector(".board-editor-table-wrap");
    const stickyScroll = document.querySelector("[data-board-editor-sticky-scroll]");
    const stickyScrollSpacer = document.querySelector("[data-board-editor-sticky-scroll-spacer]");
    const deleteModal = document.querySelector("#board-editor-delete-entry-modal");
    const deleteEntryName = deleteModal?.querySelector("[data-delete-entry-name]");
    const cancelEntryDelete = deleteModal?.querySelector("[data-cancel-entry-delete]");
    const confirmEntryDelete = deleteModal?.querySelector("[data-confirm-entry-delete]");
    let pendingDeleteRow = null;
    let syncingHorizontalScroll = false;

    function nextIndex() {
      return rows.querySelectorAll("tr").length;
    }

    function entryId() {
      if (window.crypto && window.crypto.randomUUID) {
        return window.crypto.randomUUID();
      }
      return `draft-${Date.now()}-${Math.random().toString(16).slice(2)}`;
    }

    function reindexRows() {
      rows.querySelectorAll("tr").forEach((row, index) => {
        row.querySelectorAll("input[name], select[name], textarea[name]").forEach((field) => {
          field.name = field.name.replace(/^entries\[\d+\]\[(.+)\]$/, `entries[${index}][$1]`);
        });
      });
    }

    function markFormChanged() {
      form?.dispatchEvent(new Event("change", { bubbles: true }));
    }

    function syncStickyScrollSize() {
      if (!tableWrap || !stickyScroll || !stickyScrollSpacer) {
        return;
      }
      stickyScrollSpacer.style.width = `${tableWrap.scrollWidth}px`;
      stickyScroll.classList.toggle("is-active", tableWrap.scrollWidth > tableWrap.clientWidth + 1);
    }

    function syncHorizontalScroll(source, target) {
      if (!source || !target || syncingHorizontalScroll) {
        return;
      }
      syncingHorizontalScroll = true;
      target.scrollLeft = source.scrollLeft;
      window.requestAnimationFrame(() => {
        syncingHorizontalScroll = false;
      });
    }

    function formatHeightDisplay(feet, inches, fraction) {
      if (feet === "" || inches === "") {
        return "Height";
      }
      const fractionLabel = fraction === "" || Number(fraction) === 0
        ? ""
        : ` ${{
          0.125: "1/8",
          0.25: "1/4",
          0.375: "3/8",
          0.5: "1/2",
          0.625: "5/8",
          0.75: "3/4",
          0.875: "7/8",
        }[Number(fraction)] ?? ""}`;
      return `${feet}'${inches}${fractionLabel}"`;
    }

    function syncHeightPicker(picker) {
      const feet = picker.querySelector("[data-height-feet]")?.value || "";
      const inches = picker.querySelector("[data-height-inches]")?.value || "";
      const fraction = picker.querySelector("[data-height-fraction]")?.value || "0";
      const hidden = picker.querySelector("[data-height-label]");
      const display = picker.querySelector("[data-height-display]");
      if (!hidden) {
        return;
      }
      if (display) {
        display.textContent = formatHeightDisplay(feet, inches, fraction);
      }
      if (feet === "" || inches === "") {
        hidden.value = "";
        return;
      }
      const totalInches = Number(inches) + Number(fraction);
      hidden.value = `${feet}-${Number(totalInches.toFixed(3))}`;
    }

    function closeHeightPicker(picker) {
      picker.classList.remove("is-open");
      picker.querySelector("[data-height-toggle]")?.setAttribute("aria-expanded", "false");
      const panel = picker.querySelector("[data-height-panel]");
      panel?.setAttribute("aria-hidden", "true");
      if (panel) {
        panel.style.left = "";
        panel.style.top = "";
      }
    }

    function positionHeightPicker(picker) {
      const trigger = picker.querySelector("[data-height-toggle]");
      const panel = picker.querySelector("[data-height-panel]");
      if (!trigger || !panel) {
        return;
      }

      const gutter = 8;
      const triggerRect = trigger.getBoundingClientRect();
      const panelWidth = panel.offsetWidth || 256;
      const panelHeight = panel.offsetHeight || 104;
      const maxLeft = Math.max(gutter, window.innerWidth - panelWidth - gutter);
      const left = Math.min(Math.max(gutter, triggerRect.left), maxLeft);
      const hasRoomBelow = window.innerHeight - triggerRect.bottom >= panelHeight + gutter;
      const top = hasRoomBelow
        ? triggerRect.bottom + 4
        : Math.max(gutter, triggerRect.top - panelHeight - 4);

      panel.style.left = `${left}px`;
      panel.style.top = `${top}px`;
    }

    function openHeightPicker(picker) {
      document.querySelectorAll("[data-height-picker].is-open").forEach((openPicker) => {
        if (openPicker !== picker) {
          closeHeightPicker(openPicker);
        }
      });
      picker.classList.add("is-open");
      picker.querySelector("[data-height-toggle]")?.setAttribute("aria-expanded", "true");
      picker.querySelector("[data-height-panel]")?.setAttribute("aria-hidden", "false");
      positionHeightPicker(picker);
    }

    function positionOpenHeightPickers() {
      document.querySelectorAll("[data-height-picker].is-open").forEach(positionHeightPicker);
    }

    function wireHeightPicker(picker) {
      syncHeightPicker(picker);
      picker.querySelector("[data-height-toggle]")?.addEventListener("click", () => {
        if (picker.classList.contains("is-open")) {
          closeHeightPicker(picker);
          return;
        }
        openHeightPicker(picker);
      });
      picker.querySelectorAll("[data-height-feet], [data-height-inches], [data-height-fraction]").forEach((field) => {
        field.addEventListener("change", () => syncHeightPicker(picker));
      });
    }

    function wireRow(row, index, id) {
      row.querySelectorAll("[data-field]").forEach((field) => {
        field.name = `entries[${index}][${field.dataset.field}]`;
        if (field.dataset.field === "id") {
          field.value = id;
        }
      });
      row.querySelectorAll("[data-height-picker]").forEach(wireHeightPicker);
      row.querySelectorAll("[data-publish-entry]").forEach((button) => {
        button.dataset.publishEntry = id;
      });
    }

    document.querySelectorAll("[data-height-picker]").forEach(wireHeightPicker);

    document.addEventListener("click", (event) => {
      if (event.target.closest("[data-height-picker]")) {
        return;
      }
      document.querySelectorAll("[data-height-picker].is-open").forEach(closeHeightPicker);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") {
        return;
      }
      document.querySelectorAll("[data-height-picker].is-open").forEach(closeHeightPicker);
    });

    window.addEventListener("scroll", positionOpenHeightPickers, true);
    window.addEventListener("resize", positionOpenHeightPickers);

    function closeDeleteModal() {
      pendingDeleteRow?.classList.remove("is-delete-target");
      pendingDeleteRow = null;
      deleteModal?.classList.remove("is-open");
      deleteModal?.setAttribute("aria-hidden", "true");
    }

    function openDeleteModal(row) {
      pendingDeleteRow?.classList.remove("is-delete-target");
      pendingDeleteRow = row;
      row.classList.add("is-delete-target");
      const playerName = row.querySelector("input[name$='[playerName]']")?.value?.trim() || "this draft board entry";
      if (deleteEntryName) {
        deleteEntryName.textContent = playerName;
      }
      deleteModal?.classList.add("is-open");
      deleteModal?.setAttribute("aria-hidden", "false");
      confirmEntryDelete?.focus();
    }

    document.querySelector("[data-add-player]")?.addEventListener("click", () => {
      const id = entryId();
      const row = template.content.firstElementChild.cloneNode(true);
      wireRow(row, nextIndex(), id);
      rows.append(row);
      syncStickyScrollSize();
      row.querySelector("input:not([type='hidden'])")?.focus();
    });

    form?.addEventListener("click", (event) => {
      const deleteButton = event.target.closest("[data-delete-board-entry]");
      if (deleteButton) {
        const row = deleteButton.closest("tr");
        if (row) {
          openDeleteModal(row);
        }
        return;
      }

      const button = event.target.closest("[data-publish-entry]");
      if (!button) {
        return;
      }
      const row = button.closest("tr");
      const rowId = button.dataset.publishEntry || row?.querySelector("[data-entry-id]")?.value || "";
      entryIdInput.value = rowId;
    });

    cancelEntryDelete?.addEventListener("click", closeDeleteModal);

    deleteModal?.addEventListener("click", (event) => {
      if (event.target === deleteModal) {
        closeDeleteModal();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && deleteModal?.classList.contains("is-open")) {
        closeDeleteModal();
      }
    });

    confirmEntryDelete?.addEventListener("click", () => {
      if (!pendingDeleteRow) {
        closeDeleteModal();
        return;
      }
      const row = pendingDeleteRow;
      pendingDeleteRow = null;
      row.remove();
      reindexRows();
      syncStickyScrollSize();
      closeDeleteModal();
      markFormChanged();
    });

    tableWrap?.addEventListener("scroll", () => syncHorizontalScroll(tableWrap, stickyScroll));
    stickyScroll?.addEventListener("scroll", () => syncHorizontalScroll(stickyScroll, tableWrap));
    window.addEventListener("resize", syncStickyScrollSize);
    syncStickyScrollSize();

    function clearPublishState(event) {
      const field = event.target.closest("[data-publish-section]");
      if (!field) {
        return;
      }
      const row = field.closest("tr");
      const checkbox = field.dataset.publishSection === "player"
        ? row?.querySelector("[data-player-publish]")
        : row?.querySelector("[data-writeup-publish]");
      if (checkbox) {
        checkbox.checked = false;
      }
    }

    form?.addEventListener("input", clearPublishState);
    form?.addEventListener("change", clearPublishState);

    form?.addEventListener("htmx:afterSwap", (event) => {
      if (event.detail?.target?.id !== "big-board-save-status" || event.detail?.xhr?.status >= 400) {
        return;
      }
      const status = event.detail.target;
      if (!status.textContent?.toLowerCase().includes("autosaved")) {
        return;
      }
      status.textContent = `Autosaved at ${new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" })}`;
    });
  })();
</script>

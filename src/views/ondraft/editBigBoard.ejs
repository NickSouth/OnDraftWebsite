<%
  const heightFractionOptions = [
    { value: 0, label: "0" },
    { value: 0.125, label: " 1/8" },
    { value: 0.25, label: " 1/4" },
    { value: 0.375, label: " 3/8" },
    { value: 0.5, label: " 1/2" },
    { value: 0.625, label: " 5/8" },
    { value: 0.75, label: " 3/4" },
    { value: 0.875, label: " 7/8" },
  ];
  const heightFeetOptions = [5, 6, 7];
  const heightInchOptions = Array.from({ length: 12 }, (_, index) => index);
  const heightValue = (feet, inches) => `${feet}-${Number(inches.toFixed(3))}`;
  const selectedHeightValue = (height) => height ? heightValue(height.feet, height.inches) : "";
  const selectedHeightFeet = (height) => height ? height.feet : "";
  const selectedHeightInches = (height) => height ? Math.floor(height.inches) : "";
  const selectedHeightFraction = (height) => height ? Number((height.inches - Math.floor(height.inches)).toFixed(3)) : 0;
  const emptyEditorEntry = {
    id: "",
    playerName: "",
    position: "",
    school: "",
    rank: null,
    posRank: null,
    height: null,
    weight: null,
    playerInfoPublished: false,
    grade: null,
    gradePublished: false,
    writeup: {
      strengths: "",
      weaknesses: "",
      rundown: "",
    },
    writeupPublished: false,
    notes: "",
  };
  const teamHelmetSources = Object.fromEntries(
    Object.entries(typeof collegeTeamColors !== "undefined" ? collegeTeamColors : {}).map(([school, colors]) => {
      const key = typeof helmetColorKey !== "undefined" ? helmetColorKey(colors.primaryColor, colors.secondaryColor) : null;
      return [school, key ? `/generated/helmets/v1/${key}.png` : "/teamHelmetTemplate.png"];
    })
  );
  const helmetSourcesJson = JSON.stringify(teamHelmetSources).replace(/</g, "\\u003c");
%>

<div id="big-board-editor-fragment" data-big-board-editor-fragment>
<section class="plain-page board-editor-page od-admin-board-page">
  <div class="page-heading big-board-heading board-editor-heading od-admin-heading">
    <div>
      <a class="od-admin-back-link" href="/bigboard">Back to big board</a>
      <p>Draft Board Admin</p>
      <h1>Edit Big Board</h1>
    </div>
    <div class="big-board-heading-actions">
      <div class="board-class-tools">
        <div class="board-class-selector-row">
          <form
            class="big-board-controls"
            method="get"
            action="/bigboard/edit"
            hx-get="/bigboard/edit"
            hx-target="#big-board-editor-fragment"
            hx-swap="outerHTML"
            data-board-class-form
            data-use-global-loader
          >
            <label class="big-board-year-control">
              <span>Draft Class</span>
              <select name="year" onchange="this.form.requestSubmit();">
                <% years.forEach((year) => { %>
                  <option value="<%= year %>" <%= board.year === year ? "selected" : "" %>><%= year %></option>
                <% }) %>
              </select>
            </label>
            <input type="hidden" name="creator" value="<%= board.creator %>" />
            <div class="creator-toggle od-text-toggle-group" style="--od-toggle-count: <%= creators.length %>;" aria-label="Board creator">
              <% creators.forEach((creator) => { %>
                <button
                  type="button"
                  class="od-text-toggle <%= board.creator === creator ? "is-active" : "" %>"
                  aria-pressed="<%= board.creator === creator ? "true" : "false" %>"
                  onclick="this.form.creator.value = '<%= creator %>'; this.form.requestSubmit();"
                >
                  <%= creator %>
                </button>
              <% }) %>
            </div>
          </form>
        </div>
        <form class="create-board-year-form" method="post" action="/bigboard/years">
          <span>Create draft class</span>
          <input type="hidden" name="creator" value="<%= board.creator %>" />
          <input type="number" name="year" min="1900" max="2100" placeholder="Year" required />
          <button type="submit" class="secondary-button">Create</button>
        </form>
      </div>
    </div>
  </div>

  <form
    id="delete-board-year-form"
    class="delete-board-year-form"
    method="post"
    action="/bigboard/years/delete"
    onsubmit="return confirm('Are you sure? This will delete all boards from that year');"
  >
    <input type="hidden" name="year" value="<%= board.year %>" />
    <input type="hidden" name="creator" value="<%= board.creator %>" />
  </form>

  <% if (errorMessage) { %>
    <p class="od-admin-error" role="alert"><%= errorMessage %></p>
  <% } %>

  <div class="board-editor-form" id="big-board-editor-form">
    <div class="board-editor-toolbar">
      <div>
        <strong><%= board.year %> <%= board.creator %></strong>
        <span class="autosave-status-group">
          <span id="big-board-save-status" class="save-status"><%= statusMessage || "" %></span>
        </span>
      </div>
      <div class="board-editor-dirty-actions" data-board-dirty-actions hidden>
        <span class="board-editor-unsaved-label">Unsaved</span>
        <button type="button" class="board-editor-save-board-button" data-save-full-board>Save full board</button>
      </div>
    </div>

    <div class="board-editor-list-shell">
      <p class="board-editor-empty-state" data-board-editor-empty-state <%= board.entries.length > 0 ? "hidden" : "" %>>
        No players on this board yet.
      </p>
      <ol id="board-editor-cards" class="board-editor-card-list" data-board-editor-card-list>
        <% board.entries.forEach((entry, index) => { %>
          <%- include("partials/bigBoardEditorEntryCard", {
            board,
            entry,
            index,
            positions,
            heightFeetOptions,
            heightInchOptions,
            heightFractionOptions,
            selectedHeightValue,
            selectedHeightFeet,
            selectedHeightInches,
            selectedHeightFraction,
            collegeTeamColors,
            helmetColorKey,
            validationIssues,
            isTemplate: false,
          }) %>
        <% }) %>
      </ol>
    </div>

    <div class="board-editor-bottom-actions">
      <button type="button" class="secondary-button" data-add-player>Add Player</button>
      <div class="board-editor-bottom-save-actions">
        <a class="secondary-button" href="/bigboard?year=<%= board.year %>&creator=<%= encodeURIComponent(board.creator) %>">View board</a>
        <button
          type="submit"
          form="delete-board-year-form"
          class="danger-button delete-board-year-button"
          aria-label="Delete <%= board.year %> draft class"
        >
          Delete <%= board.year %>
        </button>
      </div>
    </div>
  </div>

  <template id="board-editor-card-template">
    <%- include("partials/bigBoardEditorEntryCard", {
      board,
      entry: emptyEditorEntry,
      index: 0,
      positions,
      heightFeetOptions,
      heightInchOptions,
      heightFractionOptions,
      selectedHeightValue,
      selectedHeightFeet,
      selectedHeightInches,
      selectedHeightFraction,
      collegeTeamColors,
      helmetColorKey,
      validationIssues: [],
      isTemplate: true,
    }) %>
  </template>

  <datalist id="college-team-options">
    <% (typeof collegeTeamNames !== "undefined" ? collegeTeamNames : []).forEach((team) => { %>
      <option value="<%= team %>"></option>
    <% }) %>
  </datalist>

  <div id="board-editor-delete-entry-modal" class="board-entry-delete-modal" role="dialog" aria-modal="true" aria-labelledby="board-entry-delete-title" aria-hidden="true">
    <div class="board-entry-delete-panel">
      <p class="board-entry-delete-kicker">Delete entry</p>
      <h2 id="board-entry-delete-title">Are you sure?</h2>
      <p>This cannot be undone.</p>
      <p class="board-entry-delete-target">Selected entry: <strong data-delete-entry-name>this draft board entry</strong></p>
      <div class="board-entry-delete-actions">
        <button type="button" class="secondary-button" data-cancel-entry-delete>Cancel</button>
        <button type="button" class="danger-button" data-confirm-entry-delete>Delete entry</button>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    window.__bigBoardEditorAbortController?.abort();
    const editorAbortController = new AbortController();
    window.__bigBoardEditorAbortController = editorAbortController;
    const editorListenerOptions = { signal: editorAbortController.signal };
    const FIELD_PREFIX = "entries[0]";
    const helmetSourcesBySchool = <%- helmetSourcesJson %>;
    const list = document.querySelector("#board-editor-cards");
    const template = document.querySelector("#board-editor-card-template");
    const addPlayerButton = document.querySelector("[data-add-player]");
    const emptyState = document.querySelector("[data-board-editor-empty-state]");
    const deleteModal = document.querySelector("#board-editor-delete-entry-modal");
    const deleteEntryName = deleteModal?.querySelector("[data-delete-entry-name]");
    const cancelEntryDelete = deleteModal?.querySelector("[data-cancel-entry-delete]");
    const confirmEntryDelete = deleteModal?.querySelector("[data-confirm-entry-delete]");
    const dirtyActions = document.querySelector("[data-board-dirty-actions]");
    const saveFullBoardButton = document.querySelector("[data-save-full-board]");
    const unsavedChangesMessage = "You have unsaved changes, are you sure you want to exit?";
    let pendingDeleteForm = null;
    let nativeSubmissionInProgress = false;
    let boardStructureDirty = document.querySelector("[data-big-board-editor-fragment]")?.dataset.boardStructureDirty === "true";

    function entryId() {
      if (window.crypto && window.crypto.randomUUID) {
        return window.crypto.randomUUID();
      }
      return `draft-${Date.now()}-${Math.random().toString(16).slice(2)}`;
    }

    function namedField(form, fieldName) {
      const field = form.elements.namedItem(`${FIELD_PREFIX}[${fieldName}]`);
      return field && "value" in field ? field : null;
    }

    function fieldValue(form, fieldName) {
      return namedField(form, fieldName)?.value?.trim() || "";
    }

    function setFieldValue(form, fieldName, value) {
      const field = namedField(form, fieldName);
      if (field) {
        field.value = value;
      }
    }

    function serializeForm(form) {
      const pairs = [];
      new FormData(form).forEach((value, name) => {
        if (name === "expandWriteup" || name === "expandGrade") {
          return;
        }
        pairs.push(`${encodeURIComponent(name)}=${encodeURIComponent(String(value))}`);
      });
      return pairs.sort().join("&");
    }

    function formatHeightDisplay(feet, inches, fraction) {
      if (feet === "" || inches === "") {
        return "Height TBD";
      }
      const fractionLabel = fraction === "" || Number(fraction) === 0
        ? ""
        : ` ${{
          0.125: "1/8",
          0.25: "1/4",
          0.375: "3/8",
          0.5: "1/2",
          0.625: "5/8",
          0.75: "3/4",
          0.875: "7/8",
        }[Number(fraction)] ?? ""}`;
      return `${feet}'${inches}${fractionLabel}"`;
    }

    function syncHeightPicker(picker) {
      const feet = picker.querySelector("[data-height-feet]")?.value || "";
      const inches = picker.querySelector("[data-height-inches]")?.value || "";
      const fraction = picker.querySelector("[data-height-fraction]")?.value || "0";
      const hidden = picker.querySelector("[data-height-label]");
      const label = picker.querySelector(".board-editor-field-label");
      if (label) {
        label.textContent = `Height`;
        label.title = formatHeightDisplay(feet, inches, fraction);
      }
      if (!hidden) {
        return;
      }
      if (feet === "" || inches === "") {
        hidden.value = "";
        return;
      }
      const totalInches = Number(inches) + Number(fraction);
      hidden.value = `${feet}-${Number(totalInches.toFixed(3))}`;
    }

    function displayValue(editable) {
      const input = editable.querySelector("[data-edit-input]");
      const value = input?.value?.trim() || "";
      if (!value) {
        return editable.dataset.emptyLabel || "";
      }
      return `${value}${editable.dataset.suffix || ""}`;
    }

    function syncEditableDisplay(editable) {
      const display = editable.querySelector("[data-field-display]");
      if (display) {
        display.textContent = displayValue(editable);
      }
    }

    function openEditable(editable) {
      if (!editable) {
        return;
      }
      const input = editable.querySelector("[data-edit-input]");
      const display = editable.querySelector("[data-field-display]");
      if (!input) {
        return;
      }
      editable.dataset.editing = "true";
      input.hidden = false;
      if (display) {
        display.hidden = true;
      }
      input.focus();
      if (input.type !== "number") {
        input.select();
      }
    }

    function closeEditable(editable) {
      if (!editable) {
        return;
      }
      const input = editable.querySelector("[data-edit-input]");
      const display = editable.querySelector("[data-field-display]");
      syncEditableDisplay(editable);
      editable.dataset.editing = "false";
      if (input) {
        input.hidden = true;
      }
      if (display) {
        display.hidden = false;
      }
    }

    function hasAnyPlayerContent(form) {
      return ["rank", "playerName", "school", "position", "posRank", "heightLabel", "weight"]
        .some((fieldName) => fieldValue(form, fieldName) !== "");
    }

    function hasAnyWriteupContent(form) {
      return ["strengths", "weaknesses", "rundown"].some((fieldName) => fieldValue(form, fieldName) !== "");
    }

    function hasAnyGradeContent(form) {
      const gradeFields = Array.from(form.querySelectorAll("[name^='entries[0][grade]']"));
      return gradeFields.some((field) => {
        if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) {
          return false;
        }
        if (field.name.endsWith("[position]") || field.name.endsWith("[archetype]")) {
          return false;
        }
        return field.value.trim() !== "";
      });
    }

    function setButtonsHidden(form, selector, hidden) {
      form.querySelectorAll(selector).forEach((button) => {
        button.hidden = hidden;
      });
    }

    function setPanelState(form, panelName, expanded) {
      const stateField = panelName === "grade"
        ? form.querySelector("[data-expand-grade-state]")
        : form.querySelector("[data-expand-writeup-state]");
      if (stateField) {
        stateField.value = expanded ? "true" : "false";
      }
    }

    function syncPublishChips(form) {
      const playerPublished = form.querySelector("[data-player-publish]")?.value === "true";
      const gradePublished = form.querySelector("[data-grade-publish]")?.value === "true";
      const writeupPublished = form.querySelector("[data-writeup-publish]")?.value === "true";
      const playerChip = form.querySelector("[data-player-publish-chip]");
      const gradeChip = form.querySelector("[data-grade-publish-chip]");
      const writeupChip = form.querySelector("[data-writeup-publish-chip]");
      if (playerChip) {
        playerChip.dataset.state = playerPublished ? "published" : "draft";
        playerChip.textContent = playerPublished ? "Info published" : "Info draft";
      }
      if (writeupChip) {
        writeupChip.dataset.state = writeupPublished ? "published" : "draft";
        writeupChip.textContent = writeupPublished ? "Profile published" : "Profile draft";
      }
      if (gradeChip) {
        gradeChip.dataset.state = gradePublished ? "published" : "draft";
        gradeChip.textContent = gradePublished ? "Grade published" : "Grade draft";
      }
    }

    function syncHelmet(form) {
      const school = fieldValue(form, "school");
      const helmet = form.querySelector("[data-team-helmet]");
      if (!helmet) {
        return;
      }
      const nextSource = helmetSourcesBySchool[school] || "/teamHelmetTemplate.png";
      helmet.dataset.generatedHelmetSrc = nextSource;
      helmet.dataset.recoloredHelmet = "true";
      helmet.src = nextSource;
      helmet.style.opacity = "1";
      helmet.alt = school ? `${school} football helmet` : "Draft board player helmet";
    }

    function syncDeleteLabel(form) {
      const deleteButton = form.querySelector("[data-delete-board-entry]");
      const playerName = fieldValue(form, "playerName") || "draft board entry";
      if (deleteButton) {
        deleteButton.setAttribute("aria-label", `Delete ${playerName}`);
      }
    }

    function updateEmptyState() {
      if (!emptyState || !list) {
        return;
      }
      emptyState.hidden = Boolean(list.querySelector("[data-board-entry-form]"));
    }

    function hasDirtyEntries() {
      return Boolean(document.querySelector("[data-board-entry-form][data-dirty='true']"));
    }

    function hasUnsavedBoardChanges() {
      return boardStructureDirty || hasDirtyEntries();
    }

    function markBoardStructureDirty() {
      boardStructureDirty = true;
      const editorFragment = document.querySelector("[data-big-board-editor-fragment]");
      if (editorFragment) {
        editorFragment.dataset.boardStructureDirty = "true";
      }
      updateBoardDirtyState();
    }

    function updateBoardDirtyState() {
      if (!dirtyActions) {
        return;
      }
      dirtyActions.hidden = !hasUnsavedBoardChanges();
    }

    function scrollToFirstValidationError() {
      const erroredForm = document.querySelector("[data-board-entry-form][data-has-validation-error='true']");
      const erroredEntry = erroredForm?.closest("[data-board-entry-item]");
      if (!erroredEntry) {
        return;
      }
      window.requestAnimationFrame(() => {
        window.setTimeout(() => {
          erroredEntry.scrollIntoView({ block: "center", behavior: "smooth" });
        }, 0);
      });
    }

    function hideGlobalLoader() {
      window.dispatchEvent(new CustomEvent("ondraft:hide-global-loader"));
    }

    function appendHiddenInput(form, name, value) {
      const input = document.createElement("input");
      input.type = "hidden";
      input.name = name;
      input.value = value;
      form.append(input);
    }

    function appendEntryFields(targetForm, sourceForm, index) {
      const nextPrefix = `entries[${index}]`;
      const sourcePrefixPattern = /^entries\[\d+\]\[(.+)\]$/;
      const seen = new Set();
      new FormData(sourceForm).forEach((value, name) => {
        const match = name.match(sourcePrefixPattern);
        if (!match) {
          return;
        }
        const nextName = `${nextPrefix}[${match[1]}]`;
        seen.add(nextName);
        appendHiddenInput(targetForm, nextName, String(value));
      });
      ["id", "playerInfoPublished", "gradePublished", "writeupPublished", "playerName", "school", "position", "rank", "posRank", "heightLabel", "weight", "strengths", "weaknesses", "rundown", "notes"].forEach((fieldName) => {
        const nextName = `${nextPrefix}[${fieldName}]`;
        if (!seen.has(nextName)) {
          appendHiddenInput(targetForm, nextName, "");
        }
      });
    }

    function submitFullBoard() {
      const form = document.createElement("form");
      form.method = "post";
      form.action = "/bigboard/edit";
      form.setAttribute("hx-post", "/bigboard/edit");
      form.setAttribute("hx-target", "#big-board-editor-fragment");
      form.setAttribute("hx-swap", "outerHTML");
      form.setAttribute("data-skip-global-loader", "");
      form.hidden = true;
      appendHiddenInput(form, "year", "<%= board.year %>");
      appendHiddenInput(form, "creator", "<%= board.creator %>");
      document.querySelectorAll("[data-board-entry-form]").forEach((entryForm, index) => {
        if (entryForm instanceof HTMLFormElement) {
          appendEntryFields(form, entryForm, index);
        }
      });
      document.body.append(form);
      form.addEventListener("htmx:afterRequest", () => form.remove(), { once: true });
      if (window.htmx) {
        window.htmx.process(form);
      } else {
        nativeSubmissionInProgress = true;
      }
      form.requestSubmit();
    }

    function updateFormState(form) {
      form.querySelectorAll("[data-editable-field]").forEach(syncEditableDisplay);
      form.querySelectorAll("[data-height-picker]").forEach(syncHeightPicker);
      syncHelmet(form);
      syncDeleteLabel(form);
      syncPublishChips(form);

      const dirty = form.dataset.newEntry === "true" || serializeForm(form) !== form.dataset.initialState;
      form.dataset.dirty = dirty ? "true" : "false";
      setButtonsHidden(form, "[data-save-entry]", !dirty);

      const playerPublished = form.querySelector("[data-player-publish]")?.value === "true";
      const gradePublished = form.querySelector("[data-grade-publish]")?.value === "true";
      const writeupPublished = form.querySelector("[data-writeup-publish]")?.value === "true";
      const showPlayerPublish = !playerPublished && hasAnyPlayerContent(form);
      const showGradePublish = !gradePublished && hasAnyGradeContent(form);
      const showWriteupPublish = !writeupPublished && hasAnyWriteupContent(form);
      setButtonsHidden(form, "[data-publish-player]", !showPlayerPublish);
      setButtonsHidden(form, "[data-publish-grade]", !showGradePublish);
      setButtonsHidden(form, "[data-publish-writeup]", !showWriteupPublish);
      form.dataset.actionsVisible = dirty || showPlayerPublish || showGradePublish || showWriteupPublish ? "true" : "false";
      updateBoardDirtyState();
    }

    function clearPublishState(event, form) {
      const field = event.target.closest("[data-publish-section]");
      if (!field) {
        return;
      }
      const publishState = field.dataset.publishSection === "player"
        ? form.querySelector("[data-player-publish]")
        : field.dataset.publishSection === "grade"
          ? form.querySelector("[data-grade-publish]")
          : form.querySelector("[data-writeup-publish]");
      if (publishState) {
        publishState.value = "false";
      }
    }

    function wireEditableField(editable, form) {
      const input = editable.querySelector("[data-edit-input]");
      editable.querySelector("[data-edit-toggle]")?.addEventListener("click", () => openEditable(editable));
      input?.addEventListener("blur", () => {
        closeEditable(editable);
        updateFormState(form);
      });
      input?.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== "Escape") {
          return;
        }
        event.preventDefault();
        closeEditable(editable);
        updateFormState(form);
      });
    }

    function toggleProfilePanel(form) {
      const panel = form.querySelector("[data-profile-panel]");
      const button = form.querySelector("[data-expand-entry]");
      if (!panel || !button) {
        return;
      }
      const opening = panel.hidden;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (opening) {
        panel.hidden = false;
        if (!reduceMotion) {
          panel.style.height = "0px";
          panel.style.opacity = "0";
          panel.offsetHeight;
          panel.style.transition = "height 220ms ease, opacity 180ms ease";
          panel.style.height = `${panel.scrollHeight}px`;
          panel.style.opacity = "1";
          window.setTimeout(() => {
            panel.style.height = "";
            panel.style.transition = "";
          }, 230);
        }
      } else if (reduceMotion) {
        panel.hidden = true;
      } else {
        panel.style.height = `${panel.scrollHeight}px`;
        panel.style.opacity = "1";
        panel.offsetHeight;
        panel.style.transition = "height 200ms ease, opacity 160ms ease";
        panel.style.height = "0px";
        panel.style.opacity = "0";
        window.setTimeout(() => {
          panel.hidden = true;
          panel.style.height = "";
          panel.style.opacity = "";
          panel.style.transition = "";
        }, 210);
      }
      button.setAttribute("aria-expanded", String(opening));
      form.dataset.expanded = opening ? "true" : "false";
      setPanelState(form, "writeup", opening);
    }

    function toggleGradePanel(form) {
      const panel = form.querySelector("[data-grade-panel]");
      const button = form.querySelector("[data-expand-grade]");
      if (!panel || !button) {
        return;
      }
      const opening = panel.hidden;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (opening) {
        panel.hidden = false;
        if (!reduceMotion) {
          panel.style.height = "0px";
          panel.style.opacity = "0";
          panel.offsetHeight;
          panel.style.transition = "height 220ms ease, opacity 180ms ease";
          panel.style.height = `${panel.scrollHeight}px`;
          panel.style.opacity = "1";
          window.setTimeout(() => {
            panel.style.height = "";
            panel.style.transition = "";
          }, 230);
        }
      } else if (reduceMotion) {
        panel.hidden = true;
      } else {
        panel.style.height = `${panel.scrollHeight}px`;
        panel.style.opacity = "1";
        panel.offsetHeight;
        panel.style.transition = "height 200ms ease, opacity 160ms ease";
        panel.style.height = "0px";
        panel.style.opacity = "0";
        window.setTimeout(() => {
          panel.hidden = true;
          panel.style.height = "";
          panel.style.opacity = "";
          panel.style.transition = "";
        }, 210);
      }
      button.setAttribute("aria-expanded", String(opening));
      form.dataset.gradeExpanded = opening ? "true" : "false";
      setPanelState(form, "grade", opening);
    }

    function openDeleteModal(form) {
      pendingDeleteForm = form;
      const playerName = fieldValue(form, "playerName") || "this draft board entry";
      if (deleteEntryName) {
        deleteEntryName.textContent = playerName;
      }
      deleteModal?.classList.add("is-open");
      deleteModal?.setAttribute("aria-hidden", "false");
      confirmEntryDelete?.focus();
    }

    function closeDeleteModal() {
      pendingDeleteForm = null;
      deleteModal?.classList.remove("is-open");
      deleteModal?.setAttribute("aria-hidden", "true");
    }

    function initializeForm(form) {
      if (form.dataset.initialized === "true") {
        return;
      }
      form.dataset.initialized = "true";
      form.querySelectorAll("[data-height-picker]").forEach(syncHeightPicker);
      form.querySelectorAll("[data-editable-field]").forEach((editable) => wireEditableField(editable, form));
      form.querySelector("[data-expand-entry]")?.addEventListener("click", () => toggleProfilePanel(form));
      form.querySelector("[data-expand-grade]")?.addEventListener("click", () => toggleGradePanel(form));
      form.querySelector("[data-delete-board-entry]")?.addEventListener("click", () => openDeleteModal(form));
      form.addEventListener("input", (event) => {
        clearPublishState(event, form);
        updateFormState(form);
      });
      form.addEventListener("change", (event) => {
        clearPublishState(event, form);
        updateFormState(form);
      });
      form.addEventListener("submit", (event) => {
        const submitter = event.submitter;
        nativeSubmissionInProgress = !(submitter instanceof HTMLElement && submitter.hasAttribute("hx-post"));
      });
      form.dataset.initialState = serializeForm(form);
      setPanelState(form, "writeup", form.dataset.expanded === "true");
      setPanelState(form, "grade", form.dataset.gradeExpanded === "true");
      updateFormState(form);
      if (form.dataset.newEntry !== "true") {
        form.dataset.initialState = serializeForm(form);
        updateFormState(form);
      }
    }

    function initializeFormsIn(root) {
      root.querySelectorAll("[data-board-entry-form]").forEach(initializeForm);
    }

    initializeFormsIn(document);
    updateEmptyState();

    addPlayerButton?.addEventListener("click", () => {
      if (!list || !template) {
        return;
      }
      const fragment = template.content.cloneNode(true);
      const item = fragment.querySelector("[data-board-entry-item]");
      const form = fragment.querySelector("[data-board-entry-form]");
      const id = entryId();
      if (!form || !item) {
        return;
      }
      form.dataset.newEntry = "true";
      form.dataset.persistedEntry = "false";
      form.querySelector("[data-entry-id]").value = id;
      form.querySelector("[data-entry-action-id]").value = id;
      setFieldValue(form, "id", id);
      list.append(fragment);
      initializeForm(form);
      if (window.htmx) {
        window.htmx.process(item);
      }
      updateEmptyState();
      item.scrollIntoView({ block: "nearest", behavior: "smooth" });
      openEditable(form.querySelector("[data-field-key='playerName']")?.closest("[data-editable-field]"));
    });

    cancelEntryDelete?.addEventListener("click", closeDeleteModal);
    deleteModal?.addEventListener("click", (event) => {
      if (event.target === deleteModal) {
        closeDeleteModal();
      }
    }, editorListenerOptions);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && deleteModal?.classList.contains("is-open")) {
        closeDeleteModal();
      }
    }, editorListenerOptions);

    confirmEntryDelete?.addEventListener("click", () => {
      if (!pendingDeleteForm) {
        closeDeleteModal();
        return;
      }
      const form = pendingDeleteForm;
      if (form.dataset.persistedEntry !== "true") {
        form.closest("[data-board-entry-item]")?.remove();
        closeDeleteModal();
        updateEmptyState();
        updateBoardDirtyState();
        return;
      }
      markBoardStructureDirty();
      form.action = "/bigboard/edit/delete-entry";
      const deleteSubmit = form.querySelector("[data-delete-submit]");
      closeDeleteModal();
      if (deleteSubmit instanceof HTMLElement) {
        deleteSubmit.click();
        return;
      }
      nativeSubmissionInProgress = true;
      form.submit();
    });

    document.body.addEventListener("htmx:afterSwap", (event) => {
      initializeFormsIn(document);
      updateEmptyState();
      updateBoardDirtyState();
      const target = event.detail?.target;
      if (target instanceof Element && target.matches("#big-board-editor-fragment")) {
        scrollToFirstValidationError();
      }
    }, editorListenerOptions);

    document.body.addEventListener("htmx:afterRequest", () => {
      nativeSubmissionInProgress = false;
    }, editorListenerOptions);

    document.body.addEventListener("htmx:beforeRequest", (event) => {
      const source = event.detail?.elt || event.target;
      if (source instanceof Element && source.closest("[data-delete-submit]")) {
        markBoardStructureDirty();
        return;
      }
      if (!(source instanceof Element) || !source.closest("[data-board-class-form]") || !hasUnsavedBoardChanges()) {
        return;
      }
      if (window.confirm(unsavedChangesMessage)) {
        return;
      }
      event.preventDefault();
      hideGlobalLoader();
    }, editorListenerOptions);

    saveFullBoardButton?.addEventListener("click", submitFullBoard);
    scrollToFirstValidationError();

    document.addEventListener("click", (event) => {
      if (!hasUnsavedBoardChanges() || event.defaultPrevented) {
        return;
      }
      const link = event.target instanceof Element ? event.target.closest("a[href]") : null;
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }
      if (link.target && link.target !== "_self") {
        return;
      }
      const href = link.getAttribute("href");
      if (!href || href.startsWith("#") || href.startsWith("mailto:") || href.startsWith("tel:")) {
        return;
      }
      if (window.confirm(unsavedChangesMessage)) {
        nativeSubmissionInProgress = true;
        return;
      }
      event.preventDefault();
      event.stopImmediatePropagation();
      hideGlobalLoader();
    }, { capture: true, signal: editorAbortController.signal });

    window.addEventListener("beforeunload", (event) => {
      if (!hasUnsavedBoardChanges() || nativeSubmissionInProgress) {
        return;
      }
      event.preventDefault();
      event.returnValue = unsavedChangesMessage;
    }, editorListenerOptions);
  })();
</script>
</div>

<section class="od-admin-page">
  <div class="od-admin-heading">
    <div>
      <a class="od-admin-back-link" href="/videos">Back to videos</a>
      <p>Admin</p>
      <h1><%= typeof heading === "string" ? heading : "Add YouTube Video" %></h1>
    </div>
  </div>

  <% if (errorMessage) { %>
    <p class="od-admin-error" role="alert"><%= errorMessage %></p>
  <% } %>

  <form class="ondraft-form od-admin-form" method="post" action="<%= typeof formAction === "string" ? formAction : "/videos" %>">
    <label>
      YouTube URL
      <input name="youtubeUrl" value="<%= values.youtubeUrl || "" %>" placeholder="https://www.youtube.com/watch?v=..." required />
    </label>

    <label>
      Title
      <input name="title" value="<%= values.title || "" %>" required />
    </label>

    <label>
      Description
      <textarea name="description" required><%= values.description || "" %></textarea>
    </label>

    <%
      const selectedVideoTags = (values.tags || "").split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean);
      const videoTagOptions = [...new Set([...(existingTags || []), ...selectedVideoTags])].sort((first, second) => first.localeCompare(second));
    %>
    <div class="tag-editor" data-tag-editor>
      <label for="video-tag-entry">Tags</label>
      <div class="tag-editor-box">
        <div class="tag-chip-list" data-tag-list></div>
        <input id="video-tag-entry" data-tag-input autocomplete="off" placeholder="Add a new tag" />
        <button
          type="button"
          class="tag-editor-toggle"
          data-tag-toggle
          aria-expanded="false"
          aria-controls="video-tag-options"
        >
          Existing tags
          <span data-tag-count>Any tags</span>
        </button>
      </div>
      <input type="hidden" name="tags" value="<%= values.tags || "" %>" data-tag-value />
      <div id="video-tag-options" class="tag-editor-menu" data-tag-menu hidden>
        <% if (videoTagOptions.length > 0) { %>
          <div class="tag-option-list">
            <% videoTagOptions.forEach((tag) => { %>
              <label class="tag-option">
                <input type="checkbox" value="<%= tag %>" data-tag-checkbox <%= selectedVideoTags.includes(tag) ? "checked" : "" %> />
                <span><%= tag %></span>
              </label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="tag-empty">No saved video tags yet.</p>
        <% } %>
      </div>
    </div>

    <div class="form-actions od-admin-actions">
      <button type="submit"><%= typeof submitLabel === "string" ? submitLabel : "Add video" %></button>
      <a class="button-link secondary-link" href="/videos">Cancel</a>
    </div>
  </form>
</section>

<script src="/articleTags.js" defer></script>

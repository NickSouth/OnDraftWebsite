<section class="plain-page form-page">
  <p><a href="/videos">Back to videos</a></p>
  <p class="eyebrow">Admin</p>
  <h1>Add YouTube Video</h1>

  <% if (errorMessage) { %>
    <p class="error-message"><%= errorMessage %></p>
  <% } %>

  <form class="ondraft-form" method="post" action="/videos">
    <label>
      YouTube URL
      <input name="youtubeUrl" value="<%= values.youtubeUrl || "" %>" placeholder="https://www.youtube.com/watch?v=..." required />
    </label>

    <label>
      Title
      <input name="title" value="<%= values.title || "" %>" required />
    </label>

    <label>
      Description
      <textarea name="description" required><%= values.description || "" %></textarea>
    </label>

    <label>
      Tags
      <input name="tags" value="<%= values.tags || "" %>" placeholder="draft,film-room" />
    </label>

    <div class="form-actions">
      <button type="submit">Add video</button>
      <a class="button-link secondary-link" href="/videos">Cancel</a>
    </div>
  </form>
</section>

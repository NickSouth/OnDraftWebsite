<section class="od-admin-page max-w-none overflow-hidden">
  <div class="od-admin-heading">
    <div>
      <p>Admin</p>
      <h1>Admin Dashboard</h1>
      <p class="mt-3 max-w-2xl normal-case tracking-normal text-slate-600 dark:text-slate-300">Manage publishing, audience, and site operations from one place.</p>
    </div>
  </div>

  <div class="mb-5 -mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0" role="tablist" aria-label="Admin dashboard">
    <div class="od-text-toggle-group min-w-max sm:min-w-[44rem]" style="--od-toggle-count: 4;">
      <% tabs.forEach((tab) => { %>
        <a
          href="/admin?tab=<%= tab.id %>"
          class="od-text-toggle <%= tab.active ? "is-active" : "" %>"
          role="tab"
          aria-selected="<%= tab.active ? "true" : "false" %>"
          hx-get="<%= tab.href %>"
          hx-target="#admin-dashboard-panel"
          hx-swap="innerHTML"
          onclick="this.closest('.od-text-toggle-group').querySelectorAll('.od-text-toggle').forEach((toggle) => { toggle.classList.remove('is-active'); toggle.setAttribute('aria-selected', 'false'); }); this.classList.add('is-active'); this.setAttribute('aria-selected', 'true');"
        ><%= tab.label %></a>
      <% }) %>
    </div>
  </div>

  <div id="admin-dashboard-panel" class="min-h-[28rem]">
    <% if (activeTab === "content") { %>
      <%- include("partials/adminCreateContent") %>
    <% } else if (activeTab === "newsletter") { %>
      <div hx-get="/admin/tabs/newsletter" hx-trigger="load" hx-swap="outerHTML">
        <%- include("partials/adminNewsletter", { articles: [], videos: [], newsletters: [], flashMessage: null, errorMessage: null, values: {} }) %>
      </div>
    <% } else if (activeTab === "analytics") { %>
      <div hx-get="/admin/tabs/analytics?period=<%= typeof analyticsPeriod !== "undefined" ? analyticsPeriod : "month" %>&category=<%= typeof analyticsCategory !== "undefined" ? analyticsCategory : "all" %>" hx-trigger="load" hx-swap="outerHTML">
        <%- include("partials/adminAnalytics", { period: typeof analyticsPeriod !== "undefined" ? analyticsPeriod : "month", category: typeof analyticsCategory !== "undefined" ? analyticsCategory : "all", summary: null, diagnostics: null, errorMessage: null }) %>
      </div>
    <% } else { %>
      <div hx-get="/admin/tabs/users" hx-trigger="load" hx-swap="outerHTML">
        <div class="od-card p-6 text-sm font-semibold text-slate-600 dark:text-slate-300">Loading users...</div>
      </div>
    <% } %>
  </div>
</section>

<%
  const pageTitle = modal === "privacy"
    ? "Privacy Policy"
    : modal === "terms"
      ? "Terms and Community Guidelines"
      : "Contact";
%>

<section class="mx-auto grid max-w-4xl gap-8 py-8">
  <header>
    <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">OnDraft</p>
    <h1 class="mt-3 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl"><%= pageTitle %></h1>
  </header>

  <article class="od-card p-5 text-base leading-7 text-slate-700 dark:text-slate-200 sm:p-7">
    <% if (modal === "contact") { %>
      <div class="grid gap-4">
        <p>For all business inquiries or suggestions, contact <a class="od-focus-ring rounded font-bold text-draft-amber hover:text-draft-gold dark:text-draft-gold" href="mailto:ondraft@ondraftfootball.com">ondraft@ondraftfootball.com</a>.</p>
        <p>For support, questions, feedback, privacy requests, or account deletion help, contact <a class="od-focus-ring rounded font-bold text-draft-amber hover:text-draft-gold dark:text-draft-gold" href="mailto:support@ondraftfootball.com">support@ondraftfootball.com</a>.</p>
      </div>
    <% } else if (modal === "terms") { %>
      <div class="grid gap-6">
        <p>Use OnDraft Football for football discussion, draft analysis, and community conversation in good faith.</p>
        <section class="grid gap-3">
          <h2 class="font-display text-2xl font-black text-slate-950 dark:text-white">Community Guidelines</h2>
          <ul class="list-disc space-y-1 pl-5">
            <li>Do not post harassment, threats, hate, spam, impersonation, or illegal content.</li>
            <li>Keep comments and hot takes focused on football, scouting, media, and the OnDraft community.</li>
            <li>Admins may remove content, restrict accounts, or ban users to protect the site and community.</li>
            <li>Use report or support channels when content appears abusive, unsafe, or legally sensitive.</li>
          </ul>
        </section>
        <section class="grid gap-3">
          <h2 class="font-display text-2xl font-black text-slate-950 dark:text-white">Account and Content Terms</h2>
          <p>You are responsible for content you submit. By posting, you give OnDraft permission to display that content on the website. You may request account deletion from settings or by contacting support.</p>
          <p>OnDraft Football is an independent media website and is not affiliated with, endorsed by, sponsored by, or officially connected to any football team, league, conference, school, or governing body.</p>
        </section>
      </div>
    <% } else { %>
      <%- include("partials/privacyPolicyContent") %>
    <% } %>
  </article>
</section>

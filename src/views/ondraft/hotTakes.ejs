<section
  class="mx-auto grid w-full max-w-5xl gap-5 sm:gap-8"
  x-data="{
    composerOpen: <%= errorMessage ? "true" : "false" %>,
    toggleComposer() {
      this.composerOpen = !this.composerOpen;
      this.$nextTick(() => {
        if (this.composerOpen) {
          this.$refs.hotTakeContent?.focus();
        } else {
          this.$refs.hotTakeToggle?.focus();
        }
      });
    }
  }"
  @keydown.escape="if (composerOpen) { composerOpen = false; $nextTick(() => $refs.hotTakeToggle?.focus()) }"
>
  <div class="flex flex-col gap-3 border-b border-slate-200 pb-4 dark:border-white/10 sm:flex-row sm:items-end sm:justify-between sm:gap-4 sm:pb-6">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">The Taproom</p>
      <h1 class="mt-1.5 font-display text-3xl font-black leading-tight text-slate-950 dark:text-white sm:mt-2 sm:text-5xl">
        Hot Takes
      </h1>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300 sm:mt-3 sm:text-base sm:leading-7">
        Our forum for community takes. Post your own or read what others are saying about the latest in NFL and NFL Draft news and analysis.
      </p>
    </div>
    <button
      type="button"
      x-ref="hotTakeToggle"
      class="od-primary-link w-full sm:w-auto"
      :class="composerOpen ? 'border border-slate-300 bg-white text-slate-900 hover:bg-slate-50 dark:border-white/15 dark:bg-white/10 dark:text-white dark:hover:bg-white/15' : ''"
      @click="toggleComposer()"
      :aria-expanded="composerOpen.toString()"
      aria-controls="hot-take-composer-panel"
      :aria-label="composerOpen ? 'Close hot take form' : 'Add hot take'"
    >
      <span x-show="!composerOpen">Add Hot Take</span>
      <span x-cloak x-show="composerOpen" class="text-xl leading-none" aria-hidden="true">&times;</span>
    </button>
  </div>

  <div id="hot-take-composer-panel" x-show="composerOpen" x-collapse>
    <%- include("partials/hotTakeComposer", { session, errorMessage, values, activeUserBan }) %>
  </div>

  <form
    id="hot-take-filter-form"
    class="article-filter-form od-page-tools od-list-controls"
    data-keyword="<%= values.keyword || "" %>"
    hx-get="/hottakes/filter"
    hx-target="#hot-take-list"
    hx-swap="outerHTML"
    hx-indicator="#hot-take-results-loading"
    data-skip-global-loader
    data-loading-skeleton="hot-takes"
    data-loading-skeleton-target="#hot-take-list"
    x-data="{
      searchOpen: false,
      keyword: $el.dataset.keyword || '',
      searchedKeyword: ($el.dataset.keyword || '').trim(),
      searchTimer: null,
      get hasKeyword() { return this.keyword.trim().length > 0 },
      get searchDirty() { return this.keyword.trim() !== this.searchedKeyword },
      openSearch() {
        this.searchOpen = true;
        this.$nextTick(() => this.$refs.hotTakeSearch?.focus());
      },
      closeSearch() {
        this.searchOpen = false;
        this.$nextTick(() => this.$refs.hotTakeSearchTrigger?.focus());
      },
      requestSubmit() {
        htmx.trigger(this.$refs.hotTakeFilterForm, 'submit');
      },
      queueSearchSubmit() {
        window.clearTimeout(this.searchTimer);
        this.searchTimer = window.setTimeout(() => {
          if (this.keyword.trim() === this.searchedKeyword) return;
          this.submitSearch();
        }, 240);
      },
      submitSearch() {
        this.searchedKeyword = this.keyword.trim();
        this.requestSubmit();
      },
      clearSearch() {
        this.keyword = '';
        this.submitSearch();
        this.$nextTick(() => this.$refs.hotTakeSearch?.focus());
      }
    }"
    x-ref="hotTakeFilterForm"
    @submit="searchedKeyword = keyword.trim()"
    @keydown.escape.window="if (searchOpen) { closeSearch() }"
  >
    <div class="od-toolbar-stack">
      <div class="od-toolbar-topline">
        <div></div>
        <div class="od-toolbar-actions">
          <div class="od-search-dock" :class="searchOpen ? 'is-open' : ''">
            <button
              type="button"
              class="od-search-dock-trigger"
              x-ref="hotTakeSearchTrigger"
              x-show="!searchOpen"
              x-transition.opacity.duration.150ms
              :aria-expanded="String(searchOpen)"
              aria-controls="hot-take-search-panel"
              aria-label="Search hot takes"
              title="Search hot takes"
              @click="openSearch()"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </button>
            <div
              id="hot-take-search-panel"
              class="od-search-dock-field"
              x-cloak
              x-show="searchOpen"
              x-transition.opacity.duration.180ms
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <label class="sr-only" for="hot-take-search-input">Search hot takes</label>
              <input
                id="hot-take-search-input"
                class="od-search-dock-input"
                x-ref="hotTakeSearch"
                x-model="keyword"
                name="keyword"
                type="search"
                placeholder="Search hot takes"
                @input="queueSearchSubmit()"
                @keydown.enter.prevent="submitSearch()"
              />
              <div class="od-search-dock-actions">
                <button
                  type="button"
                  class="od-search-dock-action"
                  x-cloak
                  x-show="hasKeyword"
                  x-transition.opacity.duration.150ms
                  @click="clearSearch()"
                >
                  Clear
                </button>
              </div>
              <button
                type="button"
                class="od-search-dock-close"
                @click="closeSearch()"
                aria-label="Close search"
                title="Close search"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="od-toolbar-bottomline">
        <div></div>
        <div class="od-page-sort-row">
      <div class="od-page-sort-group">
        <label>
          <span>Sort</span>
          <select name="sortBy" onchange="htmx.trigger(this.form, 'submit');">
            <option value="date" <%= sortBy === "date" ? "selected" : "" %>>Date</option>
            <option value="likes" <%= sortBy === "likes" ? "selected" : "" %>>Likes</option>
            <option value="comments" <%= sortBy === "comments" ? "selected" : "" %>>Comments</option>
          </select>
        </label>
        <label>
          <span>Direction</span>
          <select name="sortDirection" onchange="htmx.trigger(this.form, 'submit');">
            <option value="desc" <%= sortDirection === "desc" ? "selected" : "" %>>Descending</option>
            <option value="asc" <%= sortDirection === "asc" ? "selected" : "" %>>Ascending</option>
          </select>
        </label>
      </div>
        </div>
      </div>
    </div>

    <div id="hot-take-results-loading" class="od-inline-loader htmx-indicator" role="status" aria-live="polite">
      <span class="od-inline-loader-dot" aria-hidden="true"></span>
      Updating hot takes
    </div>
  </form>

  <%- include("partials/hotTakeList", { posts, session, isAdmin, likeActorId, bookmarkedForumPostIds, userModerationById, activeUserBan, canCreateHotTake, hasAnyHotTakes, hasFilters, errorMessage: null }) %>
</section>

<section class="mx-auto grid w-full max-w-5xl gap-8">
  <div class="grid gap-4 border-b border-slate-200 pb-6 dark:border-white/10">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">The Taproom</p>
      <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">
        Hot Takes
      </h1>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
        Short-form draft arguments, instant reactions, and community notes from the OnDraft bar.
      </p>
    </div>
  </div>

  <%- include("partials/hotTakeComposer", { session, errorMessage, values, activeUserBan }) %>

  <form
    id="hot-take-filter-form"
    class="article-filter-form od-card grid gap-4 p-4 sm:p-5"
    hx-get="/hottakes/filter"
    hx-target="#hot-take-list"
    hx-swap="outerHTML"
  >
    <div class="grid gap-3 lg:grid-cols-[minmax(0,1fr)_auto_auto] lg:items-end">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Search</span>
        <input class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-base text-slate-950 placeholder:text-slate-400 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="keyword" type="search" placeholder="Search hot takes" />
      </label>
      <button class="od-primary-link w-full lg:w-auto" type="submit">Search</button>
      <button
        type="button"
        class="od-secondary-link w-full lg:w-auto"
        onclick="this.form.reset(); htmx.trigger(this.form, 'submit');"
      >
        Clear
      </button>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Sort by</span>
        <select class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="sortBy" onchange="htmx.trigger(this.form, 'submit');">
          <option value="date" <%= sortBy === "date" ? "selected" : "" %>>Date</option>
          <option value="likes" <%= sortBy === "likes" ? "selected" : "" %>>Likes</option>
          <option value="comments" <%= sortBy === "comments" ? "selected" : "" %>>Comments</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm font-bold text-slate-800 dark:text-slate-100">
        <span>Direction</span>
        <select class="od-focus-ring min-h-11 rounded-md border border-slate-300 bg-white px-3 text-slate-950 dark:border-white/15 dark:bg-draft-ink dark:text-white" name="sortDirection" onchange="htmx.trigger(this.form, 'submit');">
          <option value="desc" <%= sortDirection === "desc" ? "selected" : "" %>>Descending</option>
          <option value="asc" <%= sortDirection === "asc" ? "selected" : "" %>>Ascending</option>
        </select>
      </label>
    </div>
  </form>

  <%- include("partials/hotTakeList", { posts, session, isAdmin, likeActorId, bookmarkedForumPostIds, userModerationById, activeUserBan, errorMessage: null }) %>
</section>

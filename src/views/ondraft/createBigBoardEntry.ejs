<section class="od-admin-page">
  <div class="od-admin-heading">
    <div>
      <a class="od-admin-back-link" href="/bigboard">Back to big board</a>
      <p>Admin</p>
      <h1>Create Big Board Entry</h1>
    </div>
  </div>

  <% if (errorMessage) { %>
    <p class="od-admin-error" role="alert"><%= errorMessage %></p>
  <% } %>

  <form class="ondraft-form od-admin-form" method="post" action="/bigboard">
    <label>
      Year
      <input type="number" name="year" min="1900" max="2100" value="<%= values.year || "" %>" required />
    </label>
    <label>
      Board
      <select name="creator" required>
        <% creators.forEach((creator) => { %>
          <option value="<%= creator %>" <%= values.creator === creator ? "selected" : "" %>><%= creator %></option>
        <% }) %>
      </select>
    </label>
    <label>
      Player name
      <input name="playerName" value="<%= values.playerName || "" %>" required />
    </label>
    <label>
      Position
      <select name="position" required>
        <% ["QB", "RB", "WR", "TE", "K", "OT", "OG", "C", "DE", "DT", "LB", "CB", "S"].forEach((position) => { %>
          <option value="<%= position %>" <%= values.position === position ? "selected" : "" %>><%= position %></option>
        <% }) %>
      </select>
    </label>
    <label>
      School
      <input name="school" list="college-team-options" value="<%= values.school || "" %>" autocomplete="off" required />
    </label>
    <label>
      Overall rank
      <input type="number" name="rank" min="1" value="<%= values.rank || "" %>" required />
    </label>
    <label>
      Position rank
      <input type="number" name="posRank" min="1" value="<%= values.posRank || "" %>" required />
    </label>
    <label>
      Age
      <input type="number" name="age" min="1" value="<%= values.age || "" %>" required />
    </label>
    <label>
      Height feet
      <input type="number" name="height[feet]" min="0" value="<%= values.height?.feet || "" %>" required />
    </label>
    <label>
      Height inches
      <input type="number" name="height[inches]" min="0" max="11.875" step="0.125" value="<%= values.height?.inches || "" %>" required />
    </label>
    <label>
      Weight
      <input type="number" name="weight" min="1" value="<%= values.weight || "" %>" required />
    </label>
    <label>
      Writeup
      <textarea name="writeup" required><%= values.writeup || "" %></textarea>
    </label>
    <div class="form-actions od-admin-actions">
      <button type="submit">Create entry</button>
    </div>
    <datalist id="college-team-options">
      <% (typeof collegeTeamNames !== "undefined" ? collegeTeamNames : []).forEach((team) => { %>
        <option value="<%= team %>"></option>
      <% }) %>
    </datalist>
  </form>
</section>

<article class="plain-page readable-page od-article-page">
  <div class="article-page-actions">
    <a href="/articles">Back to articles</a>
    <% if (isAdmin) { %>
      <a class="<%= article.published ? "article-edit-link" : "button-link secondary-link" %>" href="/articles/<%= article.id %>/edit">Edit</a>
    <% } %>
  </div>
  <header class="article-header">
    <% if (article.imageUrl) { %>
      <img class="article-cover-thumb" src="<%= article.imageUrl %>" alt="" />
    <% } %>
    <div>
      <p class="article-section-kicker">Articles On Tap</p>
      <h1><%= article.title %></h1>
      <p class="muted-text">
        By <%- include("partials/profileAuthorLink", { name: article.author, showBadge: ["Ryan McWalter", "Aleks Ryabinkin", "Nick Southey"].includes(article.author), className: "font-bold text-draft-amber no-underline transition hover:text-draft-gold dark:text-draft-gold" }) %>
        <% if (article.publicationDate) { %>
          on <%= new Date(article.publicationDate).toLocaleDateString() %>
        <% } %>
      </p>
    </div>
  </header>

  <%- include("partials/articleActions", { article, session, likeActorId, articleBookmarked }) %>

  <% if (article.content.type === "pdf") { %>
    <div class="article-pdf-document" data-pdf-url="<%= article.content.url %>">
      <p class="article-pdf-status muted-text">Loading article...</p>
      <div class="article-pdf-pages"></div>
    </div>
    <script type="module" src="/articlePdf.js"></script>
  <% } else if (article.content.type === "html") { %>
    <div class="article-body article-html-body"><%- article.content.body %></div>
  <% } else { %>
    <div class="article-body"><%= article.content.text %></div>
  <% } %>

  <%- include("partials/articleComments", { article, session, isAdmin, commentsLimit, likeActorId, userDirectoryById, userModerationById, activeUserBan, errorMessage: null }) %>
</article>

<section class="mx-auto grid w-full max-w-6xl gap-8">
  <div class="grid gap-5 border-b border-slate-200 pb-6 dark:border-white/10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">Draft Board</p>
      <h1 class="mt-2 font-display text-4xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">
        Big Board
      </h1>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
        Overall rankings, positional context, measurements, and scouting writeups built for fast board movement.
      </p>
    </div>
  </div>

  <div id="big-board-heading-actions" class="big-board-heading-actions grid gap-3">
    <%- include("partials/bigBoardControls", { board, years, creators, positions, schools, filters }) %>
    <% if (isAdmin && board.creator !== "Consensus") { %>
      <a class="od-primary-link w-fit" href="/bigboard/edit?year=<%= board.year %>&creator=<%= board.creator %>">Edit board</a>
    <% } %>
  </div>

  <%- include("partials/bigBoardResults", { bigBoard }) %>
</section>

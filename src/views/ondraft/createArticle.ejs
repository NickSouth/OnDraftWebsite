<section class="od-admin-page">
  <% const pageHeading = typeof heading !== "undefined" ? heading : "Create Article"; %>
  <% const previewAction = typeof formAction !== "undefined" ? formAction : "/articles/preview"; %>
  <% const draftSaveAction = typeof saveAction !== "undefined" ? saveAction : "/articles"; %>
  <% const selectedPublicationDate = values.publicationDate || new Date().toLocaleDateString("en-CA"); %>
  <div class="od-admin-heading">
    <div>
      <a class="od-admin-back-link" href="/articles">Back to articles</a>
      <p>Admin</p>
      <h1><%= pageHeading %></h1>
    </div>
  </div>

  <% if (errorMessage) { %>
    <p class="od-admin-error" role="alert"><%= errorMessage %></p>
  <% } %>

  <form
    class="ondraft-form od-admin-form"
    method="post"
    action="<%= previewAction %>"
    enctype="multipart/form-data"
    <%= draftSaveAction === "/articles" ? 'data-unsaved-new-article="true"' : "" %>
  >
    <label>
      Title
      <input name="title" value="<%= values.title || "" %>" required />
    </label>
    <div class="od-admin-compact-row od-admin-meta-row">
      <label>
        Author
        <input name="author" value="<%= values.author || session.authenticatedUser?.displayName || "" %>" required />
      </label>
      <label>
        Publication date
        <input type="date" name="publicationDate" value="<%= selectedPublicationDate %>" required />
      </label>
    </div>
    <%
      const selectedArticleTags = (values.tags || "").split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean);
      const articleTagOptions = [...new Set([...(existingTags || []), ...selectedArticleTags])].sort((first, second) => first.localeCompare(second));
    %>
    <div
      class="tag-editor"
      data-tag-editor
    >
      <label for="tag-entry">Tags</label>
      <div class="tag-editor-box">
        <button
          type="button"
          class="tag-editor-toggle"
          data-tag-toggle
          aria-expanded="false"
          aria-controls="article-tag-options"
        >
          <span class="tag-toggle-label">Existing tags</span>
          <span data-tag-count>Any tags</span>
        </button>
        <div class="tag-input-box">
          <input id="tag-entry" data-tag-input autocomplete="off" placeholder="Add a new tag" />
          <button type="button" class="tag-add-button" data-tag-add aria-label="Add tag" title="Add tag">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14" />
              <path d="M5 12h14" />
            </svg>
          </button>
        </div>
        <div class="tag-active-box">
          <div class="tag-chip-list" data-tag-list></div>
        </div>
      </div>
      <input type="hidden" name="tags" value="<%= values.tags || "" %>" data-tag-value />
      <div id="article-tag-options" class="tag-editor-menu" data-tag-menu hidden>
        <% if (articleTagOptions.length > 0) { %>
          <div class="tag-option-list">
            <% articleTagOptions.forEach((tag) => { %>
              <label class="tag-option">
                <input type="checkbox" value="<%= tag %>" data-tag-checkbox <%= selectedArticleTags.includes(tag) ? "checked" : "" %> />
                <span><%= tag %></span>
              </label>
            <% }) %>
          </div>
        <% } else { %>
          <p class="tag-empty">No saved article tags yet.</p>
        <% } %>
      </div>
    </div>
    <label class="od-hook-field">
      Hook
      <textarea name="writeup" required data-hook-input data-hook-max-words="300"><%= values.writeup || "" %></textarea>
      <span class="od-hook-count" data-hook-count aria-live="polite">0/300 words</span>
    </label>
    <% if (values.imageUrl) { %>
      <input type="hidden" name="imageUrl" value="<%= values.imageUrl %>" />
    <% } %>
    <div class="od-admin-compact-row od-admin-asset-row">
      <label>
        Thumbnail
        <input type="file" name="image" accept="image/jpeg,image/png,image/gif,image/webp,.jpg,.jpeg,.png,.gif,.webp" />
      </label>
      <label>
        Content type
        <select
          name="contentType"
          hx-get="/articles/new/content-fields"
          hx-trigger="change"
          hx-target="#article-content-fields"
          hx-swap="innerHTML"
        >
          <option value="plainText" <%= values.contentType === "pdf" || values.contentType === "html" ? "" : "selected" %>>Plain text</option>
          <option value="html" <%= values.contentType === "html" ? "selected" : "" %>>HTML</option>
          <option value="pdf" <%= values.contentType === "pdf" ? "selected" : "" %>>PDF</option>
        </select>
      </label>
    </div>
    <div id="article-content-fields">
      <%- include("partials/articleContentFields", { values }) %>
    </div>
    <% if (values.pdfUrl) { %>
      <input type="hidden" name="pdfUrl" value="<%= values.pdfUrl %>" />
      <input type="hidden" name="pdfOriginalName" value="<%= values.pdfOriginalName || "" %>" />
      <input type="hidden" name="pdfSize" value="<%= values.pdfSize || "" %>" />
    <% } %>
    <div class="form-actions od-admin-actions">
      <button type="submit" formaction="<%= draftSaveAction %>" name="published" value="false">Save As Draft</button>
      <button type="submit">Preview</button>
    </div>
  </form>
  <script src="/articleTags.js" defer></script>
  <script src="/articleHtmlImages.js" defer></script>
  <% if (draftSaveAction === "/articles") { %>
    <script src="/articleEditorGuard.js" defer></script>
  <% } %>
  <script>
    (() => {
      const root = document.currentScript.closest("section");
      const hookInput = root?.querySelector("[data-hook-input]");
      const hookCount = root?.querySelector("[data-hook-count]");

      function wordCount(value) {
        return (value.trim().match(/\S+/g) || []).length;
      }

      function syncHookCount() {
        if (!hookInput || !hookCount) {
          return;
        }
        const maxWords = Number(hookInput.dataset.hookMaxWords || 300);
        const count = wordCount(hookInput.value);
        hookCount.textContent = `${count}/${maxWords} words`;
        hookCount.dataset.state = count > maxWords ? "over" : "ok";
      }

      hookInput?.addEventListener("input", syncHookCount);
      syncHookCount();
    })();
  </script>
</section>

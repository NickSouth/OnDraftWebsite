<section
  class="mx-auto grid w-full max-w-6xl gap-8"
  data-keyword="<%= values.keyword || "" %>"
  x-data="{
    videoSearchOpen: false,
    videoFiltersOpen: false,
    keyword: $el.dataset.keyword || '',
    searchedKeyword: ($el.dataset.keyword || '').trim(),
    filterSignature: [
      '<%= values.tags || "" %>',
      '<%= values.dateFrom || "" %>',
      '<%= values.dateTo || "" %>'
    ].join('|'),
    appliedFilterSignature: [
      '<%= values.tags || "" %>',
      '<%= values.dateFrom || "" %>',
      '<%= values.dateTo || "" %>'
    ].join('|'),
    get hasKeyword() { return this.keyword.trim().length > 0 },
    get searchDirty() { return this.keyword.trim() !== this.searchedKeyword },
    get hasFilterContent() {
      return this.currentFilterSignature().split('|').some((value) => value.trim().length > 0);
    },
    get filtersDirty() { return this.currentFilterSignature() !== this.appliedFilterSignature },
    currentFilterSignature() {
      return [
        this.$refs.videoTags?.value || '',
        this.$refs.videoDateFrom?.value || '',
        this.$refs.videoDateTo?.value || ''
      ].join('|');
    },
    syncFilters() {
      this.filterSignature = this.currentFilterSignature();
    },
    clearSearch() {
      this.keyword = '';
      this.searchedKeyword = '';
      this.$nextTick(() => this.$refs.videoFilterForm.submit());
    },
    clearFilters() {
      this.$refs.videoTags.value = '';
      this.$refs.videoTags.dispatchEvent(new Event('change', { bubbles: true }));
      this.$refs.videoDateFrom.value = '';
      this.$refs.videoDateTo.value = '';
      this.syncFilters();
      this.appliedFilterSignature = this.filterSignature;
      this.$nextTick(() => this.$refs.videoFilterForm.submit());
    },
    clearAllFilters() {
      this.keyword = '';
      this.searchedKeyword = '';
      this.$refs.videoTags.value = '';
      this.$refs.videoTags.dispatchEvent(new Event('change', { bubbles: true }));
      this.$refs.videoDateFrom.value = '';
      this.$refs.videoDateTo.value = '';
      this.syncFilters();
      this.appliedFilterSignature = this.filterSignature;
      this.$nextTick(() => this.$refs.videoFilterForm.submit());
    }
  }"
>
  <div class="grid gap-5 border-b border-slate-200 pb-6 dark:border-white/10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">Bar TV</p>
      <h1 class="mt-2 font-display text-3xl font-black leading-tight text-slate-950 dark:text-white sm:text-5xl">
        Video Library
      </h1>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300 sm:text-base sm:leading-7">
        Our YouTube collection, featuring our breakdowns and discussions on NFL and NFL Draft topics.
      </p>
    </div>
    <% if (isAdmin) { %>
      <a class="od-primary-link" href="/videos/new">Add video</a>
    <% } %>
  </div>

  <form
    class="article-filter-form od-page-tools"
    method="get"
    action="/videos"
    x-ref="videoFilterForm"
    @submit="searchedKeyword = keyword.trim(); syncFilters(); appliedFilterSignature = filterSignature"
  >
    <div id="video-search-panel" class="od-tool-panel" x-show="videoSearchOpen" x-collapse x-cloak>
      <label class="od-search-field">
        <span class="sr-only">Search videos</span>
        <input class="od-search-input" x-ref="videoSearch" x-model="keyword" name="keyword" type="search" placeholder="Search videos" value="<%= values.keyword %>" />
        <button
          type="button"
          class="od-search-icon-button"
          :class="hasKeyword && searchDirty ? 'right-10' : 'right-1'"
          x-cloak
          x-show="hasKeyword"
          @click="clearSearch()"
          aria-label="Clear search"
          title="Clear search"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
        <button
          type="submit"
          class="od-search-icon-button od-search-submit right-1"
          x-cloak
          x-show="hasKeyword && searchDirty"
          aria-label="Search"
          title="Search"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </button>
      </label>
    </div>

    <div id="video-filter-panel" class="od-tool-panel" x-show="videoFiltersOpen" x-collapse x-cloak>
      <%
        const selectedVideoFilterTags = (values.tags || "").split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean);
        const videoFilterTagOptions = [...new Set([...(videoTags || []), ...selectedVideoFilterTags])].sort((first, second) => first.localeCompare(second));
      %>
      <div class="od-video-filter-grid" @input="syncFilters()" @change="syncFilters()">
        <div class="od-filter-field tag-editor" data-tag-editor>
          <span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M20.6 13.5 13.5 20.6a2 2 0 0 1-2.8 0L3 12.9V3h9.9l7.7 7.7a2 2 0 0 1 0 2.8Z" />
              <path d="M7.5 7.5h.01" />
            </svg>
            Tags
          </span>
          <div class="tag-editor-box">
            <div class="tag-chip-list" data-tag-list></div>
            <button
              type="button"
              class="tag-editor-toggle"
              data-tag-toggle
              aria-expanded="false"
              aria-controls="video-filter-tag-options"
            >
              <span class="tag-toggle-label">Select tags</span>
              <span data-tag-count>Any tags</span>
            </button>
          </div>
          <input type="hidden" name="tags" value="<%= values.tags || "" %>" data-tag-value x-ref="videoTags" />
          <div id="video-filter-tag-options" class="tag-editor-menu" data-tag-menu hidden>
            <% if (videoFilterTagOptions.length > 0) { %>
              <div class="tag-option-list">
                <% videoFilterTagOptions.forEach((tag) => { %>
                  <label class="tag-option">
                    <input type="checkbox" value="<%= tag %>" data-tag-checkbox <%= selectedVideoFilterTags.includes(tag) ? "checked" : "" %> />
                    <span><%= tag %></span>
                  </label>
                <% }) %>
              </div>
            <% } else { %>
              <p class="tag-empty">No video tags yet.</p>
            <% } %>
          </div>
        </div>
        <div class="od-video-filter-spacer" aria-hidden="true"></div>
        <label>
          <span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M3 10h18" />
            </svg>
            From
          </span>
          <input type="date" name="dateFrom" value="<%= values.dateFrom || "" %>" x-ref="videoDateFrom" />
        </label>
        <label>
          <span>
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M8 2v4" />
              <path d="M16 2v4" />
              <rect x="3" y="4" width="18" height="18" rx="2" />
              <path d="M3 10h18" />
            </svg>
            To
          </span>
          <input type="date" name="dateTo" value="<%= values.dateTo || "" %>" x-ref="videoDateTo" />
        </label>
      </div>
      <div class="od-filter-panel-actions">
        <button
          type="button"
          class="od-search-icon-button"
          :class="filtersDirty ? 'right-10' : 'right-1'"
          x-cloak
          x-show="hasFilterContent"
          @click="clearFilters()"
          aria-label="Clear filters"
          title="Clear filters"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
        <button
          class="od-search-icon-button od-search-submit right-1"
          type="submit"
          x-cloak
          x-show="filtersDirty"
          aria-label="Apply filters"
          title="Apply filters"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="od-page-tools-bar">
      <div class="od-page-sort-group">
        <label>
          <span>Sort</span>
          <select name="sortBy" onchange="this.form.submit();">
            <option value="date" <%= values.sortBy === "date" ? "selected" : "" %>>Date</option>
            <option value="popularity" <%= values.sortBy === "popularity" ? "selected" : "" %>>Popularity</option>
          </select>
        </label>
        <label>
          <span>Direction</span>
          <select name="sortDirection" onchange="this.form.submit();">
            <option value="desc" <%= values.sortDirection === "desc" ? "selected" : "" %>>Descending</option>
            <option value="asc" <%= values.sortDirection === "asc" ? "selected" : "" %>>Ascending</option>
          </select>
        </label>
      </div>
      <div class="od-page-tool-actions">
        <button
          type="button"
          class="od-icon-button"
          :class="videoFiltersOpen ? 'is-active' : ''"
          :aria-expanded="String(videoFiltersOpen)"
          aria-controls="video-filter-panel"
          aria-label="Filters"
          title="Filters"
          @click="videoFiltersOpen = !videoFiltersOpen"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16" />
            <path d="M7 12h10" />
            <path d="M10 17h4" />
          </svg>
        </button>
        <button
          type="button"
          class="od-icon-button"
          :class="videoSearchOpen ? 'is-active' : ''"
          :aria-expanded="String(videoSearchOpen)"
          aria-controls="video-search-panel"
          aria-label="Search videos"
          title="Search videos"
          @click="videoSearchOpen = !videoSearchOpen; $nextTick(() => videoSearchOpen && $refs.videoSearch?.focus())"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>
      </div>
    </div>
  </form>

  <% if (videos.length === 0) { %>
    <% const anyVideosExist = typeof hasAnyVideos !== "undefined" ? hasAnyVideos : videos.length > 0; %>
    <% const currentHasFilters = typeof hasFilters !== "undefined" ? hasFilters : false; %>
    <div class="od-empty-state">
      <div>
        <% if (!anyVideosExist) { %>
          <p class="od-empty-state-kicker">No videos yet</p>
          <p class="od-empty-state-title">No videos have been added yet.</p>
          <p class="od-empty-state-copy">Add the first Bar TV entry when a video is ready.</p>
          <% if (isAdmin) { %>
            <div class="od-empty-state-actions">
              <a class="od-primary-link" href="/videos/new">Add video</a>
            </div>
          <% } %>
        <% } else { %>
          <p class="od-empty-state-kicker">No signal</p>
          <p class="od-empty-state-title">No videos match those filters.</p>
          <p class="od-empty-state-copy">Try a wider search or clear the filters.</p>
          <% if (currentHasFilters) { %>
            <div class="od-empty-state-actions">
              <button type="button" class="od-secondary-link" @click="clearAllFilters()">Clear filters</button>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="video-grid grid gap-5">
      <% videos.forEach((video) => { %>
        <% const thumbnailUrl = video.thumbnailUrl || `https://img.youtube.com/vi/${video.videoId}/hqdefault.jpg`; %>
        <article class="video-card od-card grid overflow-hidden transition hover:-translate-y-0.5 hover:border-draft-gold hover:shadow-editorial lg:grid-cols-[24rem_minmax(0,1fr)]">
          <a class="group block overflow-hidden bg-draft-ink" href="<%= video.youtubeUrl %>" target="_blank" rel="noopener noreferrer">
            <img class="video-thumb h-full min-h-40 sm:min-h-56" src="<%= thumbnailUrl %>" alt="" loading="lazy" decoding="async" />
          </a>
          <div class="video-card-copy grid content-between gap-4 p-4 sm:gap-5 sm:p-6">
            <div class="grid gap-2">
              <p class="m-0 text-xs font-black uppercase tracking-[0.16em] text-draft-amber dark:text-draft-gold">Bar TV</p>
              <h2 class="m-0 font-display text-2xl font-black leading-tight text-slate-950 dark:text-white sm:text-3xl"><%= video.title %></h2>
              <p class="m-0 hidden text-base leading-7 text-slate-700 dark:text-slate-200 sm:block"><%= video.description %></p>
              <details class="video-description-toggle">
                <summary>
                  <span>Description</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="m-0 text-sm leading-6 text-slate-700 dark:text-slate-200"><%= video.description %></p>
              </details>
            </div>
            <div class="flex flex-wrap gap-2">
              <% video.tags.forEach((tag) => { %>
                <span class="rounded bg-draft-foam px-2.5 py-1 text-xs font-black text-draft-amber dark:bg-white/10 dark:text-draft-gold"><%= tag.toLowerCase() %></span>
              <% }) %>
            </div>
            <div class="video-card-footer mt-auto flex flex-col gap-3 border-t border-slate-200 pt-4 dark:border-white/10 sm:flex-row sm:items-center sm:justify-between">
              <% if (typeof video.viewCount === "number") { %>
                <span class="text-sm font-bold text-slate-600 dark:text-slate-300"><%= video.viewCount.toLocaleString() %> views</span>
              <% } else { %>
                <span class="text-sm font-bold text-slate-600 dark:text-slate-300">Views unavailable</span>
              <% } %>
              <div class="flex flex-wrap items-center gap-2">
                <% if (isAdmin) { %>
                  <a class="od-secondary-link" href="/videos/<%= video.videoId %>/edit">Edit</a>
                  <form method="post" action="/videos/<%= video.videoId %>/delete" onsubmit="return confirm('Delete this video?');">
                    <button class="od-danger-button" type="submit">Delete</button>
                  </form>
                <% } %>
                <a class="od-secondary-link" href="<%= video.youtubeUrl %>" target="_blank" rel="noopener noreferrer">Watch</a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
  <script src="/articleTags.js" defer></script>
</section>

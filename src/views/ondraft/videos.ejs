<section
  class="mx-auto grid w-full max-w-6xl gap-5 sm:gap-8"
  data-keyword="<%= values.keyword || "" %>"
  x-data="{
    videoSearchOpen: false,
    videoFiltersOpen: false,
    keyword: $el.dataset.keyword || '',
    searchedKeyword: ($el.dataset.keyword || '').trim(),
    filterSignature: '<%= [values.tags || "", values.dateFrom || "", values.dateTo || ""].join("|") %>',
    searchTimer: null,
    filterTimer: null,
    get hasKeyword() { return this.keyword.trim().length > 0 },
    openSearch() {
      this.videoSearchOpen = true;
      this.$nextTick(() => this.$refs.videoSearch?.focus());
    },
    closeSearch() {
      this.videoSearchOpen = false;
      this.$nextTick(() => this.$refs.videoSearchTrigger?.focus());
    },
    toggleFilters() {
      this.videoFiltersOpen = !this.videoFiltersOpen;
    },
    requestSubmit() {
      this.$refs.videoFilterForm.requestSubmit();
    },
    queueSearchSubmit() {
      window.clearTimeout(this.searchTimer);
      this.searchTimer = window.setTimeout(() => {
        if (this.keyword.trim() === this.searchedKeyword) return;
        this.submitSearch();
      }, 240);
    },
    submitSearch() {
      this.searchedKeyword = this.keyword.trim();
      this.requestSubmit();
    },
    queueFilterSubmit() {
      this.filterSignature = this.currentFilterSignature();
      window.clearTimeout(this.filterTimer);
      this.filterTimer = window.setTimeout(() => {
        this.requestSubmit();
      }, 240);
    },
    get hasFilterContent() {
      return this.filterSignature.split('|').some((value) => value.trim().length > 0);
    },
    currentFilterSignature() {
      return [
        this.$refs.videoTags?.value || '',
        this.$refs.videoDateFrom?.value || '',
        this.$refs.videoDateTo?.value || ''
      ].join('|');
    },
    clearSearch() {
      this.keyword = '';
      this.submitSearch();
      this.$nextTick(() => this.$refs.videoSearch?.focus());
    },
    clearFilters() {
      this.$refs.videoTags.value = '';
      this.$refs.videoTags.dispatchEvent(new Event('change', { bubbles: true }));
      this.$refs.videoDateFrom.value = '';
      this.$refs.videoDateTo.value = '';
      this.filterSignature = '';
      this.$nextTick(() => this.requestSubmit());
    },
    clearAllFilters() {
      this.keyword = '';
      this.searchedKeyword = '';
      this.$refs.videoTags.value = '';
      this.$refs.videoTags.dispatchEvent(new Event('change', { bubbles: true }));
      this.$refs.videoDateFrom.value = '';
      this.$refs.videoDateTo.value = '';
      this.filterSignature = '';
      this.$nextTick(() => this.submitSearch());
    }
  }"
  @keydown.escape.window="if (videoFiltersOpen) { videoFiltersOpen = false } else if (videoSearchOpen) { closeSearch() }"
>
  <div class="grid gap-4 border-b border-slate-200 pb-4 dark:border-white/10 sm:gap-5 sm:pb-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[0.2em] text-draft-amber dark:text-draft-gold">Bar TV</p>
      <h1 class="mt-1.5 font-display text-3xl font-black leading-tight text-slate-950 dark:text-white sm:mt-2 sm:text-5xl">
        Video Library
      </h1>
      <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300 sm:mt-3 sm:text-base sm:leading-7">
        Our YouTube collection, featuring our breakdowns and discussions on NFL and NFL Draft topics.
      </p>
    </div>
    <% if (isAdmin) { %>
      <a class="od-primary-link" href="/videos/new">Add video</a>
    <% } %>
  </div>

  <form
    class="article-filter-form od-page-tools od-list-controls"
    method="get"
    action="/videos"
    x-ref="videoFilterForm"
    @submit="searchedKeyword = keyword.trim()"
  >
    <div class="od-toolbar-stack">
      <div class="od-toolbar-topline">
        <div></div>
        <div class="od-toolbar-actions">
          <div class="od-search-dock" :class="videoSearchOpen ? 'is-open' : ''">
            <button
              type="button"
              class="od-search-dock-trigger"
              x-ref="videoSearchTrigger"
              x-show="!videoSearchOpen"
              x-transition.opacity.duration.150ms
              :aria-expanded="String(videoSearchOpen)"
              aria-controls="video-search-panel"
              aria-label="Search videos"
              title="Search videos"
              @click="openSearch()"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </button>
            <div
              id="video-search-panel"
              class="od-search-dock-field"
              x-cloak
              x-show="videoSearchOpen"
              x-transition.opacity.duration.180ms
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <label class="sr-only" for="video-search-input">Search videos</label>
              <input
                id="video-search-input"
                class="od-search-dock-input"
                x-ref="videoSearch"
                x-model="keyword"
                name="keyword"
                type="search"
                placeholder="Search videos"
                value="<%= values.keyword %>"
                @input="queueSearchSubmit()"
                @keydown.enter.prevent="submitSearch()"
              />
              <div class="od-search-dock-actions">
                <button
                  type="button"
                  class="od-search-dock-action"
                  x-cloak
                  x-show="hasKeyword"
                  x-transition.opacity.duration.150ms
                  @click="clearSearch()"
                >
                  Clear
                </button>
              </div>
              <button
                type="button"
                class="od-search-dock-close"
                @click="closeSearch()"
                aria-label="Close search"
                title="Close search"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg>
              </button>
            </div>
          </div>

          <div class="od-filter-popover-shell">
            <button
              type="button"
              class="od-icon-button"
              :class="videoFiltersOpen || hasFilterContent ? 'is-active' : ''"
              :aria-expanded="String(videoFiltersOpen)"
              aria-controls="video-filter-panel"
              :aria-label="videoFiltersOpen ? 'Close filters' : 'Filters'"
              :title="videoFiltersOpen ? 'Close filters' : 'Filters'"
              @click="toggleFilters()"
            >
              <template x-if="!videoFiltersOpen">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M4 7h16" />
                  <path d="M7 12h10" />
                  <path d="M10 17h4" />
                </svg>
              </template>
              <template x-if="videoFiltersOpen">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M18 6 6 18" />
                  <path d="m6 6 12 12" />
                </svg>
              </template>
            </button>

            <div
              id="video-filter-panel"
              class="od-filter-popover"
              x-cloak
              x-show="videoFiltersOpen"
              x-transition:enter="transition ease-out duration-180"
              x-transition:enter-start="opacity-0 -translate-y-2 scale-[0.98]"
              x-transition:enter-end="opacity-100 translate-y-0 scale-100"
              x-transition:leave="transition ease-in duration-140"
              x-transition:leave-start="opacity-100 translate-y-0 scale-100"
              x-transition:leave-end="opacity-0 -translate-y-1 scale-[0.98]"
            >
          <%
            const selectedVideoFilterTags = (values.tags || "").split(",").map((tag) => tag.trim().toLowerCase()).filter(Boolean);
            const videoFilterTagOptions = [...new Set([...(videoTags || []), ...selectedVideoFilterTags])].sort((first, second) => first.localeCompare(second));
          %>
              <div class="od-video-filter-grid od-filter-popover-grid" @input="queueFilterSubmit()" @change="queueFilterSubmit()">
            <div class="od-filter-field tag-editor" data-tag-editor>
              <span>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M20.6 13.5 13.5 20.6a2 2 0 0 1-2.8 0L3 12.9V3h9.9l7.7 7.7a2 2 0 0 1 0 2.8Z" />
                  <path d="M7.5 7.5h.01" />
                </svg>
                Tags
              </span>
              <div class="tag-editor-box">
                <div class="tag-chip-list" data-tag-list></div>
                <button
                  type="button"
                  class="tag-editor-toggle"
                  data-tag-toggle
                  aria-expanded="false"
                  aria-controls="video-filter-tag-options"
                >
                  <span class="tag-toggle-label">Select tags</span>
                  <span data-tag-count>Any tags</span>
                </button>
              </div>
              <input type="hidden" name="tags" value="<%= values.tags || "" %>" data-tag-value x-ref="videoTags" />
              <div id="video-filter-tag-options" class="tag-editor-menu" data-tag-menu hidden>
                <% if (videoFilterTagOptions.length > 0) { %>
                  <div class="tag-option-list">
                    <% videoFilterTagOptions.forEach((tag) => { %>
                      <label class="tag-option">
                        <input type="checkbox" value="<%= tag %>" data-tag-checkbox <%= selectedVideoFilterTags.includes(tag) ? "checked" : "" %> />
                        <span><%= tag %></span>
                      </label>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="tag-empty">No video tags yet.</p>
                <% } %>
              </div>
            </div>
            <div class="od-video-filter-spacer" aria-hidden="true"></div>
            <label>
              <span>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M8 2v4" />
                  <path d="M16 2v4" />
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M3 10h18" />
                </svg>
                From
              </span>
              <input type="date" name="dateFrom" value="<%= values.dateFrom || "" %>" x-ref="videoDateFrom" />
            </label>
            <label>
              <span>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M8 2v4" />
                  <path d="M16 2v4" />
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M3 10h18" />
                </svg>
                To
              </span>
              <input type="date" name="dateTo" value="<%= values.dateTo || "" %>" x-ref="videoDateTo" />
            </label>
          </div>
              <div class="od-tool-panel-actions">
                <button
                  type="button"
                  class="od-search-dock-action"
                  x-cloak
                  x-show="hasFilterContent"
                  x-transition.opacity.duration.150ms
                  @click="clearFilters()"
                >
                  Clear
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="od-toolbar-bottomline">
        <div class="od-toolbar-bottomline-main">
          <div class="od-toolbar-sortline">
            <div class="od-page-sort-group">
              <label>
                <span>Sort</span>
                <select name="sortBy" onchange="this.form.submit();">
                  <option value="date" <%= values.sortBy === "date" ? "selected" : "" %>>Date</option>
                  <option value="popularity" <%= values.sortBy === "popularity" ? "selected" : "" %>>Popularity</option>
                </select>
              </label>
              <label>
                <span>Direction</span>
                <select name="sortDirection" onchange="this.form.submit();">
                  <option value="desc" <%= values.sortDirection === "desc" ? "selected" : "" %>>Descending</option>
                  <option value="asc" <%= values.sortDirection === "asc" ? "selected" : "" %>>Ascending</option>
                </select>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>
  </form>

  <% if (videos.length === 0) { %>
    <% const anyVideosExist = typeof hasAnyVideos !== "undefined" ? hasAnyVideos : videos.length > 0; %>
    <% const currentHasFilters = typeof hasFilters !== "undefined" ? hasFilters : false; %>
    <div class="od-empty-state">
      <div>
        <% if (!anyVideosExist) { %>
          <p class="od-empty-state-kicker">No videos yet</p>
          <p class="od-empty-state-title">No videos have been added yet.</p>
          <p class="od-empty-state-copy">Add the first Bar TV entry when a video is ready.</p>
          <% if (isAdmin) { %>
            <div class="od-empty-state-actions">
              <a class="od-primary-link" href="/videos/new">Add video</a>
            </div>
          <% } %>
        <% } else { %>
          <p class="od-empty-state-kicker">No signal</p>
          <p class="od-empty-state-title">No videos match those filters.</p>
          <p class="od-empty-state-copy">Try a wider search or clear the filters.</p>
          <% if (currentHasFilters) { %>
            <div class="od-empty-state-actions">
              <button type="button" class="od-secondary-link" @click="clearAllFilters()">Clear filters</button>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="video-grid od-swap-surface od-swap-active od-stagger-list grid gap-3 sm:gap-5">
      <% videos.forEach((video) => { %>
        <% const fallbackThumbnailUrl = `https://img.youtube.com/vi/${video.videoId}/hqdefault.jpg`; %>
        <% const thumbnailUrl = video.thumbnailUrl || fallbackThumbnailUrl; %>
        <% const thumbnailNeedsFallback = Boolean(video.thumbnailUrl && video.thumbnailUrl !== fallbackThumbnailUrl); %>
        <article class="video-card od-card grid overflow-hidden transition hover:-translate-y-0.5 hover:border-draft-gold hover:shadow-editorial lg:grid-cols-[24rem_minmax(0,1fr)]">
          <a class="group block overflow-hidden bg-draft-ink" href="<%= video.youtubeUrl %>" target="_blank" rel="noopener noreferrer">
            <img
              class="video-thumb h-full min-h-36 sm:min-h-56"
              src="<%= thumbnailUrl %>"
              alt=""
              loading="lazy"
              decoding="async"
              <% if (thumbnailNeedsFallback) { %>
                data-fallback-src="<%= fallbackThumbnailUrl %>"
                onerror="if (this.dataset.fallbackApplied === 'true') return; this.dataset.fallbackApplied = 'true'; this.src = this.dataset.fallbackSrc;"
              <% } %>
            />
          </a>
          <div class="video-card-copy grid content-between gap-3 p-3.5 sm:gap-5 sm:p-6">
            <div class="video-card-meta grid gap-2">
              <p class="m-0 text-[0.68rem] font-black uppercase tracking-[0.1em] text-draft-amber dark:text-draft-gold sm:text-xs sm:tracking-[0.16em]">Bar TV</p>
              <h2 class="m-0 font-display text-xl font-black leading-tight text-slate-950 dark:text-white sm:text-3xl"><%= video.title %></h2>
              <p class="m-0 hidden text-base leading-7 text-slate-700 dark:text-slate-200 sm:block"><%= video.description %></p>
              <details class="video-description-toggle">
                <summary>
                  <span>Description</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <p class="m-0 text-sm leading-6 text-slate-700 dark:text-slate-200"><%= video.description %></p>
              </details>
            </div>
            <div class="video-card-tags flex flex-wrap gap-1.5 sm:gap-2">
              <% video.tags.forEach((tag) => { %>
                <span class="rounded bg-draft-foam px-2 py-0.5 text-[0.68rem] font-black text-draft-amber dark:bg-white/10 dark:text-draft-gold sm:px-2.5 sm:py-1 sm:text-xs"><%= tag.toLowerCase() %></span>
              <% }) %>
            </div>
            <div class="video-card-footer mt-auto flex flex-row items-center justify-between gap-2 border-t border-slate-200 pt-3 dark:border-white/10 sm:gap-3 sm:pt-4">
              <% if (typeof video.viewCount === "number") { %>
                <span class="text-xs font-bold text-slate-600 dark:text-slate-300 sm:text-sm"><%= video.viewCount.toLocaleString() %> views</span>
              <% } else { %>
                <span class="text-xs font-bold text-slate-600 dark:text-slate-300 sm:text-sm">Views unavailable</span>
              <% } %>
              <div class="flex shrink-0 flex-nowrap items-center gap-1.5 sm:gap-2">
                <% if (isAdmin) { %>
                  <a class="od-secondary-link" href="/videos/<%= video.videoId %>/edit">Edit</a>
                  <form method="post" action="/videos/<%= video.videoId %>/delete" onsubmit="return confirm('Delete this video?');">
                    <button class="od-danger-button" type="submit">Delete</button>
                  </form>
                <% } %>
                <a class="od-secondary-link" href="<%= video.youtubeUrl %>" target="_blank" rel="noopener noreferrer">Watch</a>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
  <script src="/articleTags.js" defer></script>
</section>
